// A practice figure's anatomical surface: a continuous CC0 MakeHuman mesh
// skinned onto 46 bones and dressed in cloth shells, read from a
// character's shared/figure/*/anatomy.bin (PFIG0002, described in that
// folder's README). It holds no pose or player state.
//
// Bone roles: 0 pelvis, 1 spine, 2 chest, 3 head, 4 upper arm, 5 forearm,
// 6 hand, 7 finger segment, 8 thigh, 9 shin, 10 foot. Side 0 is the
// figure's left.
#import "kryon/scene"
#import "kryon/scene_skin"
#import "std/binary"
#import "std/math"
#import "std/vec"

// Vertex regions, each with its own texture map and material.
FIGURE_SKIN :: 0
FIGURE_TOP :: 1
FIGURE_TROUSERS :: 2
FIGURE_HAIR :: 3
FIGURE_TRIM :: 4
FIGURE_REGIONS :: 5

FigureBone :: struct {
    role: s32
    side: s32
    finger: s32
    segment: s32
    parent: s32
    origin: Vector3
    tip: Vector3
}

FigureAnatomy :: struct {
    height: float64
    bones: Vec(FigureBone)
    positions: Vec(Vector3)
    normals: Vec(Vector3)
    // Texture coordinates that wrap the trunk, head and each limb, in
    // repeats of the region's tileable texture.
    uvs: Vec(ShapePoint)
    // Where the face painting lies on the face, and how much of it shows
    // (0 away from the face).
    details: Vec(ShapePoint)
    faces: Vec(float64)
    indices: Vec(s32)
    influences: Vec(SkinInfluence)
    regions: Vec(s32)
}

FigureAnatomyRelease :: (anatomy: *FigureAnatomy) {
    if anatomy == null {
        return
    }
    VecFree(anatomy.bones)
    VecFree(anatomy.positions)
    VecFree(anatomy.normals)
    VecFree(anatomy.uvs)
    VecFree(anatomy.details)
    VecFree(anatomy.faces)
    VecFree(anatomy.indices)
    VecFree(anatomy.influences)
    VecFree(anatomy.regions)
    anatomy.height = 0.0
}

FigureAnatomyRead :: (anatomy: *FigureAnatomy, bytes: string) -> bool {
    if anatomy == null || anatomy.positions.count != 0 || bytes.count < 24 ||
    bytes[0:8] != "PFIG0002" {
        return false
    }
    count := cast(s32)ReadU32LE(bytes, 8)
    index_count := cast(s32)ReadU32LE(bytes, 12)
    bone_count := cast(s32)ReadU32LE(bytes, 16)
    height := cast(float64)ReadF32LE(bytes, 20)
    if count < 3 || count > 65535 || index_count < 3 || index_count > 393210 ||
    index_count % 3 != 0 || bone_count < 1 || bone_count > 255 ||
    !Finite64(height) || height < 0.5 || height > 3.0 ||
    bytes.count != 24 + cast(s64)bone_count * 32 + cast(s64)count * 48 + cast(s64)index_count * 2 {
        return false
    }
    loaded: FigureAnatomy
    loaded.height = height
    if !VecResize(loaded.bones, cast(s64)bone_count) ||
    !VecResize(loaded.positions, cast(s64)count) || !VecResize(loaded.normals, cast(s64)count) ||
    !VecResize(loaded.uvs, cast(s64)count) || !VecResize(loaded.details, cast(s64)count) ||
    !VecResize(loaded.faces, cast(s64)count) || !VecResize(loaded.influences, cast(s64)count) ||
    !VecResize(loaded.regions, cast(s64)count) || !VecResize(loaded.indices, cast(s64)index_count) {
        FigureAnatomyRelease(*loaded)
        return false
    }
    valid := true
    at: s32 = 24
    for index: 0..bone_count - 1 {
        bone: FigureBone
        bone.role = cast(s32)bytes[at]
        bone.side = cast(s32)bytes[at + 1]
        bone.finger = cast(s32)bytes[at + 2]
        bone.segment = cast(s32)bytes[at + 3]
        bone.parent = ReadS32LE(bytes, at + 4)
        bone.origin = FigureAnatomyVector(bytes, at + 8)
        bone.tip = FigureAnatomyVector(bytes, at + 20)
        dx := bone.tip.x - bone.origin.x
        dy := bone.tip.y - bone.origin.y
        dz := bone.tip.z - bone.origin.z
        valid = valid && bone.role <= 10 && bone.side <= 1 && bone.finger <= 5 &&
        bone.segment <= 2 && bone.parent >= -1 && bone.parent < index &&
        SkinFinite(bone.origin) && SkinFinite(bone.tip) && dx * dx + dy * dy + dz * dz > 0.00000001
        if bone.role == 7 {
            valid = valid && bone.finger >= 1 && bone.parent >= 0
            if bone.parent >= 0 && bone.parent < index {
                parent := loaded.bones[bone.parent]
                valid = valid && parent.side == bone.side &&
                ((bone.segment == 0 && parent.role == 6) ||
                    (bone.segment > 0 && parent.role == 7 && parent.finger == bone.finger &&
                    parent.segment + 1 == bone.segment))
            }
        } else {
            valid = valid && bone.finger == 0 && bone.segment == 0
        }
        loaded.bones[index] = bone
        at += 32
    }
    for index: 0..count - 1 {
        loaded.positions[index] = FigureAnatomyVector(bytes, at)
        normal: Vector3 = .{cast(float64)cast(s16)ReadU16LE(bytes, at + 12) / 32767.0,
            cast(float64)cast(s16)ReadU16LE(bytes, at + 14) / 32767.0,
            cast(float64)cast(s16)ReadU16LE(bytes, at + 16) / 32767.0}
        loaded.normals[index] = normal
        uv: ShapePoint = .{cast(float64)ReadF32LE(bytes, at + 18), cast(float64)ReadF32LE(bytes, at + 22)}
        loaded.uvs[index] = uv
        detail: ShapePoint = .{cast(float64)ReadF32LE(bytes, at + 26), cast(float64)ReadF32LE(bytes, at + 30)}
        loaded.details[index] = detail
        influence: SkinInfluence
        total: u32
        for part: 0..3 {
            influence.joints[part] = cast(s32)bytes[at + 34 + part]
            weight := ReadU16LE(bytes, at + 38 + cast(s32)part * 2)
            influence.weights[part] = cast(float64)weight / 65535.0
            total += weight
            valid = valid && influence.joints[part] < bone_count
        }
        loaded.influences[index] = influence
        loaded.regions[index] = cast(s32)bytes[at + 46]
        loaded.faces[index] = cast(float64)bytes[at + 47] / 255.0
        length := normal.x * normal.x + normal.y * normal.y + normal.z * normal.z
        valid = valid && SkinFinite(loaded.positions[index]) && SkinFinite(normal) &&
        Finite64(uv.x) && Finite64(uv.y) && Finite64(detail.x) && Finite64(detail.y) &&
        length > 0.9 && length < 1.1 && total == 65535 && loaded.regions[index] < FIGURE_REGIONS
        at += 48
    }
    for index: 0..index_count - 1 {
        loaded.indices[index] = cast(s32)ReadU16LE(bytes, at)
        valid = valid && loaded.indices[index] < count
        at += 2
    }
    if !valid {
        FigureAnatomyRelease(*loaded)
        return false
    }
    anatomy.height = loaded.height
    VecSwap(anatomy.bones, loaded.bones)
    VecSwap(anatomy.positions, loaded.positions)
    VecSwap(anatomy.normals, loaded.normals)
    VecSwap(anatomy.uvs, loaded.uvs)
    VecSwap(anatomy.details, loaded.details)
    VecSwap(anatomy.faces, loaded.faces)
    VecSwap(anatomy.indices, loaded.indices)
    VecSwap(anatomy.influences, loaded.influences)
    VecSwap(anatomy.regions, loaded.regions)
    return true
}

#scope_file
FigureAnatomyVector :: (bytes: string, at: s32) -> Vector3 {
    return .{cast(float64)ReadF32LE(bytes, at), cast(float64)ReadF32LE(bytes, at + 4),
        cast(float64)ReadF32LE(bytes, at + 8)}
}
