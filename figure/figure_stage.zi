// Retained render-thread scene for presenting a practice figure.
#import "figure_math"
#import "figure_joints"
#import "figure_model"
#import "kryon/scene"
#import "kryon/scene_gltf"
#import "kryon/scene_render"
#import "kryon/drawing_props"
#import "std/math"
#import "std/vec"
Raster :: #import "std/image";
#if OS == .LINUX || OS == .ANDROID || OS == .WEB {
    GPU :: #import "kryon/scene_gpu";
}

FigureStage :: struct {
    scene: Scene
    model: FigureModel
    pixels: Raster.Image
    #if OS == .LINUX || OS == .ANDROID || OS == .WEB {
        gpu: GPU.SceneGpuContext
    }
}

FigureCamera :: (center: Vector3, yaw: float64, pitch: float64,
    span: float64, aspect: float64) -> SceneCamera {
    half_height := span / 2.0
    half_width := half_height * aspect
    toward := FigureV3(Sin(yaw) * Cos(pitch), Sin(pitch), Cos(yaw) * Cos(pitch))
    camera := OrthographicCamera(-half_width, half_width, half_height, -half_height, 0.05, 30.0)
    camera.target = center
    camera.position = FigureAddScaled(center, toward, 8.0)
    camera.up = .{0.0, 1.0, 0.0}
    return camera
}

// Transform the camera inversely so the posed character moves as one body.
FigureCameraPlaced :: (camera: SceneCamera, offset: Vector3, pivot: Vector3, roll: float64) -> SceneCamera {
    result := camera
    inverse := FigureAxisAngle(.{0.0, 0.0, 1.0}, -roll)
    result.target = FigureAdd(pivot, FigureRotate(inverse, FigureSub(FigureSub(camera.target, offset), pivot)))
    result.position = FigureAdd(pivot, FigureRotate(inverse, FigureSub(FigureSub(camera.position, offset), pivot)))
    result.up = FigureRotate(inverse, camera.up)
    return result
}

FigureStageInit :: (stage: *FigureStage) {
    SceneInit(*stage.scene)
    stage.scene.background = .{0, 0, 0, 0}
    AddHemisphereLight(*stage.scene, .{255, 249, 236, 255}, .{109, 115, 99, 255}, 0.7)
    unused AddDirectionalLight(*stage.scene, .{255, 248, 235, 255}, 0.6, .{-3.0, 6.0, 4.0})
}

FigureStageFree :: (stage: *FigureStage) {
    #if OS == .LINUX || OS == .ANDROID || OS == .WEB {
        GPU.SceneGpuRelease(*stage.gpu)
    }
    FigureModelRelease(*stage.model)
    SceneFree(*stage.scene)
    VecFree(stage.pixels.pixels)
    stage.pixels.width = 0
    stage.pixels.height = 0
}

FigureStageRender :: (stage: *FigureStage, joints: *FigureJoints,
    camera: SceneCamera, width: s32, height: s32, seconds: float64) -> bool {
    #if OS == .LINUX || OS == .ANDROID || OS == .WEB {
        unused FigureModelGpuSkinning(*stage.model, *stage.scene, GPU.SceneGpuSkinningAvailable(*stage.gpu))
    }
    if !FigureModelPose(*stage.model, *stage.scene, joints, seconds, true) {
        return false
    }
    toward := FigureNormalize(FigureSub(camera.position, camera.target))
    yaw := Atan2(toward.x, toward.z)
    light := FigureRotate(FigureAxisAngle(.{0.0, 1.0, 0.0}, yaw), .{-0.45, 0.75, 0.55})
    FigureModelLight(*stage.model, light, toward)
    if stage.pixels.width != width || stage.pixels.height != height {
        if !VecResize(stage.pixels.pixels, cast(s64)width * height * 4) {
            return false
        }
        stage.pixels.width = width
        stage.pixels.height = height
    }
    #if OS == .LINUX || OS == .ANDROID || OS == .WEB {
        result := GPU.SceneGpuRender(*stage.gpu, *stage.scene, camera, *stage.pixels)
        if result.ok {
            return true
        }
        // The CPU renderer needs posed vertices, never a GPU skin's bind pose.
        if stage.model.gpu_skinning {
            unused FigureModelGpuSkinning(*stage.model, *stage.scene, false)
            if !FigureModelPose(*stage.model, *stage.scene, joints, seconds, true) {
                return false
            }
        }
    }
    return RenderScene(*stage.scene, camera, *stage.pixels)
}

FigureStageLoadBytes :: (stage: *FigureStage, bytes: []u8) -> bool {
    FigureStageInit(stage)
    if !FigureModelLoadBytes(*stage.model, *stage.scene, bytes) || !FigureModelToon(*stage.model, *stage.scene) {
        return false
    }
    // This stage uses the host's contact shadow, without a scene shadow map.
    // Hidden wardrobe meshes therefore need neither posing nor shadow skins.
    for index: 0..stage.model.instance.meshes.count - 1 {
        inst := *stage.model.instance.meshes[index]
        unused SetShadows(*stage.scene, inst.scene_node, false, false)
    }
    return true
}

FigureStagePaint :: (stage: *FigureStage, joints: *FigureJoints, center: Vector3,
    yaw: float64, pitch: float64, span: float64, width: s32, height: s32, seconds: float64,
    offset: Vector3, pivot: Vector3, roll: float64) -> bool {
    camera := FigureCamera(center, yaw, pitch, span, cast(float64)width / cast(float64)height)
    placed := FigureCameraPlaced(camera, offset, pivot, roll)
    return FigureStageRender(stage, joints, placed, width, height, seconds)
}
