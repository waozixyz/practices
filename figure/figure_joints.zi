// The solver-neutral pose every practice reports: where each joint is and
// how the trunk, head, hands and feet are turned, keyed by joint. Each
// practice solver keeps balance, foot contact and timing; a figure model
// turns these joints into its own bones' motions (FigureBonePose).
#import "figure_math"
#import "kryon/scene"

FigureJoints :: struct {
    // The standing height the joints were solved for.
    height: float64
    pelvis: Vector3
    spine: Vector3
    chest: Vector3
    neck: Vector3
    pelvis_turn: FigureQuat
    chest_turn: FigureQuat
    head_turn: FigureQuat
    shoulders: [2]Vector3
    elbows: [2]Vector3
    wrists: [2]Vector3
    // Palm frames: the fingers point along local -Y and the palm faces +Z.
    hands: [2]FigureQuat
    // 0 open to 1 closed, and 0 to 1 the finger tips curled into a hook.
    fist: [2]float64
    hook: [2]float64
    hips: [2]Vector3
    knees: [2]Vector3
    ankles: [2]Vector3
    toes: [2]Vector3
    // Actual solver heel/ball contacts, including lift and pivots.
    heels: [2]Vector3
    balls: [2]Vector3
    feet: [2]FigureQuat
}

// One bone's motion. A bind point p goes to origin + turn * stretch(p -
// rest_origin), where stretch scales by WIDTH across the bone and by LENGTH
// along its rest direction AXIS.
FigureBonePose :: struct {
    rest_origin: Vector3
    origin: Vector3
    axis: Vector3
    turn: FigureQuat
    width: float64
    length: float64
}

FigureBonePoint :: (pose: FigureBonePose, point: Vector3) -> Vector3 {
    local := FigureSub(point, pose.rest_origin)
    along := FigureDot(local, pose.axis)
    stretched := FigureAddScaled(FigureScale(local, pose.width), pose.axis, along * (pose.length - pose.width))
    return FigureAdd(pose.origin, FigureRotate(pose.turn, stretched))
}
