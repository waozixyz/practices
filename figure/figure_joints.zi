// How a practice's solved joints move the figure's bones. Each practice
// solver keeps balance, foot contact and timing and reports where her joints
// are; this turns those joints into one bind-to-pose motion per bone.
//
// Limbs follow their bend plane when bent and swing without twisting from
// their parent when straight, blended between the two, so a straightening
// knee or elbow never flips. The forearm takes half of the hand's turn about
// it, which keeps both the wrist and the elbow from wringing.
#import "figure_math"
#import "figure_anatomy"
#import "kryon/scene"
#import "std/math"
#import "std/vec"

FigureJoints :: struct {
    // The standing height the joints were solved for.
    height: float64
    pelvis: Vector3
    spine: Vector3
    chest: Vector3
    neck: Vector3
    pelvis_turn: FigureQuat
    chest_turn: FigureQuat
    head_turn: FigureQuat
    shoulders: [2]Vector3
    elbows: [2]Vector3
    wrists: [2]Vector3
    // Palm frames: the fingers point along local -Y and the palm faces +Z.
    hands: [2]FigureQuat
    // 0 open to 1 closed, and 0 to 1 the finger tips curled into a hook.
    fist: [2]float64
    hook: [2]float64
    hips: [2]Vector3
    knees: [2]Vector3
    ankles: [2]Vector3
    toes: [2]Vector3
    feet: [2]FigureQuat
}

// One bone's motion. A bind point p goes to origin + turn * stretch(p -
// rest_origin), where stretch scales by WIDTH across the bone and by LENGTH
// along its rest direction AXIS.
FigureBonePose :: struct {
    rest_origin: Vector3
    origin: Vector3
    axis: Vector3
    turn: FigureQuat
    width: float64
    length: float64
}

FigureBonePoint :: (pose: FigureBonePose, point: Vector3) -> Vector3 {
    local := FigureSub(point, pose.rest_origin)
    along := FigureDot(local, pose.axis)
    stretched := FigureAddScaled(FigureScale(local, pose.width), pose.axis, along * (pose.length - pose.width))
    return FigureAdd(pose.origin, FigureRotate(pose.turn, stretched))
}

// The figure's joints standing at rest, scaled to HEIGHT. Practices use it
// as a neutral pose, and tests check that it reproduces the bind surface.
FigureRestJoints :: (anatomy: *FigureAnatomy, height: float64) -> FigureJoints {
    joints: FigureJoints
    joints.height = height
    joints.pelvis_turn = FigureIdentity()
    joints.chest_turn = FigureIdentity()
    joints.head_turn = FigureIdentity()
    k := ifx anatomy.height > 0.0 then height / anatomy.height else 1.0
    for bone: anatomy.bones[:] {
        origin := FigureScale(bone.origin, k)
        tip := FigureScale(bone.tip, k)
        side := bone.side
        if bone.role == 0 {
            joints.pelvis = origin
            joints.spine = tip
        } else if bone.role == 1 {
            joints.chest = tip
        } else if bone.role == 2 {
            joints.neck = tip
        } else if bone.role == 4 {
            joints.shoulders[side] = origin
            joints.elbows[side] = tip
        } else if bone.role == 5 {
            joints.wrists[side] = tip
        } else if bone.role == 6 {
            joints.hands[side] = FigureFrame(FigureSub(bone.origin, bone.tip), FigureV3(0.0, 0.0, 1.0),
                FigureV3(0.0, 1.0, 0.0))
        } else if bone.role == 8 {
            joints.hips[side] = origin
            joints.knees[side] = tip
        } else if bone.role == 9 {
            joints.ankles[side] = tip
        } else if bone.role == 10 {
            joints.toes[side] = tip
            joints.feet[side] = FigureIdentity()
        }
    }
    return joints
}

FigurePose :: (anatomy: *FigureAnatomy, joints: *FigureJoints, poses: *Vec(FigureBonePose)) -> bool {
    count := anatomy.bones.count
    if count == 0 || anatomy.height <= 0.0 || !Finite64(joints.height) || joints.height <= 0.0 ||
    !VecResize(poses.*, count) {
        return false
    }
    width := joints.height / anatomy.height
    // The bone of each role on each side; fingers are found by parent.
    found: [11][2]s32
    for role: 0..10 {
        found[role][0] = -1
        found[role][1] = -1
    }
    for index: 0..count - 1 {
        bone := anatomy.bones[index]
        if bone.role != 7 {
            found[bone.role][bone.side] = cast(s32)index
        }
        rest: FigureBonePose
        rest.rest_origin = bone.origin
        rest.origin = FigureScale(bone.origin, width)
        rest.axis = FigureNormalize(FigureSub(bone.tip, bone.origin))
        rest.turn = FigureIdentity()
        rest.width = width
        rest.length = width
        poses.*[index] = rest
    }
    for role: 0..3 {
        if found[role][0] < 0 {
            return false
        }
    }
    FigurePoseTrunk(anatomy, poses, found[0][0], joints.pelvis, joints.spine, joints.pelvis_turn)
    FigurePoseTrunk(anatomy, poses, found[1][0], joints.spine, joints.chest,
        FigureBlend(joints.pelvis_turn, joints.chest_turn, 0.5))
    FigurePoseTrunk(anatomy, poses, found[2][0], joints.chest, joints.neck, joints.chest_turn)
    head := *poses.*[found[3][0]]
    head.origin = joints.neck
    head.turn = FigureQuatNormalize(joints.head_turn)
    for side: 0..1 {
        if found[4][side] < 0 || found[5][side] < 0 || found[6][side] < 0 ||
        found[8][side] < 0 || found[9][side] < 0 || found[10][side] < 0 {
            return false
        }
        arm_bend := FigureCross(FigureSub(anatomy.bones[found[4][side]].tip,
            anatomy.bones[found[4][side]].origin), FigureV3(0.0, 0.0, 1.0))
        hand_bone := anatomy.bones[found[6][side]]
        hand_rest := FigureFrame(FigureSub(hand_bone.origin, hand_bone.tip), FigureV3(0.0, 0.0, 1.0),
            FigureV3(0.0, 1.0, 0.0))
        hand_turn := FigureMultiply(FigureQuatNormalize(joints.hands[side]), FigureConjugate(hand_rest))
        // Each limb starts at the surface's own socket as the trunk carries
        // it, so a solver whose shoulders or hips sit wider, higher or lower
        // never pulls the limb away from the trunk; the limb still reaches
        // the solver's elbow or knee and its hand or foot.
        shoulder := FigureBonePoint(poses.*[found[2][0]], anatomy.bones[found[4][side]].origin)
        FigurePoseLimb(anatomy, poses, found[4][side], found[5][side], joints.chest_turn,
            shoulder, joints.elbows[side], joints.wrists[side], arm_bend, true, hand_turn)
        hand := *poses.*[found[6][side]]
        hand.origin = joints.wrists[side]
        hand.turn = hand_turn
        leg_bend := FigureCross(FigureSub(anatomy.bones[found[8][side]].tip,
            anatomy.bones[found[8][side]].origin), FigureV3(0.0, 0.0, -1.0))
        hip := FigureBonePoint(poses.*[found[0][0]], anatomy.bones[found[8][side]].origin)
        FigurePoseLimb(anatomy, poses, found[8][side], found[9][side], joints.pelvis_turn,
            hip, joints.knees[side], joints.ankles[side], leg_bend, false, FigureIdentity())
        foot_bone := anatomy.bones[found[10][side]]
        foot := *poses.*[found[10][side]]
        foot.origin = joints.ankles[side]
        foot.turn = FigureAim(FigureQuatNormalize(joints.feet[side]), foot.axis,
            FigureSub(joints.toes[side], joints.ankles[side]))
        foot.length = FigureDistance(joints.toes[side], joints.ankles[side]) /
        FigureDistance(foot_bone.tip, foot_bone.origin)
    }
    // Fingers bend about the knuckle line from the hand; parents come first.
    // MakeHuman spreads the fingers wide at rest, so each one first closes
    // toward the middle finger, and even an open hand keeps a slight curl.
    middle: [2]Vector3
    for index: 0..count - 1 {
        bone := anatomy.bones[index]
        if bone.role == 7 && bone.finger == 3 && bone.segment == 0 {
            hand := poses.*[bone.parent]
            middle[bone.side] = FigureNormalize(FigureRotate(hand.turn, FigureSub(bone.tip, bone.origin)))
        }
    }
    gather: [6]float64 = .[0.0, 0.0, 0.35, 0.0, 0.35, 0.5]
    for index: 0..count - 1 {
        bone := anatomy.bones[index]
        if bone.role != 7 {
            continue
        }
        side := bone.side
        parent := poses.*[bone.parent]
        root := FigureBonePoint(parent, bone.origin)
        straight := FigureRotate(parent.turn, FigureScale(FigureSub(bone.tip, bone.origin), width))
        if bone.segment == 0 && bone.finger >= 2 {
            size := FigureLength(straight)
            straight = FigureScale(FigureNormalize(FigureLerp(FigureNormalize(straight), middle[side],
                gather[bone.finger])), size)
        }
        fist := FigureClamp(joints.fist[side], 0.18, 1.0)
        hook := FigureClamp(joints.hook[side], 0.0, 1.0)
        bend := fist * 0.7
        if bone.segment > 0 {
            bend = fist * 0.65 + hook * (0.6 + cast(float64)bone.segment * 0.5)
        }
        if bone.finger == 1 {
            bend *= 0.55
        }
        knuckles := FigureAxis(joints.hands[side], 1.0, 0.0, 0.0)
        direction := FigureRotate(FigureAxisAngle(knuckles, -bend), straight)
        finger := *poses.*[index]
        finger.origin = root
        finger.turn = FigureAim(parent.turn, finger.axis, direction)
    }
    for index: 0..count - 1 {
        pose := poses.*[index]
        if !FigureFinite(pose.origin) || !FigureQuatFinite(pose.turn) || !Finite64(pose.length) ||
        pose.length <= 0.0 {
            return false
        }
    }
    return true
}

// BASE turned further by the shortest swing that lays the rest AXIS along
// ACTUAL.
FigureAim :: (base: FigureQuat, axis: Vector3, actual: Vector3) -> FigureQuat {
    if FigureLength(actual) < 0.000001 {
        return base
    }
    return FigureQuatNormalize(FigureMultiply(FigureSwing(FigureRotate(base, axis), actual), base))
}

#scope_file
FigurePoseTrunk :: (anatomy: *FigureAnatomy, poses: *Vec(FigureBonePose), index: s32,
    origin: Vector3, tip: Vector3, base: FigureQuat) {
    bone := anatomy.bones[index]
    pose := *poses.*[index]
    pose.origin = origin
    pose.turn = FigureAim(FigureQuatNormalize(base), pose.axis, FigureSub(tip, origin))
    pose.length = FigureDistance(tip, origin) / FigureDistance(bone.tip, bone.origin)
}

// A two-bone limb from ROOT through MIDDLE to END. REST_BEND is the rest
// hinge axis the middle joint bends about. With TWIST the lower bone also
// takes half of TWIST_SOURCE's turn about its own length.
FigurePoseLimb :: (anatomy: *FigureAnatomy, poses: *Vec(FigureBonePose), upper_index: s32,
    lower_index: s32, parent: FigureQuat, root: Vector3, middle: Vector3, end: Vector3,
    rest_bend: Vector3, twist: bool, twist_source: FigureQuat) {
    upper_bone := anatomy.bones[upper_index]
    lower_bone := anatomy.bones[lower_index]
    upper := *poses.*[upper_index]
    lower := *poses.*[lower_index]
    u0 := upper.axis
    l0 := lower.axis
    // The rest hinge: the rest bend itself when the limb is bent at rest.
    hinge0 := FigureCross(u0, l0)
    if FigureLength(hinge0) < 0.06 {
        hinge0 = rest_bend
    }
    hinge0 = FigureNormalize(FigureAddScaled(hinge0, u0, -FigureDot(hinge0, u0)))
    u := FigureSub(middle, root)
    l := FigureSub(end, middle)
    upper.origin = root
    upper.length = FigureLength(u) / FigureDistance(upper_bone.tip, upper_bone.origin)
    lower.origin = middle
    lower.length = FigureLength(l) / FigureDistance(lower_bone.tip, lower_bone.origin)
    swung := FigureAim(FigureQuatNormalize(parent), u0, u)
    turn := swung
    cross := FigureCross(FigureNormalize(u), FigureNormalize(l))
    bent := FigureSmooth(FigureLength(cross), 0.06, 0.30)
    if bent > 0.0 {
        hinge := FigureNormalize(cross)
        rest_frame := FigureFrame(u0, hinge0, FigureV3(0.0, 0.0, 1.0))
        bend_frame := FigureFrame(u, hinge, FigureV3(0.0, 0.0, 1.0))
        turn = FigureBlend(swung, FigureMultiply(bend_frame, FigureConjugate(rest_frame)), bent)
    }
    upper.turn = turn
    lower_turn := FigureAim(turn, l0, l)
    if twist {
        // The hand's turn about the forearm, measured in the forearm's own
        // rest frame; the forearm carries half of it.
        relative := FigureMultiply(FigureConjugate(lower_turn), twist_source)
        along := relative.x * l0.x + relative.y * l0.y + relative.z * l0.z
        angle := 2.0 * Atan2(along, relative.w)
        if angle > FIGURE_PI {
            angle -= 2.0 * FIGURE_PI
        } else if angle < -FIGURE_PI {
            angle += 2.0 * FIGURE_PI
        }
        lower_turn = FigureQuatNormalize(FigureMultiply(lower_turn, FigureAxisAngle(l0, angle * 0.5)))
    }
    lower.turn = lower_turn
}
