// A practice figure loaded from a glTF 2.0 or VRM model and posed from the
// practices' solver-neutral joints (FigureJoints).
//
// The model's humanoid bones are found by name: VRoid's J_Bip_*, Mixamo's
// mixamorig names and the common Blender names. Each pose turns those bones
// so the limbs reach the solver's wrists and ankles with the model's own
// segment lengths; the trunk, head and feet take the solver's turns. The whole
// model is scaled so its legs match the solver's and placed so its ankles
// stand on the solver's ankles. A VRM model's hair and clothes swing on its
// spring bones and its eyes blink while the pose is played over time.
#import "figure_math"
#import "figure_joints"
#import "figure_cloth"
#import "kryon/scene"
#import "kryon/scene_gltf"
#import "kryon/scene_skin"
#import "kryon/scene_vrm"
#import "kryon/shader"
#import "std/math"
#import "std/vec"

// Humanoid roles. Each side has its shoulder to toes, then five fingers of
// three segments (thumb first).
FIGURE_HIPS :: 0
FIGURE_SPINE :: 1
FIGURE_CHEST :: 2
FIGURE_UPPER_CHEST :: 3
FIGURE_NECK :: 4
FIGURE_HEAD :: 5
FIGURE_SIDE :: 6
FIGURE_SHOULDER :: 0
FIGURE_UPPER_ARM :: 1
FIGURE_LOWER_ARM :: 2
FIGURE_HAND :: 3
FIGURE_UPPER_LEG :: 4
FIGURE_LOWER_LEG :: 5
FIGURE_FOOT :: 6
FIGURE_TOES :: 7
FIGURE_SIDE_BONES :: 8
FIGURE_FINGERS :: 22
FIGURE_BONES :: 52

FIGURE_TOON_UNIFORMS :: 5

FigureModel :: struct {
    model: GltfModel
    instance: GltfSceneInstance
    // The glTF node of each role, or -1.
    bones: [FIGURE_BONES]s32
    // Each node's world rotation and position at rest, in the model's space.
    rest_turn: Vec(FigureQuat)
    rest_at: Vec(Vector3)
    // The nodes from the roots down, and each node's turn during a pose.
    order: Vec(s32)
    turn: Vec(FigureQuat)
    role_of: Vec(s32)
    // Turns the model to face +Z with its left at +X.
    facing: FigureQuat
    yaw: float64
    // The model's relaxed palm frames in the solver's coordinate system.
    hand_rest: [2]FigureQuat
    // Measured sole vertices in foot-relative, facing-corrected bind space.
    sole_points: [128]Vector3
    sole_count: [2]s32
    sole_heel: [2]Vector3
    sole_ball: [2]Vector3
    // The toon look: a shader, and per scene mesh its uniforms. Each mesh
    // keeps the importer's own base colour texture, which the renderer
    // uploads once and samples into the shader's vertex data.
    toon: ShaderProgram
    uniforms: Vec(ShaderValue)
    toon_nodes: Vec(s32)
    // A VRM model's spring bones and expressions, and the practice time of
    // the last pose played (below zero when none was).
    avatar: VrmAvatar
    clock: float64
    has_training: bool
    training: bool
    training_skirt: bool
    ready: bool
}

FigureModelRelease :: (figure: *FigureModel) {
    GltfInstanceRelease(*figure.instance)
    GltfModelRelease(*figure.model)
    VecFree(figure.rest_turn)
    VecFree(figure.rest_at)
    VecFree(figure.order)
    VecFree(figure.turn)
    VecFree(figure.role_of)
    VecFree(figure.uniforms)
    VecFree(figure.toon_nodes)
    ShaderFree(*figure.toon)
    VrmAvatarRelease(*figure.avatar)
    figure.clock = -1.0
    figure.ready = false
}

FigureSideRole :: (side: s32, bone: s32) -> s32 {
    return FIGURE_SIDE + side * FIGURE_SIDE_BONES + bone
}

FigureFingerRole :: (side: s32, finger: s32, segment: s32) -> s32 {
    return FIGURE_FINGERS + side * 15 + finger * 3 + segment
}

// Loads PATH into SCENE: the model, its humanoid bones and its rest pose.
// The model's own animations are not used. False when the file is not a
// valid model or has no hips, legs and arms.
FigureModelLoad :: (figure: *FigureModel, scene: *Scene, path: string) -> bool {
    loaded := GltfReadFile(path)
    defer GltfModelRelease(*loaded)
    if !FigureModelUse(figure, scene, *loaded) {
        return false
    }
    if VrmReadFile(*figure.avatar, path) {
        unused VrmSpringsReset(*figure.avatar, *figure.model, *figure.instance)
    }
    return true
}

// Package assets are already in memory on desktop, Android and Web.
FigureModelLoadBytes :: (figure: *FigureModel, scene: *Scene, bytes: []u8) -> bool {
    loaded := GltfReadBytes(bytes)
    defer GltfModelRelease(*loaded)
    if !FigureModelUse(figure, scene, *loaded) {
        return false
    }
    if VrmReadBytes(*figure.avatar, bytes) {
        unused VrmSpringsReset(*figure.avatar, *figure.model, *figure.instance)
    }
    return true
}

FigureModelUse :: (figure: *FigureModel, scene: *Scene, loaded: *GltfModel) -> bool {
    FigureModelRelease(figure)
    FigureTakeModel(*figure.model, loaded)
    if !figure.model.valid || !GltfSceneCreate(scene, *figure.model, *figure.instance) {
        return false
    }
    GltfSetDualQuaternion(*figure.instance, true)
    // Blend both sides of the ankle seam with the same affine transform.
    // Tailored garments use affine blending so adjacent vertices keep
    // following the same rotation path in deep reaches and lunges.
    for index: 0..figure.instance.meshes.count - 1 {
        inst := *figure.instance.meshes[index]
        mesh := *figure.model.meshes[inst.mesh_index]
        name := TextView(mesh.name[:])
        primitive := *mesh.primitives[inst.primitive_index]
        high: float64 = -1000.0
        for vertex: primitive.indices[:] {
            high = FigureMax(high, primitive.positions[vertex].y)
        }
        if high < 0.30 || name == "PracticeClothing" || name == "PracticeWrapFacings" {
            inst.skin.dual_quaternion = false
        }
    }
    count := figure.model.nodes.count
    if !VecResize(figure.rest_turn, count) || !VecResize(figure.rest_at, count) ||
    !VecResize(figure.turn, count) || !VecResize(figure.role_of, count) {
        return false
    }
    VecClear(figure.order)
    for node: 0..count - 1 {
        if figure.model.nodes[node].parent < 0 && !FigureModelOrder(figure, cast(s32)node) {
            return false
        }
    }
    // Rest rotations compose down the hierarchy; rest positions come from
    // the evaluated world matrices, so node scales are honoured.
    for at: 0..figure.order.count - 1 {
        node := figure.order[at]
        local := figure.model.nodes[node].rotation
        turn: FigureQuat = .{local.x, local.y, local.z, local.w}
        parent := figure.model.nodes[node].parent
        figure.rest_turn[node] = FigureQuatNormalize(turn)
        if parent >= 0 {
            figure.rest_turn[node] = FigureQuatNormalize(FigureMultiply(figure.rest_turn[parent], turn))
        }
        world := figure.instance.node_world[node]
        figure.rest_at[node] = .{world.m[3], world.m[7], world.m[11]}
    }
    for role: 0..FIGURE_BONES - 1 {
        figure.bones[role] = -1
    }
    for node: 0..count - 1 {
        figure.role_of[node] = -1
        named := *figure.model.nodes[node]
        role := FigureRoleOfName(TextView(named.name[:]))
        if role >= 0 && figure.bones[role] < 0 {
            figure.bones[role] = cast(s32)node
            figure.role_of[node] = role
        }
    }
    needed: [9]s32 = .[FIGURE_HIPS, FIGURE_HEAD, FigureSideRole(0, FIGURE_UPPER_ARM), FigureSideRole(1, FIGURE_UPPER_ARM),
        FigureSideRole(0, FIGURE_LOWER_ARM), FigureSideRole(0, FIGURE_UPPER_LEG), FigureSideRole(1, FIGURE_UPPER_LEG),
        FigureSideRole(0, FIGURE_FOOT), FigureSideRole(1, FIGURE_FOOT)]
    for role: needed {
        if figure.bones[role] < 0 {
            return false
        }
    }
    // Which way the model faces: its toes ahead of its feet, its left side
    // to its left.
    ahead := FigureSub(FigureModelRest(figure, FigureSideRole(0, FIGURE_TOES), FigureSideRole(0, FIGURE_LOWER_LEG)),
        FigureModelRest(figure, FigureSideRole(0, FIGURE_FOOT), FigureSideRole(0, FIGURE_FOOT)))
    left := FigureSub(FigureModelRest(figure, FigureSideRole(0, FIGURE_UPPER_ARM), -1),
        FigureModelRest(figure, FigureSideRole(1, FIGURE_UPPER_ARM), -1))
    forward := FigureCross(left, FigureV3(0.0, 1.0, 0.0))
    if FigureDot(FigureV3(ahead.x, 0.0, ahead.z), forward) < 0.0 {
        // Left and forward disagree; trust the toes.
        forward = FigureV3(ahead.x, 0.0, ahead.z)
    }
    // A left-handed model (its left on the right when it faces forward)
    // keeps its own naming; only the heading is turned.
    figure.yaw = -Atan2(forward.x, forward.z)
    figure.facing = FigureAxisAngle(FigureV3(0.0, 1.0, 0.0), figure.yaw)
    for side: cast(s32)0..1 {
        figure.hand_rest[side] = FigureModelHandRest(figure, side)
    }
    FigureModelReadSoles(figure)
    figure.has_training = false
    figure.training = false
    figure.training_skirt = false
    for index: 0..figure.instance.meshes.count - 1 {
        inst := *figure.instance.meshes[index]
        mesh := *figure.model.meshes[inst.mesh_index]
        name := TextView(mesh.name[:])
        if name == "PracticeTrainingBody" {
            figure.has_training = true
        }
        if name == "PracticeTrainingBody" || name == "PracticeTrainingSkirt" {
            unused SetVisible(scene, inst.scene_node, false)
        }
    }
    figure.clock = -1.0
    figure.ready = true
    return true
}

// Switch the woman's wardrobe on the retained scene. Her skin, springs and
// bare feet are shared by every practice.
FigureModelTraining :: (figure: *FigureModel, scene: *Scene, training: bool, skirt: bool = true) {
    show_skirt := training && skirt
    if !figure.has_training || (figure.training == training && figure.training_skirt == show_skirt) {
        return
    }
    for index: 0..figure.instance.meshes.count - 1 {
        inst := *figure.instance.meshes[index]
        mesh := *figure.model.meshes[inst.mesh_index]
        node := *figure.model.nodes[inst.gltf_node]
        name := TextView(mesh.name[:])
        if name == "PracticeTrainingSkirt" {
            unused SetVisible(scene, inst.scene_node, show_skirt)
        } else if name == "PracticeTrainingBody" {
            unused SetVisible(scene, inst.scene_node, training)
        } else if name == "PracticeClothing" || name == "PracticeSkirt" || name == "PracticeWrapFacings" ||
        TextView(node.name[:]) == "Body" {
            unused SetVisible(scene, inst.scene_node, !training)
        }
    }
    figure.training = training
    figure.training_skirt = show_skirt
}

// Poses the loaded model in SCENE at JOINTS. Played at SECONDS of the
// practice, a VRM model's hair swings from the last pose and its eyes
// blink; a still pose (no SECONDS) has the hair hanging at rest.
FigureModelPose :: (figure: *FigureModel, scene: *Scene, joints: *FigureJoints, seconds: float64 = -1.0) -> bool {
    if !figure.ready {
        return false
    }
    turns: [FIGURE_BONES]FigureQuat
    for role: 0..FIGURE_BONES - 1 {
        turns[role] = FigureIdentity()
    }
    pelvis := FigureQuatNormalize(joints.pelvis_turn)
    chest := FigureQuatNormalize(joints.chest_turn)
    head := FigureQuatNormalize(joints.head_turn)
    turns[FIGURE_HIPS] = pelvis
    turns[FIGURE_SPINE] = FigureBlend(pelvis, chest, 0.35)
    turns[FIGURE_CHEST] = FigureBlend(pelvis, chest, 0.7)
    turns[FIGURE_UPPER_CHEST] = chest
    turns[FIGURE_NECK] = FigureBlend(chest, head, 0.5)
    turns[FIGURE_HEAD] = head
    for side: cast(s32)0..1 {
        upper_direction := FigureSub(joints.elbows[side], joints.shoulders[side])
        collar := FigureModelCollar(chest, upper_direction, side)
        turns[FigureSideRole(side, FIGURE_SHOULDER)] = collar
        upper := FigureModelAim(figure, collar, FigureSideRole(side, FIGURE_UPPER_ARM),
            FigureSideRole(side, FIGURE_LOWER_ARM), upper_direction)
        turns[FigureSideRole(side, FIGURE_UPPER_ARM)] = upper
        lower := FigureModelAim(figure, upper, FigureSideRole(side, FIGURE_LOWER_ARM), FigureSideRole(side, FIGURE_HAND),
            FigureSub(joints.wrists[side], joints.elbows[side]))
        turns[FigureSideRole(side, FIGURE_LOWER_ARM)] = lower
        turns[FigureSideRole(side, FIGURE_HAND)] = FigureMultiply(
            FigureQuatNormalize(joints.hands[side]), FigureConjugate(figure.hand_rest[side]))
        thigh := FigureModelAim(figure, pelvis, FigureSideRole(side, FIGURE_UPPER_LEG),
            FigureSideRole(side, FIGURE_LOWER_LEG), FigureSub(joints.knees[side], joints.hips[side]))
        turns[FigureSideRole(side, FIGURE_UPPER_LEG)] = thigh
        shin := FigureModelAim(figure, thigh, FigureSideRole(side, FIGURE_LOWER_LEG), FigureSideRole(side, FIGURE_FOOT),
            FigureSub(joints.ankles[side], joints.knees[side]))
        turns[FigureSideRole(side, FIGURE_LOWER_LEG)] = shin
        // The calibrated foot sole is level at rest. Toe-bone direction
        // is anatomical, not the sole plane; aiming it tilted planted feet.
        foot := FigureQuatNormalize(joints.feet[side])
        turns[FigureSideRole(side, FIGURE_FOOT)] = foot
        turns[FigureSideRole(side, FIGURE_TOES)] = foot
        // The fingers relax into a soft curl, closing further with a fist.
        hand := turns[FigureSideRole(side, FIGURE_HAND)]
        for finger: cast(s32)0..4 {
            parent := hand
            for segment: cast(s32)0..2 {
                role := FigureFingerRole(side, finger, segment)
                next := ifx segment < 2 then FigureFingerRole(side, finger, segment + 1) else -1
                bend := FigureModelFingerAxis(figure, role, next, side)
                amount := FigureFingerCurl(joints.fist[side], joints.hook[side], finger, segment)
                turned := FigureMultiply(FigureAxisAngle(FigureRotate(parent, bend), amount), parent)
                turns[role] = turned
                parent = turned
            }
        }
    }
    FigureModelSetTurns(figure, turns[:])
    // The legs match the solver's; the ankles stand on the solver's ankles.
    model_leg: float64
    solver_leg: float64
    for side: cast(s32)0..1 {
        model_leg += FigureDistance(FigureModelRest(figure, FigureSideRole(side, FIGURE_UPPER_LEG), -1),
            FigureModelRest(figure, FigureSideRole(side, FIGURE_LOWER_LEG), -1)) +
            FigureDistance(FigureModelRest(figure, FigureSideRole(side, FIGURE_LOWER_LEG), -1),
            FigureModelRest(figure, FigureSideRole(side, FIGURE_FOOT), -1))
        solver_leg += FigureDistance(joints.hips[side], joints.knees[side]) + FigureDistance(joints.knees[side], joints.ankles[side])
    }
    scale := ifx model_leg > 0.000001 then solver_leg / model_leg else 1.0
    feet_targets: [2]Vector3
    for side: cast(s32)0..1 {
        // Place the measured contact without changing the avatar’s foot proportions.
        feet_targets[side] = FigureModelSoleTarget(figure, joints, side, scale)
    }
    // Keep authored pelvis translation. Averaging the ankles inferred from
    // rotating model bones shifts the whole root during a weight transfer,
    // even when both feet stay planted in the solver.
    model_pelvis := FigureScale(FigureRotate(figure.facing,
        FigureModelPosed(figure, figure.bones[FIGURE_HIPS])), scale)
    offset := FigureSub(joints.pelvis, model_pelvis)
    // A measured sole changes the ankle target. Keep the pelvis inside
    // both legs' reach before solving them, including nearly straight
    // stances where the two avatars' thigh/shin ratios differ.
    hips: [2]Vector3
    reaches: [2]float64
    for side: cast(s32)0..1 {
        upper := FigureSideRole(side, FIGURE_UPPER_LEG)
        lower := FigureSideRole(side, FIGURE_LOWER_LEG)
        foot := FigureSideRole(side, FIGURE_FOOT)
        hips[side] = FigureScale(FigureRotate(figure.facing,
            FigureModelPosed(figure, figure.bones[upper])), scale)
        reaches[side] = (FigureDistance(FigureModelRest(figure, upper, -1), FigureModelRest(figure, lower, -1)) +
            FigureDistance(FigureModelRest(figure, lower, -1), FigureModelRest(figure, foot, -1))) * scale - 0.000002
    }
    for pass: 0..31 {
        adjusted := false
        for side: cast(s32)0..1 {
            delta := FigureSub(FigureAdd(offset, hips[side]), feet_targets[side])
            distance := FigureLength(delta)
            if distance > reaches[side] + 0.0000000001 && reaches[side] > 0.0 {
                offset = FigureAddScaled(offset, delta, reaches[side] / distance - 1.0)
                adjusted = true
            }
        }
        if !adjusted {
            break
        }
    }
    // Bone directions alone cannot keep contacts fixed when the model's
    // thigh/shin or upper/lower arm ratios differ from the solver's. Solve
    // each limb again with the model's lengths, reaching the same targets.
    for side: cast(s32)0..1 {
        FigureModelReach(figure, turns[:], pelvis, FigureSideRole(side, FIGURE_UPPER_LEG),
            FigureSideRole(side, FIGURE_LOWER_LEG), FigureSideRole(side, FIGURE_FOOT),
            feet_targets[side], joints.knees[side], offset, scale)
        shoulder := FigureSideRole(side, FIGURE_SHOULDER)
        forearm := FigureSideRole(side, FIGURE_LOWER_ARM)
        hand := FigureSideRole(side, FIGURE_HAND)
        FigureModelReach(figure, turns[:], turns[shoulder], FigureSideRole(side, FIGURE_UPPER_ARM), forearm, hand,
            joints.wrists[side], joints.elbows[side], offset, scale)
        if figure.bones[forearm] >= 0 && figure.bones[hand] >= 0 {
            rest := FigureRotate(figure.facing, FigureSub(FigureModelRest(figure, hand, -1),
                FigureModelRest(figure, forearm, -1)))
            turns[forearm] = FigureModelForearm(turns[forearm], turns[hand], rest)
        }
    }
    FigureModelSetTurns(figure, turns[:])
    root := figure.instance.root_node
    SetPosition(scene, root, offset.x, offset.y, offset.z)
    SetRotation(scene, root, 0.0, figure.yaw, 0.0)
    SetScale(scene, root, scale, scale, scale)
    gaze := FigureGaze(joints)
    VrmLookAtSet(*figure.avatar, *figure.model, *figure.instance, gaze.x, gaze.y)
    FigureModelLive(figure, offset, scale, seconds)
    if !GltfUpdateScene(*figure.model, *figure.instance, scene) {
        return false
    }
    FigureModelToeContact(figure, scene, joints)
    FigureModelCloth(figure, scene, joints)
    return true
}

// Let the toes flex along the floor as the heel rises. The surface beyond
// the ball follows the forefoot correction across its whole thickness.
FigureModelToeContact :: (figure: *FigureModel, scene: *Scene, joints: *FigureJoints) {
    root := scene.nodes[figure.instance.root_node]
    for index: 0..figure.instance.meshes.count - 1 {
        inst := *figure.instance.meshes[index]
        source := *figure.model.meshes[inst.mesh_index]
        if TextView(source.name[:]) != "PracticeBareFeet" {
            continue
        }
        side := inst.primitive_index
        turn := FigureQuatNormalize(joints.feet[side])
        up := FigureRotate(turn, .{0.0, 1.0, 0.0})
        if up.y < 0.1 || FigureDistance(joints.heels[side], joints.balls[side]) < 0.01 {
            continue
        }
        heel_down := joints.heels[side].y <= joints.balls[side].y
        anchor := ifx heel_down then joints.heels[side] else joints.balls[side]
        rest := ifx heel_down then figure.sole_heel[side] else figure.sole_ball[side]
        // A lifted leg needs no contact adjustment once its toes clear.
        ankle := FigureModelRest(figure, FigureSideRole(side, FIGURE_FOOT), -1)
        matrix := figure.instance.node_world[inst.gltf_node]
        mesh := scene.meshes[scene.nodes[inst.scene_node].mesh]
        local_up := FigureV3(matrix.m[4], matrix.m[5], matrix.m[6])
        slope := FigureDot(local_up, local_up) * root.scale.x
        if slope <= 0.000001 { continue }
        changed := false
        for vertex: 0..inst.skin.positions.count - 1 {
            from_ankle := FigureRotate(figure.facing, FigureSub(inst.skin.positions[vertex], ankle))
            from_pivot := FigureV3(from_ankle.x - rest.x, 0.0, from_ankle.z - rest.z)
            level := anchor.y + FigureRotate(turn, FigureScale(from_pivot, root.scale.x)).y
            point := *scene.positions[mesh.first_vertex + vertex]
            height := root.position.y + (FigureDot(local_up, <<point) + matrix.m[7]) * root.scale.x
            lift := -FigureMin(level, height)
            if lift > 0.0000001 {
                <<point = FigureAddScaled(<<point, local_up, lift / slope)
                changed = true
            }
        }
        if changed { ComputeNormals(scene, inst.scene_node) }
    }
}

// The meditation layers drape around the body. The short training skirt
// already follows the hips and thighs using its own skin weights.
FigureModelCloth :: (figure: *FigureModel, scene: *Scene, joints: *FigureJoints) {
    if figure.training { return }
    root := scene.nodes[figure.instance.root_node]
    scale := root.scale.x
    rest_hips := figure.rest_at[figure.bones[FIGURE_HIPS]]
    hip_world := FigureModelWorld(figure, scene, FIGURE_HIPS)
    forward := FigureRotate(FigureQuatNormalize(joints.pelvis_turn), .{0.0, 0.0, 1.0})
    lateral := FigureRotate(FigureQuatNormalize(joints.pelvis_turn), .{1.0, 0.0, 0.0})
    yaw := ifx lateral.x * lateral.x + lateral.z * lateral.z > 0.000001 then Atan2(-lateral.z, lateral.x) else Atan2(forward.x, forward.z)
    cloth_turn := FigureMultiply(FigureAxisAngle(.{0.0, 1.0, 0.0}, yaw), figure.facing)
    down := FigureRotate(FigureQuatNormalize(joints.pelvis_turn), .{0.0, -1.0, 0.0})
    // Only near-horizontal floor poses let the hem trail along the legs.
    // Deep standing and kneeling forms still drape around raised thighs.
    prone := (1.0 - FigureSmooth(hip_world.y, 0.16, 0.33)) *
        (1.0 - FigureSmooth(FigureAbs(down.y), 0.28, 0.55))
    legward := FigureV3(down.x * prone, 0.0, down.z * prone)
    thigh_lift := 1.0 - prone
    skirt_forward := FigureV3(Sin(yaw), 0.0, Cos(yaw))
    airborne := FigureMin(FigureMin(joints.heels[0].y, joints.balls[0].y),
        FigureMin(joints.heels[1].y, joints.balls[1].y))
    foot_span := FigureAbs(FigureDot(FigureSub(joints.ankles[0], joints.ankles[1]), lateral))
    // Opening the legs carries the airborne fabric further. The motion fades
    // into the ordinary drape as the soles land.
    flutter := FigureSmooth(airborne, 0.002, 0.09) *
        (0.65 + 0.35 * FigureSmooth(foot_span, 0.24, 0.64))
    legs: [6]Vector3
    arms: [6]Vector3
    sleeves: [2]bool
    thighs: [2]Vector3
    for side: cast(s32)0..1 {
        legs[side * 3] = FigureModelWorld(figure, scene, FigureSideRole(side, FIGURE_UPPER_LEG))
        legs[side * 3 + 1] = FigureModelWorld(figure, scene, FigureSideRole(side, FIGURE_LOWER_LEG))
        legs[side * 3 + 2] = FigureModelWorld(figure, scene, FigureSideRole(side, FIGURE_FOOT))
        thighs[side] = FigureNormalize(FigureSub(legs[side * 3 + 1], legs[side * 3]))
        upper := FigureSideRole(side, FIGURE_UPPER_ARM)
        lower := FigureSideRole(side, FIGURE_LOWER_ARM)
        hand := FigureSideRole(side, FIGURE_HAND)
        sleeves[side] = figure.bones[upper] >= 0 && figure.bones[lower] >= 0 && figure.bones[hand] >= 0
        if sleeves[side] {
            arms[side * 3] = FigureModelWorld(figure, scene, upper)
            arms[side * 3 + 1] = FigureModelWorld(figure, scene, lower)
            arms[side * 3 + 2] = FigureModelWorld(figure, scene, hand)
        }
    }
    for index: 0..figure.instance.meshes.count - 1 {
        inst := *figure.instance.meshes[index]
        source := *figure.model.meshes[inst.mesh_index]
        name := TextView(source.name[:])
        skirt := name == "PracticeSkirt"
        tailored := !inst.skin.dual_quaternion && (name == "PracticeClothing" || name == "PracticeWrapFacings")
        if !skirt && !tailored {
            continue
        }
        mesh := scene.meshes[scene.nodes[inst.scene_node].mesh]
        if skirt {
            for vertex: 0..inst.skin.positions.count - 1 {
                rest := inst.skin.positions[vertex]
                skinned := FigureAdd(root.position, FigureScale(FigureRotate(figure.facing,
                    scene.positions[mesh.first_vertex + vertex]), scale))
                point := FigureClothHang(skinned, rest, rest_hips, hip_world, figure.facing, yaw, scale, legward, flutter)
                outward := FigureNormalize(FigureRotate(cloth_turn, .{rest.x - rest_hips.x, 0.0, rest.z - rest_hips.z}))
                depth := rest_hips.y - rest.y
                if thigh_lift > 0.0 {
                    lifted := FigureClothLift(point, outward, depth, scale, thighs[:])
                    point = FigureLerp(point, lifted, thigh_lift)
                }
                point = FigureClothSeat(point, outward, depth, scale, thighs[:], skirt_forward, down.y, thigh_lift)
                point = FigureModelSkirtContact(point, outward, depth, scale, legs[:], arms[:], sleeves[:])
                scene.positions[mesh.first_vertex + vertex] = FigureScale(FigureRotate(FigureConjugate(figure.facing),
                    FigureSub(point, root.position)), 1.0 / scale)
            }
        }
        // Spread a point's displacement over neighbouring fabric edges.
        // The skirt keeps its skinned waist seam as the drape settles.
        stretch := ifx skirt then 1.6 else 2.2
        refresh_normals := skirt
        for pass: 0..11 {
            changed := false
            for edge: 0..mesh.index_count - 1 {
                next := edge - edge % 3 + (edge + 1) % 3
                a := scene.indices[mesh.first_index + edge]
                b := scene.indices[mesh.first_index + next]
                rest_a := inst.skin.positions[a]
                rest_b := inst.skin.positions[b]
                length := FigureDistance(rest_a, rest_b)
                if length < 0.001 {
                    continue
                }
                point_a := *scene.positions[mesh.first_vertex + a]
                point_b := *scene.positions[mesh.first_vertex + b]
                delta := FigureSub(<<point_b, <<point_a)
                distance := FigureLength(delta)
                limit := length * stretch
                if distance <= limit {
                    continue
                }
                weight_a := ifx skirt then FigureSmooth(rest_hips.y - rest_a.y, 0.015, 0.10) else 1.0
                weight_b := ifx skirt then FigureSmooth(rest_hips.y - rest_b.y, 0.015, 0.10) else 1.0
                if weight_a + weight_b <= 0.0 {
                    continue
                }
                correction := FigureScale(delta, (1.0 - limit / distance) / (weight_a + weight_b))
                <<point_a = FigureAddScaled(<<point_a, correction, weight_a)
                <<point_b = FigureAddScaled(<<point_b, correction, -weight_b)
                changed = true
            }
            if !changed {
                break
            }
            refresh_normals = true
            // Edge relaxation can pull a free panel back through the legs or
            // sleeves. Project those points before the next edge pass.
            if skirt {
                for vertex: 0..inst.skin.positions.count - 1 {
                    rest := inst.skin.positions[vertex]
                    depth := rest_hips.y - rest.y
                    if depth <= 0.015 { continue }
                    outward := FigureNormalize(FigureRotate(cloth_turn, .{rest.x - rest_hips.x, 0.0, rest.z - rest_hips.z}))
                    point := *scene.positions[mesh.first_vertex + vertex]
                    world := FigureAdd(root.position, FigureScale(FigureRotate(figure.facing, <<point), scale))
                    cleared := FigureModelSkirtContact(world, outward, depth, scale, legs[:], arms[:], sleeves[:])
                    <<point = FigureScale(FigureRotate(FigureConjugate(figure.facing),
                        FigureSub(cleared, root.position)), 1.0 / scale)
                }
            }
        }
        if refresh_normals {
            ComputeNormals(scene, inst.scene_node)
        }
    }
}

FigureModelSkirtContact :: (point: Vector3, outward: Vector3, depth: float64, scale: float64,
    legs: []Vector3, arms: []Vector3, sleeves: []bool) -> Vector3 {
    loose := FigureSmooth(depth, 0.015, 0.10)
    if loose <= 0.0 {
        point.y = FigureMax(point.y, 0.006)
        return point
    }
    for pass: 0..3 {
        previous := point
        for side: 0..1 {
            joint := side * 3
            outside := FigureClothOutside(point, legs[joint], legs[joint + 1], 0.078 * scale, outward)
            point = FigureLerp(point, outside, loose)
            outside = FigureClothOutside(point, legs[joint + 1], legs[joint + 2], 0.054 * scale, outward)
            point = FigureLerp(point, outside, loose)
            if sleeves[side] {
                outside = FigureClothOutside(point, arms[joint], arms[joint + 1], 0.071 * scale, outward)
                point = FigureLerp(point, outside, loose)
                outside = FigureClothOutside(point, arms[joint + 1], arms[joint + 2], 0.062 * scale, outward)
                point = FigureLerp(point, outside, loose)
            }
        }
        if FigureDistance(point, previous) < 0.000001 { break }
    }
    point.y = FigureMax(point.y, 0.006)
    return point
}

FigureModelWorld :: (figure: *FigureModel, scene: *Scene, role: s32) -> Vector3 {
    world := figure.instance.node_world[figure.bones[role]]
    root := scene.nodes[figure.instance.root_node]
    return FigureAdd(root.position, FigureScale(FigureRotate(figure.facing,
        .{world.m[3], world.m[7], world.m[11]}), root.scale.x))
}

// Relaxed fingers have a small graduated curl; fists close every joint,
// while a hook curls the tips further without clenching the knuckles.
FigureFingerCurl :: (fist: float64, hook: float64, finger: s32, segment: s32) -> float64 {
    relaxed := 0.14 + cast(float64)finger * 0.025
    closed := relaxed + FigureClamp(fist, 0.0, 1.0) * 1.0
    if segment > 0 {
        closed += FigureClamp(hook, 0.0, 1.0) * 0.65
    }
    return FigureMin(1.35, closed) * ifx finger == 0 then 0.4 else 1.0
}

// Eyes lead a gentle head turn rather than staring straight out of the
// skull. The practice's head frame already follows its cued hand or gaze.
// Return degrees left and up, bounded well within the VRM's lookAt curves.
FigureGaze :: (joints: *FigureJoints) -> Vector3 {
    forward := FigureRotate(FigureQuatNormalize(joints.head_turn), FigureV3(0.0, 0.0, 1.0))
    relative := FigureRotate(FigureConjugate(FigureQuatNormalize(joints.chest_turn)), forward)
    yaw := Atan2(relative.x, relative.z) * 180.0 / FIGURE_PI
    pitch := Atan2(relative.y, Sqrt(relative.x * relative.x + relative.z * relative.z)) * 180.0 / FIGURE_PI
    return .{FigureClamp(yaw * 0.2, -8.0, 8.0), FigureClamp(pitch * 0.2, -5.0, 5.0), 0.0}
}

// Place the measured foot support on the solver's actual contact, rather
// than assuming two avatars have the solver's ankle-to-sole dimensions.
FigureModelSoleTarget :: (figure: *FigureModel, joints: *FigureJoints, side: s32, scale: float64) -> Vector3 {
    if figure.sole_count[side] == 0 || FigureDistance(joints.heels[side], joints.balls[side]) < 0.01 {
        return joints.ankles[side]
    }
    heel := joints.heels[side].y <= joints.balls[side].y
    contact := ifx heel then joints.heels[side] else joints.balls[side]
    relative := ifx heel then figure.sole_heel[side] else figure.sole_ball[side]
    turned := FigureRotate(FigureQuatNormalize(joints.feet[side]), FigureScale(relative, scale))
    target := FigureSub(contact, turned)
    lowest: float64 = 1000.0
    for index: cast(s32)0..figure.sole_count[side] - 1 {
        relative_point := figure.sole_points[side * 64 + index]
        point := FigureRotate(FigureQuatNormalize(joints.feet[side]), FigureScale(relative_point, scale))
        lowest = FigureMin(lowest, point.y)
    }
    target.y = contact.y - lowest
    return target
}

// Measurements from the actual skinned plantar vertices in the scene.
// Only contacts on the floor with the sole facing upward are planted.
FigureContactMeasure :: struct {
    vertices: s64
    floor_error: float64
    flatness: float64
    pivot_error: float64
}

FigureModelContacts :: (figure: *FigureModel, scene: *Scene, joints: *FigureJoints, surface_height: float64 = 0.0) -> FigureContactMeasure {
    result: FigureContactMeasure
    root := scene.nodes[figure.instance.root_node]
    for index: 0..figure.instance.meshes.count - 1 {
        inst := *figure.instance.meshes[index]
        source := *figure.model.meshes[inst.mesh_index]
        if !FigureSoleMesh(TextView(source.name[:])) {
            continue
        }
        side := inst.primitive_index
        heel_down := joints.heels[side].y <= joints.balls[side].y
        target := ifx heel_down then joints.heels[side] else joints.balls[side]
        up := FigureRotate(FigureQuatNormalize(joints.feet[side]), FigureV3(0.0, 1.0, 0.0))
        if FigureAbs(target.y - surface_height) > 0.000001 || up.y < 0.1 {
            continue
        }
        mesh := scene.meshes[scene.nodes[inst.scene_node].mesh]
        matrix := figure.instance.node_world[inst.gltf_node]
        low: float64 = 1000.0
        high: float64 = -1000.0
        back: float64 = 1000.0
        front: float64 = -1000.0
        heel: Vector3
        ball: Vector3
        for vertex: 0..inst.skin.positions.count - 1 {
            rest := inst.skin.positions[vertex]
            if FigureAbs(rest.y) > 0.000001 {
                continue
            }
            point := scene.positions[mesh.first_vertex + vertex]
            in_model := FigureV3(matrix.m[0] * point.x + matrix.m[1] * point.y + matrix.m[2] * point.z + matrix.m[3],
                matrix.m[4] * point.x + matrix.m[5] * point.y + matrix.m[6] * point.z + matrix.m[7],
                matrix.m[8] * point.x + matrix.m[9] * point.y + matrix.m[10] * point.z + matrix.m[11])
            actual := FigureAdd(root.position, FigureScale(FigureRotate(figure.facing, in_model), root.scale.x))
            low = FigureMin(low, actual.y)
            high = FigureMax(high, actual.y)
            along := FigureRotate(figure.facing, rest).z
            if along < back {
                back = along
                heel = actual
            }
            if along > front {
                front = along
                ball = actual
            }
            result.vertices += 1
        }
        result.floor_error = FigureMax(result.floor_error, FigureAbs(low - surface_height))
        if up.y > 0.999999 {
            result.flatness = FigureMax(result.flatness, high - low)
        }
        result.pivot_error = FigureMax(result.pivot_error, FigureDistance(ifx heel_down then heel else ball, target))
    }
    return result
}

// How closed the eyes are at SECONDS: a blink every two to five seconds,
// closing quickly and opening a little slower, now and then twice.
FigureBlink :: (seconds: float64) -> float64 {
    if seconds < 0.0 {
        return 0.0
    }
    cell := cast(s64)(seconds / FIGURE_BLINK_EVERY)
    closed: float64
    for twice: 0..1 {
        chance := FigureHash(cast(float64)(cell * 2 + twice))
        if twice == 1 && chance > 0.25 {
            break
        }
        start := cast(float64)cell * FIGURE_BLINK_EVERY + 0.3 + FigureHash(cast(float64)cell + 0.5) * 2.4 +
            cast(float64)twice * 0.32
        t := seconds - start
        if t >= 0.0 && t < 0.07 {
            closed = FigureMax(closed, FigureSmooth(t, 0.0, 0.07))
        } else if t >= 0.07 && t < 0.2 {
            closed = FigureMax(closed, 1.0 - FigureSmooth(t - 0.07, 0.0, 0.13))
        }
    }
    return closed
}

// Gives every mesh a cel-shaded look on its own base colour texture: light
// and shade split softly at the terminator, with a rim light.
FigureModelToon :: (figure: *FigureModel, scene: *Scene) -> bool {
    if !figure.ready || !FigureToonCompile(*figure.toon).ok {
        return false
    }
    meshes := figure.instance.meshes.count
    if !VecResize(figure.uniforms, meshes * FIGURE_TOON_UNIFORMS) || !VecResize(figure.toon_nodes, meshes) {
        return false
    }
    for at: 0..meshes - 1 {
        placed := *figure.instance.meshes[at]
        figure.toon_nodes[at] = placed.scene_node
        material := scene.meshes[scene.nodes[placed.scene_node].mesh].material
        first := at * FIGURE_TOON_UNIFORMS
        figure.uniforms[first] = .{1.0, 1.0, 1.0, 1.0}
        figure.uniforms[first + 1] = .{-0.45, 0.75, 0.55, 0.0}
        figure.uniforms[first + 2] = .{0.70, 0.64, 0.78, 1.0}
        figure.uniforms[first + 3] = .{0.0, 0.0, 1.0, 0.0}
        figure.uniforms[first + 4] = .{0.18, 0.20, 0.26, 0.0}
        source := *figure.model.meshes[placed.mesh_index]
        if TextView(source.name[:]) == "PracticeBareFeet" {
            // The small sole and toe facets need a softer shade and rim.
            figure.uniforms[first + 2] = .{0.91, 0.87, 0.88, 1.0}
            figure.uniforms[first + 4] = .{0.045, 0.05, 0.06, 0.0}
        }
        material.kind = .MaterialUnlit
        material.vertex_colors = false
        material.shader = *figure.toon
        material.shader_uniforms = figure.uniforms[first:first + FIGURE_TOON_UNIFORMS]
        SetMaterial(scene, placed.scene_node, material)
    }
    return true
}

// Sets the light and view directions the toon look shades by, in the
// world's space.
FigureModelLight :: (figure: *FigureModel, light: Vector3, view: Vector3) {
    for at: 0..figure.toon_nodes.count - 1 {
        first := at * FIGURE_TOON_UNIFORMS
        figure.uniforms[first + 1] = .{light.x, light.y, light.z, 0.0}
        figure.uniforms[first + 3] = .{view.x, view.y, view.z, 0.0}
    }
}

#scope_file
FIGURE_BLINK_EVERY :: 3.2

// The shoulder girdle lifts with an elevated arm and slides forward during
// a reach. Use the chest frame and mirror the signs across the body. The
// clavicle moves the shoulder socket before the exact wrist IK is solved.
FigureModelCollar :: (chest: FigureQuat, direction: Vector3, side: s32) -> FigureQuat {
    arm := FigureNormalize(FigureRotate(FigureConjugate(chest), direction))
    sign := ifx side == 0 then 1.0 else -1.0
    lift := sign * 0.18 * FigureSmooth(arm.y, -0.20, 0.76)
    reach := -sign * 0.14 * FigureSmooth(arm.z, 0.12, 0.86)
    forward := FigureAxisAngle(.{0.0, 1.0, 0.0}, reach)
    upward := FigureAxisAngle(.{0.0, 0.0, 1.0}, lift)
    return FigureMultiply(chest, FigureMultiply(forward, upward))
}

// Share the palm's signed axial turn along the forearm. The axis is the
// solved elbow-to-wrist line, so this can change skin roll without moving
// the wrist. Fade near an ambiguous half turn, where the short arc changes
// sign, and near a pure swing, where the twist has no usable projection.
FigureModelForearm :: (forearm: FigureQuat, hand: FigureQuat, rest: Vector3) -> FigureQuat {
    axis := FigureNormalize(FigureRotate(forearm, rest))
    delta := FigureMultiply(hand, FigureConjugate(forearm))
    sine := FigureDot(.{delta.x, delta.y, delta.z}, axis)
    cosine := FigureAbs(delta.w)
    size := Sqrt(sine * sine + cosine * cosine)
    if size < 0.000001 || FigureLength(axis) < 0.000001 {
        return forearm
    }
    signed := ifx delta.w < 0.0 then -sine else sine
    angle := 2.0 * Atan2(signed, cosine)
    weight := FigureSmooth(cosine / size, 0.08, 0.34) * FigureSmooth(size, 0.05, 0.28)
    roll := FigureClamp(angle * 0.52, -0.96, 0.96) * weight
    return FigureQuatNormalize(FigureMultiply(FigureAxisAngle(axis, roll), forearm))
}

FigureHash :: (value: float64) -> float64 {
    wave := Sin(value * 12.9898 + 78.233) * 43758.5453
    return wave - cast(float64)cast(s64)wave + ifx wave < 0.0 then 1.0 else 0.0
}

// The live parts of a VRM model at SECONDS: springs placed in the world as
// the root is, swinging since the last pose (settled and hung at rest on a
// still pose, a seek or the first one), and the eyes' blink.
FigureModelLive :: (figure: *FigureModel, offset: Vector3, scale: float64, seconds: float64) {
    if !figure.avatar.ready {
        return
    }
    unused VrmSetExpression(*figure.avatar, *figure.model, *figure.instance, "blink", FigureBlink(seconds))
    if figure.avatar.joints.count == 0 {
        return
    }
    half := figure.yaw * 0.5
    VrmSetFrame(*figure.avatar, .{0.0, Sin(half), 0.0, Cos(half)}, offset, scale)
    elapsed := seconds - figure.clock
    if seconds < 0.0 || figure.clock < 0.0 || elapsed < 0.0 || elapsed > 1.0 {
        VrmSpringsSettle(*figure.avatar, *figure.model, *figure.instance)
        for step: 0..29 {
            VrmSpringsUpdate(*figure.avatar, *figure.model, *figure.instance, 1.0 / 60.0)
        }
    } else {
        // Keep momentum across skipped paint frames. The solver handles
        // eight spring steps per update, so longer gaps do not need catch-up.
        VrmSpringsUpdate(*figure.avatar, *figure.model, *figure.instance, FigureMin(elapsed, 0.10))
    }
    figure.clock = seconds
}


// Moves FROM's contents into TO, leaving FROM with TO's old ones.
FigureTakeModel :: (to: *GltfModel, from: *GltfModel) {
    to.valid = from.valid
    to.default_scene = from.default_scene
    VecSwap(to.error, from.error)
    VecSwap(to.version, from.version)
    VecSwap(to.generator, from.generator)
    VecSwap(to.copyright, from.copyright)
    VecSwap(to.buffers, from.buffers)
    VecSwap(to.buffer_views, from.buffer_views)
    VecSwap(to.accessors, from.accessors)
    VecSwap(to.samplers, from.samplers)
    VecSwap(to.images, from.images)
    VecSwap(to.textures, from.textures)
    VecSwap(to.materials, from.materials)
    VecSwap(to.meshes, from.meshes)
    VecSwap(to.nodes, from.nodes)
    VecSwap(to.skins, from.skins)
    VecSwap(to.animations, from.animations)
    VecSwap(to.scenes, from.scenes)
    from.valid = false
}

FigureModelOrder :: (figure: *FigureModel, node: s32) -> bool {
    if !VecPush(figure.order, node) {
        return false
    }
    named := *figure.model.nodes[node]
    for at: 0..named.children.count - 1 {
        if !FigureModelOrder(figure, named.children[at]) {
            return false
        }
    }
    return true
}

// ROLE's rest position, or FALLBACK's when the model has no ROLE.
FigureModelRest :: (figure: *FigureModel, role: s32, fallback: s32) -> Vector3 {
    node := figure.bones[role]
    if node < 0 && fallback >= 0 {
        node = figure.bones[fallback]
    }
    return ifx node >= 0 then figure.rest_at[node] else Vector3.{}
}

// The plantars use a rigid foot weight. Measure the actual underside
// vertices to establish the heel and forefoot pivots.
FigureSoleMesh :: (name: string) -> bool {
    return name == "PracticeBareFeet" || name == "PracticeClothSlippers"
}

FigureModelReadSoles :: (figure: *FigureModel) {
    figure.sole_count[0] = 0
    figure.sole_count[1] = 0
    for mesh_index: 0..figure.model.meshes.count - 1 {
        mesh := *figure.model.meshes[mesh_index]
        if !FigureSoleMesh(TextView(mesh.name[:])) || mesh.primitives.count != 2 {
            continue
        }
        for side: cast(s32)0..1 {
            primitive := *mesh.primitives[side]
            low: float64 = 1000.0
            for point: primitive.positions[:] {
                low = FigureMin(low, point.y)
            }
            ankle := FigureModelRest(figure, FigureSideRole(side, FIGURE_FOOT), -1)
            back: float64 = 1000.0
            front: float64 = -1000.0
            for point: primitive.positions[:] {
                if point.y > low + 0.000001 || figure.sole_count[side] >= 64 {
                    continue
                }
                relative := FigureRotate(figure.facing, FigureSub(point, ankle))
                figure.sole_points[side * 64 + figure.sole_count[side]] = relative
                figure.sole_count[side] += 1
                if relative.z < back {
                    back = relative.z
                    figure.sole_heel[side] = relative
                }
                if relative.z > front {
                    front = relative.z
                    figure.sole_ball[side] = relative
                }
            }
        }
    }
}

// Apply world-space bone turns as local glTF rotations. Unmapped nodes
// retain their bind rotation and inherit the nearest posed ancestor.
FigureModelSetTurns :: (figure: *FigureModel, turns: []FigureQuat) {
    // Each node turns with the nearest posed bone above it.
    for at: 0..figure.order.count - 1 {
        node := figure.order[at]
        parent := figure.model.nodes[node].parent
        role := figure.role_of[node]
        figure.turn[node] = ifx role >= 0 then turns[role] else ifx parent >= 0 then figure.turn[parent] else FigureIdentity()
        if role < 0 {
            continue
        }
        // World rotation now: the figure-space turn carried into the
        // model's space; the local rotation is that against the parent's.
        inverse_facing := FigureConjugate(figure.facing)
        mine := FigureMultiply(FigureMultiply(FigureMultiply(inverse_facing, figure.turn[node]), figure.facing),
            figure.rest_turn[node])
        above := FigureIdentity()
        if parent >= 0 {
            above = FigureMultiply(FigureMultiply(FigureMultiply(inverse_facing, figure.turn[parent]), figure.facing),
                figure.rest_turn[parent])
        }
        local := FigureQuatNormalize(FigureMultiply(FigureConjugate(above), mine))
        figure.instance.rotations[node] = .{local.x, local.y, local.z, local.w}
        figure.instance.trs_dirty[node] = true
    }
}

// Retarget a limb with its own segment lengths. The knee/elbow keeps the
// solver's bend plane; unreachable targets stop just short of full reach.
FigureModelReach :: (figure: *FigureModel, turns: []FigureQuat, base: FigureQuat,
    upper: s32, lower: s32, end: s32, target: Vector3, bend: Vector3, offset: Vector3, scale: float64) {
    if figure.bones[upper] < 0 || figure.bones[lower] < 0 || figure.bones[end] < 0 {
        return
    }
    origin := FigureAdd(offset, FigureScale(FigureRotate(figure.facing,
        FigureModelPosed(figure, figure.bones[upper])), scale))
    first := FigureDistance(FigureModelRest(figure, upper, -1), FigureModelRest(figure, lower, -1)) * scale
    second := FigureDistance(FigureModelRest(figure, lower, -1), FigureModelRest(figure, end, -1)) * scale
    if first < 0.000001 || second < 0.000001 {
        return
    }
    delta := FigureSub(target, origin)
    distance := FigureLength(delta)
    if distance < 0.000001 {
        return
    }
    direction := FigureScale(delta, 1.0 / distance)
    distance = FigureClamp(distance, FigureAbs(first - second) + 0.000001, first + second - 0.000001)
    pole := FigureSub(bend, origin)
    pole = FigureAddScaled(pole, direction, -FigureDot(pole, direction))
    if FigureLength(pole) < 0.000001 {
        pole = FigureAddScaled(FigureV3(0.0, 0.0, 1.0), direction, -direction.z)
    }
    if FigureLength(pole) < 0.000001 {
        pole = FigureCross(direction, FigureV3(1.0, 0.0, 0.0))
    }
    along := (first * first - second * second + distance * distance) / (2.0 * distance)
    across := Sqrt(FigureMax(first * first - along * along, 0.0))
    middle := FigureAddScaled(FigureAddScaled(origin, direction, along), FigureNormalize(pole), across)
    endpoint := FigureAddScaled(origin, direction, distance)
    turns[upper] = FigureModelAim(figure, base, upper, lower, FigureSub(middle, origin))
    turns[lower] = FigureModelAim(figure, turns[upper], lower, end, FigureSub(endpoint, middle))
}

// BASE carried on, then swung so the bone from ROLE to NEXT points along
// TARGET (in the figure's space).
FigureModelAim :: (figure: *FigureModel, base: FigureQuat, role: s32, next: s32, target: Vector3) -> FigureQuat {
    if figure.bones[role] < 0 || figure.bones[next] < 0 || FigureLength(target) < 0.000001 {
        return base
    }
    rest := FigureRotate(figure.facing, FigureSub(figure.rest_at[figure.bones[next]], figure.rest_at[figure.bones[role]]))
    if FigureLength(rest) < 0.000001 {
        return base
    }
    return FigureQuatNormalize(FigureMultiply(FigureSwing(FigureRotate(base, rest), target), base))
}

// Palm frames use -Y along the fingers and +Z out of the palm. Convert
// that frame to the model's bind pose once, rather than letting the wrist
// inherit the forearm and discard the technique's cued palm turns.
FigureModelHandRest :: (figure: *FigureModel, side: s32) -> FigureQuat {
    wrist := FigureModelRest(figure, FigureSideRole(side, FIGURE_HAND), -1)
    middle := FigureModelRest(figure, FigureFingerRole(side, 2, 0), FigureSideRole(side, FIGURE_HAND))
    along := FigureNormalize(FigureRotate(figure.facing, FigureSub(middle, wrist)))
    if FigureLength(along) < 0.000001 {
        along = FigureNormalize(FigureRotate(figure.facing, FigureSub(wrist,
            FigureModelRest(figure, FigureSideRole(side, FIGURE_LOWER_ARM), -1))))
    }
    return FigureFrame(FigureScale(along, -1.0), FigureV3(0.0, -1.0, 0.0), FigureV3(0.0, 0.0, 1.0))
}

// The axis a finger segment curls about at rest, in the figure's space:
// across the finger, towards the palm (which faces down in a T pose and
// in towards the body in an A pose).
FigureModelFingerAxis :: (figure: *FigureModel, role: s32, next: s32, side: s32) -> Vector3 {
    node := figure.bones[role]
    if node < 0 {
        return FigureV3(0.0, 0.0, 1.0)
    }
    tip := FigureAdd(figure.rest_at[node], FigureSub(figure.rest_at[node], figure.rest_at[figure.model.nodes[node].parent]))
    if next >= 0 && figure.bones[next] >= 0 {
        tip = figure.rest_at[figure.bones[next]]
    }
    along := FigureNormalize(FigureRotate(figure.facing, FigureSub(tip, figure.rest_at[node])))
    palm := FigureV3(0.0, -1.0, 0.0)
    if FigureAbs(FigureDot(along, palm)) > 0.8 {
        palm = FigureV3(ifx side == 0 then -1.0 else 1.0, 0.0, 0.0)
    }
    return FigureNormalize(FigureCross(along, palm))
}

// Where NODE is in the model's space once posed (before the root's scale,
// turn and placement): down from its root, each step turned with the node
// above it.
FigureModelPosed :: (figure: *FigureModel, node: s32) -> Vector3 {
    chain: [64]s32
    depth: s32
    at := node
    while at >= 0 && depth < 64 {
        chain[depth] = at
        depth += 1
        at = figure.model.nodes[at].parent
    }
    if depth == 0 {
        return .{}
    }
    inverse_facing := FigureConjugate(figure.facing)
    position := figure.rest_at[chain[depth - 1]]
    for step: 0..depth - 2 {
        above := chain[depth - 1 - step]
        below := chain[depth - 2 - step]
        turn := FigureMultiply(FigureMultiply(inverse_facing, figure.turn[above]), figure.facing)
        position = FigureAdd(position, FigureRotate(turn, FigureSub(figure.rest_at[below], figure.rest_at[above])))
    }
    return position
}

// The role a node's NAME names, or -1. VRoid (J_Bip_C_Hips, J_Bip_L_UpperArm,
// J_Bip_L_Index1), Mixamo (mixamorig:LeftArm, mixamorig:LeftHandIndex1) and
// Blender (upper_arm.L, forearm.L, thigh.L, shin.L) names.
FigureRoleOfName :: (name: string) -> s32 {
    centre: [30]string = .["J_Bip_C_Hips", "mixamorig:Hips", "mixamorig_Hips", "Hips", "pelvis",
        "J_Bip_C_Spine", "mixamorig:Spine", "mixamorig_Spine", "Spine", "spine",
        "J_Bip_C_Chest", "mixamorig:Spine1", "mixamorig_Spine1", "Chest", "spine.001",
        "J_Bip_C_UpperChest", "mixamorig:Spine2", "mixamorig_Spine2", "UpperChest", "spine.002",
        "J_Bip_C_Neck", "mixamorig:Neck", "mixamorig_Neck", "Neck", "neck",
        "J_Bip_C_Head", "mixamorig:Head", "mixamorig_Head", "Head", "head"]
    for at: 0..29 {
        if name == centre[at] {
            return cast(s32)(at / 5)
        }
    }
    for side: cast(s32)0..1 {
        vroid := ifx side == 0 then "J_Bip_L_" else "J_Bip_R_"
        mixamo := ifx side == 0 then "mixamorig:Left" else "mixamorig:Right"
        mixamo_ := ifx side == 0 then "mixamorig_Left" else "mixamorig_Right"
        blender := ifx side == 0 then ".L" else ".R"
        bones_vroid: [8]string = .["Shoulder", "UpperArm", "LowerArm", "Hand", "UpperLeg", "LowerLeg", "Foot", "ToeBase"]
        bones_mixamo: [8]string = .["Shoulder", "Arm", "ForeArm", "Hand", "UpLeg", "Leg", "Foot", "ToeBase"]
        bones_blender: [8]string = .["shoulder", "upper_arm", "forearm", "hand", "thigh", "shin", "foot", "toe"]
        for bone: cast(s32)0..FIGURE_SIDE_BONES - 1 {
            if FigureNamed(name, vroid, bones_vroid[bone], "") || FigureNamed(name, mixamo, bones_mixamo[bone], "") ||
            FigureNamed(name, mixamo_, bones_mixamo[bone], "") || FigureNamed(name, "", bones_blender[bone], blender) {
                return FigureSideRole(side, bone)
            }
        }
        fingers_vroid: [5]string = .["Thumb", "Index", "Middle", "Ring", "Little"]
        fingers_mixamo: [5]string = .["HandThumb", "HandIndex", "HandMiddle", "HandRing", "HandPinky"]
        digits: [3]string = .["1", "2", "3"]
        for finger: cast(s32)0..4 {
            for segment: cast(s32)0..2 {
                if FigureNamed2(name, vroid, fingers_vroid[finger], digits[segment]) ||
                FigureNamed2(name, mixamo, fingers_mixamo[finger], digits[segment]) ||
                FigureNamed2(name, mixamo_, fingers_mixamo[finger], digits[segment]) {
                    return FigureFingerRole(side, finger, segment)
                }
            }
        }
    }
    return -1
}

FigureNamed :: (name: string, before: string, middle: string, after: string) -> bool {
    if name.count != before.count + middle.count + after.count {
        return false
    }
    return name[0:before.count] == before && name[before.count:before.count + middle.count] == middle &&
        name[before.count + middle.count:name.count] == after
}

FigureNamed2 :: (name: string, before: string, middle: string, digit: string) -> bool {
    return FigureNamed(name, before, middle, digit)
}

// The toon look. Registers: 0 the material's colour times its texture, in
// linear light, 1 position, 2 normal, 3 UV. Uniforms: 0 a colour factor, 1
// light direction, 2 shade tint, 3 view direction, 4 the rim light's
// colour.
FigureToonCompile :: (program: *ShaderProgram) -> ShaderDiagnostic {
    code: FigureToonCode
    FigureToonSlot(*code, .ShaderUniform, 5, 0, 0)
    FigureToonOp(*code, .ShaderMultiply, 4, 0, 5)
    // The look was tuned on texels squared from sRGB; the renderer decodes
    // sRGB exactly, so lift its colours back to that curve (c(1.188 -
    // 0.188c) follows it within about 1%), keeping alpha.
    FigureToonLiteral(*code, 11, -0.188, -0.188, -0.188, -0.188)
    FigureToonOp(*code, .ShaderMultiply, 11, 4, 11)
    FigureToonLiteral(*code, 12, 1.188, 1.188, 1.188, 1.188)
    FigureToonOp(*code, .ShaderAdd, 11, 11, 12)
    FigureToonOp(*code, .ShaderMultiply, 11, 4, 11)
    FigureToonLiteral(*code, 12, 1.0, 1.0, 1.0, 0.0)
    FigureToonMix(*code, 4, 4, 11, 12)
    // Light and shade, split softly a little into the shadow side.
    FigureToonSlot(*code, .ShaderUniform, 13, 0, 1)
    FigureToonSlot(*code, .ShaderNormalize, 13, 13, 0)
    FigureToonOp(*code, .ShaderDot, 14, 2, 13)
    FigureToonLiteral(*code, 15, 5.0, 5.0, 5.0, 5.0)
    FigureToonOp(*code, .ShaderMultiply, 14, 14, 15)
    FigureToonLiteral(*code, 15, 0.75, 0.75, 0.75, 0.75)
    FigureToonOp(*code, .ShaderAdd, 14, 14, 15)
    FigureToonLiteral(*code, 15, 0.0, 0.0, 0.0, 0.0)
    FigureToonOp(*code, .ShaderMax, 14, 14, 15)
    FigureToonLiteral(*code, 15, 1.0, 1.0, 1.0, 1.0)
    FigureToonOp(*code, .ShaderMin, 14, 14, 15)
    FigureToonSlot(*code, .ShaderUniform, 16, 0, 2)
    FigureToonOp(*code, .ShaderMultiply, 16, 4, 16)
    FigureToonMix(*code, 17, 16, 4, 14)
    // A rim of light where the surface turns away from the eye.
    FigureToonSlot(*code, .ShaderUniform, 18, 0, 3)
    FigureToonSlot(*code, .ShaderNormalize, 18, 18, 0)
    FigureToonOp(*code, .ShaderDot, 19, 2, 18)
    FigureToonLiteral(*code, 20, -1.0, -1.0, -1.0, -1.0)
    FigureToonOp(*code, .ShaderMultiply, 19, 19, 20)
    FigureToonLiteral(*code, 20, 1.0, 1.0, 1.0, 1.0)
    FigureToonOp(*code, .ShaderAdd, 19, 19, 20)
    FigureToonOp(*code, .ShaderMultiply, 19, 19, 19)
    FigureToonOp(*code, .ShaderMultiply, 19, 19, 19)
    FigureToonSlot(*code, .ShaderUniform, 21, 0, 4)
    FigureToonOp(*code, .ShaderMultiply, 19, 19, 21)
    FigureToonOp(*code, .ShaderAdd, 17, 17, 19)
    FigureToonSlot(*code, .ShaderOutput, 0, 17, 0)
    return ShaderCompile(program, code.code[0:code.count])
}

FigureToonCode :: struct {
    code: [64]ShaderInstruction
    count: s32
}

FigureToonOp :: (code: *FigureToonCode, op: ShaderOp, dest: s32, a: s32, b: s32) {
    code.code[code.count] = .{op = op, dest = dest, a = a, b = b}
    code.count += 1
}

FigureToonMix :: (code: *FigureToonCode, dest: s32, a: s32, b: s32, t: s32) {
    code.code[code.count] = .{op = .ShaderMix, dest = dest, a = a, b = b, c = t}
    code.count += 1
}

FigureToonSlot :: (code: *FigureToonCode, op: ShaderOp, dest: s32, a: s32, slot: s32) {
    code.code[code.count] = .{op = op, dest = dest, a = a, slot = slot}
    code.count += 1
}

FigureToonLiteral :: (code: *FigureToonCode, dest: s32, x: float64, y: float64, z: float64, w: float64) {
    code.code[code.count] = .{op = .ShaderLiteral, dest = dest, value = .{x, y, z, w}}
    code.count += 1
}
