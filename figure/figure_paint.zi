// Paints the practice figure as a watercolor. Each region (skin, tunic,
// trousers, hair, sash) carries its own hand-painted texture on UVs that
// follow the form, and the face painting lies over the face. The light
// splits them into flat washes (figure_shader), cloth creases where it
// gathers, and the finish (figure_wash) bleeds, dries, granulates and inks
// the picture and paints her shadow on the ground. The caller owns the
// clock, the pose and where the picture goes; the result is straight RGBA
// in painter.pixels with a transparent background.
#import "figure_math"
#import "figure_anatomy"
#import "figure_joints"
#import "figure_skin"
#import "figure_shader"
#import "figure_wash"
#import "kryon/scene"
#import "kryon/scene_skin"
#import "kryon/scene_render"
#import "kryon/scene_gpu"
#import "kryon/shader"
#import "kryon/image_pixels"
#import "std/file"
#import "std/math"
#import "std/vec"
Raster :: #import "std/image";

// An orthographic camera turned YAW about the vertical (0 looks at her
// front) and PITCH above the horizon, showing HEIGHT metres around CENTER.
FigureView :: struct {
    yaw: float64
    pitch: float64
    height: float64
    center: Vector3
}

FigureStyle :: struct {
    watercolor: bool
    wash: FigureWashSettings
    // A glowing translucent double: lighter washes, a blue rim, no ink.
    luminous: bool
    opacity: float64
    // Her painted shadow on the ground.
    shadow: bool
}

FigureStyleDefault :: () -> FigureStyle {
    return .{watercolor = true, wash = FigureWashDefault(), opacity = 1.0, shadow = true}
}

// Moves the whole body rigidly, for an astral double rising or rolling out
// of the physical one: OFFSET, then ROLL radians about the pelvis-height
// PIVOT in the picture plane.
FigureEffect :: struct {
    offset: Vector3
    pivot: Vector3
    roll: float64
}

// The painted textures: one per region, then the face.
FIGURE_FACE :: 5
FIGURE_TEXTURES :: 6

FigureMedia :: struct {
    anatomy: FigureAnatomy
    paper: Raster.Image
    pigment: Raster.Image
    textures: [FIGURE_TEXTURES]Raster.Image
}

FigureMediaRelease :: (media: *FigureMedia) {
    FigureAnatomyRelease(*media.anatomy)
    FigureImageRelease(*media.paper)
    FigureImageRelease(*media.pigment)
    for index: 0..FIGURE_TEXTURES - 1 {
        FigureImageRelease(*media.textures[index])
    }
}

// DIRECTORY holds anatomy.bin, paper.webp, pigment.webp and the painted
// textures (practices' shared/watercolor). Anything missing or invalid
// gives empty media.
FigureMediaLoad :: (directory: string) -> FigureMedia {
    media: FigureMedia
    path: [1024]u8
    bytes, found := ReadEntireFile(FigurePath(path[:], directory, "/anatomy.bin"))
    if found && FigureAnatomyRead(*media.anatomy, bytes) {
        media.paper = LoadImagePixels(FigurePath(path[:], directory, "/paper.webp"))
        media.pigment = LoadImagePixels(FigurePath(path[:], directory, "/pigment.webp"))
        for index: cast(s32)0..FIGURE_TEXTURES - 1 {
            loaded := LoadImagePixels(FigurePath(path[:], directory, FigureTextureName(index)))
            FigureImageTake(*media.textures[index], *loaded)
        }
    }
    if !FigureMediaReady(*media) {
        FigureMediaRelease(*media)
    }
    return media
}

FigureMediaReady :: (media: *FigureMedia) -> bool {
    ready := media.anatomy.bones.count > 0 && Raster.ImageValid(*media.paper) && Raster.ImageValid(*media.pigment)
    for index: 0..FIGURE_TEXTURES - 1 {
        ready = ready && Raster.ImageValid(*media.textures[index])
    }
    return ready
}

FigureTextureName :: (index: s32) -> string {
    names: [FIGURE_TEXTURES]string = .["/skin.webp", "/tunic.webp", "/trousers.webp", "/hair.webp", "/sash.webp",
        "/face.webp"]
    return names[index]
}

FigurePainter :: struct {
    scene: Scene
    // One skinned surface; each region is its own node drawing that
    // region's triangles of it with its own material.
    skin: SceneSkin
    nodes: [FIGURE_REGIONS]s32
    blend: FigureSkin
    poses: Vec(FigureBonePose)
    gpu: SceneGpuContext
    inked: [3]ShaderProgram
    washed: [3]ShaderProgram
    bare: [3]ShaderProgram
    uniforms: [FIGURE_REGIONS][9]ShaderValue
    samplers: [FIGURE_REGIONS][4]ShaderSampler
    // How far the cloth is gathered: both ends of each cloth triangle edge
    // and its rest length, and the rest length about each vertex.
    ends: Vec(s32)
    rest: Vec(float64)
    around: Vec(float64)
    gathered: Vec(float64)
    // How freely each cloth vertex hangs from the waist, and the waist's
    // middle at rest.
    hang: Vec(float64)
    waist: Vector3
    noise: FigureNoise
    pixels: Raster.Image
    scratch: Raster.Image
    // The ground shadow: an ellipse on the floor at the centre's height.
    shadow_center: Vector3
    shadow_radii: Vector3
    ready: bool
    warmed: bool
    // Whether the last picture came from the GPU, and why not, for the
    // caller's status.
    accelerated: bool
    diagnostic: string
}

FigurePainterRelease :: (painter: *FigurePainter) {
    SceneSkinRelease(*painter.skin)
    VecFree(painter.ends)
    VecFree(painter.rest)
    VecFree(painter.around)
    VecFree(painter.gathered)
    VecFree(painter.hang)
    SceneFree(*painter.scene)
    FigureSkinRelease(*painter.blend)
    VecFree(painter.poses)
    SceneGpuRelease(*painter.gpu)
    for kind: 0..2 {
        ShaderFree(*painter.inked[kind])
        ShaderFree(*painter.washed[kind])
        ShaderFree(*painter.bare[kind])
    }
    FigureImageRelease(*painter.pixels)
    FigureImageRelease(*painter.scratch)
    painter.ready = false
    painter.warmed = false
}

// Draws the figure at JOINTS into a WIDTH by HEIGHT picture with a
// transparent background.
FigurePaint :: (painter: *FigurePainter, media: *FigureMedia, joints: *FigureJoints,
    view: FigureView, style: FigureStyle, effect: FigureEffect, width: s32, height: s32) -> bool {
    if width < 1 || height < 1 || width > 4096 || height > 4096 || !FigureMediaReady(media) ||
    !Finite64(style.opacity) || style.opacity <= 0.0 || style.opacity > 1.0 ||
    !Finite64(view.height) || view.height <= 0.0 || !Finite64(effect.roll) {
        return false
    }
    if !painter.ready && !FigurePainterPrepare(painter, media) {
        return false
    }
    if !FigurePose(*media.anatomy, joints, *painter.poses) ||
    !FigureSkinDeform(*painter.scene, *painter.skin, *painter.blend, painter.poses[:]) {
        return false
    }
    FigureHang(painter)
    FigureGather(painter)
    cosine := Cos(effect.roll)
    sine := Sin(effect.roll)
    for region: cast(s32)0..FIGURE_REGIONS - 1 {
        node := painter.nodes[region]
        SetRotation(*painter.scene, node, 0.0, 0.0, effect.roll)
        SetPosition(*painter.scene, node,
            effect.offset.x + effect.pivot.x - cosine * effect.pivot.x + sine * effect.pivot.y,
            effect.offset.y + effect.pivot.y - sine * effect.pivot.x - cosine * effect.pivot.y,
            effect.offset.z)
        kind := FigureKind(region)
        material := painter.scene.meshes[painter.scene.nodes[node].mesh].material
        material.shader = *painter.inked[kind]
        if !style.watercolor {
            material.shader = *painter.bare[kind]
        } else if style.luminous {
            material.shader = *painter.washed[kind]
        }
        // A translucent double is painted opaque and faded as a whole, so
        // its cloth and body do not build up where they overlap.
        material.opacity = 1.0
        material.transparent = false
        SetMaterial(*painter.scene, node, material)
    }
    FigureShadow(painter, joints)
    toward := FigureV3(Sin(view.yaw) * Cos(view.pitch), Sin(view.pitch), Cos(view.yaw) * Cos(view.pitch))
    half_height := view.height / 2.0
    half_width := half_height * cast(float64)width / cast(float64)height
    camera := OrthographicCamera(-half_width, half_width, half_height, -half_height, 0.05, 30.0)
    camera.target = view.center
    camera.position = FigureAddScaled(view.center, toward, 8.0)
    camera.up = FigureV3(0.0, 1.0, 0.0)
    if FigureAbs(Sin(view.pitch)) > 0.98 {
        camera.up = FigureV3(-Sin(view.yaw), 0.0, -Cos(view.yaw))
    }
    // Light from her upper left and in front, turning with the camera so
    // the washes read the same from every side.
    light := FigureRotate(FigureAxisAngle(FigureV3(0.0, 1.0, 0.0), view.yaw), FigureV3(-0.45, 0.75, 0.55))
    paper := FigureLinear(0xf4ecdc)
    for region: 0..FIGURE_REGIONS - 1 {
        uniforms := painter.uniforms[region][:]
        uniforms[0] = .{1.0, 1.0, 0.0, 0.0}
        uniforms[1] = .{light.x, light.y, light.z, 0.0}
        uniforms[2] = .{toward.x, toward.y, toward.z, 0.0}
        uniforms[3] = .{0.0, 0.0, 0.0, 0.0}
        uniforms[4] = .{0.56, 0.54, 0.70, 1.0}
        uniforms[5] = .{1.03, 1.0, 0.96, 1.0}
        // Dark hair keeps its colour in the light; skin and cloth let the
        // paper through.
        through := ifx region == FIGURE_HAIR then 0.10 else 0.30
        uniforms[6] = .{paper.x * through, paper.y * through, paper.z * through, 0.0}
        uniforms[7] = .{1.0, 1.0, 1.0, FigureRegionAlpha(cast(s32)region)}
        uniforms[8] = .{1.0 - through, 1.0 - through, 1.0 - through, 1.0}
        if style.luminous {
            uniforms[3] = .{0.22, 0.52, 0.75, 0.0}
            uniforms[4] = .{0.80, 0.86, 1.0, 1.0}
            uniforms[5] = .{1.12, 1.14, 1.18, 1.0}
            uniforms[7] = .{1.0, 1.0, 1.0, 1.0}
        }
    }
    if !FigureImageSize(*painter.pixels, width, height) {
        return false
    }
    result := SceneGpuRenderOrCPU(*painter.gpu, *painter.scene, camera, *painter.pixels)
    if !painter.warmed {
        // At Kryon 199b51c9 a sampler texture uploaded during a frame can
        // take another sampler's unit for that frame: the first picture
        // shows the face painting on the skin. Paint it once more.
        painter.warmed = true
        result = SceneGpuRenderOrCPU(*painter.gpu, *painter.scene, camera, *painter.pixels)
    }
    painter.accelerated = result.accelerated
    painter.diagnostic = result.diagnostic
    if !result.ok {
        return false
    }
    if style.watercolor {
        if !FigureWash(*painter.pixels, *painter.scratch, *painter.noise, *media.paper, *media.pigment, style.wash) {
            return false
        }
    } else {
        FigureOpaque(*painter.pixels)
    }
    if style.opacity < 1.0 {
        for index: 0..cast(s64)width * height - 1 {
            alpha := cast(float64)painter.pixels.pixels[index * 4 + 3] * style.opacity
            painter.pixels.pixels[index * 4 + 3] = cast(u8)(alpha + 0.5)
        }
    }
    if style.shadow && !style.luminous {
        FigureShadowUnder(painter, *media.paper, camera, view, light)
    }
    return true
}

FigureLinear :: (value: u32) -> Vector3 {
    return .{FigureChannel((value >> 16) & 255), FigureChannel((value >> 8) & 255), FigureChannel(value & 255)}
}

#scope_file
FigureKind :: (region: s32) -> s32 {
    if region == FIGURE_SKIN {
        return FIGURE_SHADE_SKIN
    }
    return ifx region == FIGURE_HAIR then FIGURE_SHADE_HAIR else FIGURE_SHADE_CLOTH
}

FigureImageTake :: (to: *Raster.Image, from: *Raster.Image) {
    VecSwap(to.pixels, from.pixels)
    to.width = from.width
    to.height = from.height
    FigureImageRelease(from)
}

FigureImageRelease :: (image: *Raster.Image) {
    VecFree(image.pixels)
    image.width = 0
    image.height = 0
}

FigureImageSize :: (image: *Raster.Image, width: s32, height: s32) -> bool {
    if image.width == width && image.height == height {
        return true
    }
    if !VecResize(image.pixels, cast(s64)width * height * 4) {
        return false
    }
    image.width = width
    image.height = height
    return true
}

// Writes how far each vertex's cloth is gathered, from the edges about it
// against their rest lengths, into its vertex data for the creases.
FigureGather :: (painter: *FigurePainter) {
    scene := *painter.scene
    first := scene.meshes[scene.nodes[painter.skin.node].mesh].first_vertex
    for index: 0..painter.gathered.count - 1 {
        painter.gathered[index] = 0.0
    }
    for edge: 0..painter.rest.count - 1 {
        a := painter.ends[edge * 2]
        b := painter.ends[edge * 2 + 1]
        length := FigureDistance(scene.positions[first + a], scene.positions[first + b])
        painter.gathered[a] += length
        painter.gathered[b] += length
    }
    for index: 0..painter.gathered.count - 1 {
        if painter.around[index] > 0.0 {
            ratio := painter.around[index] / FigureMax(painter.gathered[index], 0.000000001)
            scene.colors[first + index] = .{FigureClamp((ratio - 1.03) * 5.0, 0.0, 1.0), 0.0, 0.0}
        }
    }
    scene.geometry_frozen = false
}

// The skirt and the sash tails hang towards the ground: when her pelvis
// tips, as in a fold, a plank or downward dog, they swing about the waist
// from where the pelvis carries them towards straight down, the more the
// nearer the hem.
FigureHang :: (painter: *FigurePainter) {
    scene := *painter.scene
    pelvis := painter.poses[0]
    down := FigureV3(0.0, -1.0, 0.0)
    carried := FigureRotate(pelvis.turn, down)
    if FigureDot(carried, down) > 0.995 {
        return
    }
    swing := FigureSwing(carried, down)
    // How far it swings, 0 upright to 1 upside down.
    tipped := (1.0 - FigureDot(carried, down)) * 0.5
    pivot := FigureBonePoint(pelvis, painter.waist)
    first := scene.meshes[scene.nodes[painter.skin.node].mesh].first_vertex
    for index: 0..painter.hang.count - 1 {
        hang := painter.hang[index]
        if hang <= 0.0 {
            continue
        }
        turn := FigureBlend(FigureIdentity(), swing, hang * 0.85)
        at := first + index
        offset := FigureRotate(turn, FigureSub(scene.positions[at], pivot))
        // Swung over her back it lies closer on her than it hung from the
        // hips.
        axis := FigureRotate(turn, carried)
        along := FigureDot(offset, axis)
        across := FigureAddScaled(offset, axis, -along)
        offset = FigureAddScaled(FigureScale(across, 1.0 - 0.6 * tipped * hang), axis, along)
        scene.positions[at] = FigureAdd(pivot, offset)
        scene.normals[at] = FigureRotate(turn, scene.normals[at])
    }
}

// Spreads the shadow under the joints that rest lowest: her feet when she
// stands, her whole length when she lies down.
FigureShadow :: (painter: *FigurePainter, joints: *FigureJoints) {
    points: [9]Vector3 = .[joints.pelvis, joints.ankles[0], joints.ankles[1], joints.toes[0],
        joints.toes[1], joints.wrists[0], joints.wrists[1], joints.neck, joints.knees[0]]
    floor: float64 = 1000.0
    for point: points {
        floor = FigureMin(floor, point.y)
    }
    low: Vector3 = .{1000.0, 0.0, 1000.0}
    high: Vector3 = .{-1000.0, 0.0, -1000.0}
    for point: points {
        // Only what is near the floor casts onto it.
        if point.y < floor + 0.35 {
            low = .{FigureMin(low.x, point.x), 0.0, FigureMin(low.z, point.z)}
            high = .{FigureMax(high.x, point.x), 0.0, FigureMax(high.z, point.z)}
        }
    }
    painter.shadow_center = .{(low.x + high.x) * 0.5, floor - 0.03, (low.z + high.z) * 0.5}
    painter.shadow_radii = .{(high.x - low.x) * 0.5 + 0.24, 0.0, (high.z - low.z) * 0.5 + 0.20}
}

FigurePixel :: (point: Vector3, camera: SceneCamera, right: Vector3, up: Vector3, scale: float64,
    image: *Raster.Image) -> ShapePoint {
    offset := FigureSub(point, camera.target)
    return .{cast(float64)image.width * 0.5 + FigureDot(offset, right) * scale,
        cast(float64)image.height * 0.5 - FigureDot(offset, up) * scale}
}

// Paints the ground shadow under the finished picture, cast a little away
// from LIGHT. The floor ellipse projects to an ellipse in the picture.
FigureShadowUnder :: (painter: *FigurePainter, paper: *Raster.Image, camera: SceneCamera, view: FigureView,
    light: Vector3) {
    look := FigureNormalize(FigureSub(camera.target, camera.position))
    if FigureAbs(look.y) < 0.03 {
        return
    }
    right := FigureNormalize(FigureCross(look, camera.up))
    up := FigureCross(right, look)
    image := *painter.pixels
    scale := cast(float64)image.height / view.height
    away := FigureNormalize(FigureV3(-light.x, 0.0, -light.z))
    center := FigureAddScaled(painter.shadow_center, away, 0.10)
    // The floor point centre + s X + t Z lands at pixel origin + s A + t B.
    origin := FigurePixel(center, camera, right, up, scale, image)
    a := FigurePixel(FigureAdd(center, FigureV3(painter.shadow_radii.x, 0.0, 0.0)), camera, right, up, scale, image)
    b := FigurePixel(FigureAdd(center, FigureV3(0.0, 0.0, painter.shadow_radii.z)), camera, right, up, scale, image)
    ax := a.x - origin.x
    ay := a.y - origin.y
    bx := b.x - origin.x
    by := b.y - origin.y
    det := ax * by - bx * ay
    if FigureAbs(det) < 0.5 {
        return
    }
    spot: FigureSpot = .{origin = origin, xx = by / det, xy = -bx / det, yx = -ay / det, yy = ax / det}
    FigureShadowWash(image, *painter.noise, paper, 1.0, spot)
}

FigurePath :: (buffer: []u8, directory: string, name: string) -> string {
    if directory.count + name.count > buffer.count {
        return ""
    }
    for index: 0..directory.count - 1 {
        buffer[index] = directory[index]
    }
    for index: 0..name.count - 1 {
        buffer[directory.count + index] = name[index]
    }
    return TextView(buffer[0:directory.count + name.count])
}

FigureChannel :: (channel: u32) -> float64 {
    value := cast(float64)channel / 255.0
    if value <= 0.04045 {
        return value / 12.92
    }
    return Pow((value + 0.055) / 1.055, 2.4)
}

FigurePainterPrepare :: (painter: *FigurePainter, media: *FigureMedia) -> bool {
    for kind: 0..2 {
        if !FigureWashCompile(*painter.inked[kind], cast(s32)kind, true).ok ||
        !FigureWashCompile(*painter.washed[kind], cast(s32)kind, false).ok ||
        !FigureBareCompile(*painter.bare[kind], cast(s32)kind).ok {
            return false
        }
    }
    FigureNoiseFill(*painter.noise)
    SceneInit(*painter.scene)
    painter.scene.background = .{0, 0, 0, 0}
    anatomy := *media.anatomy
    // The triangles grouped by region, each region's run starting at FIRST.
    indices: Vec(s32)
    defer VecFree(indices)
    first: [FIGURE_REGIONS + 1]s32
    for region: cast(s32)0..FIGURE_REGIONS - 1 {
        first[region] = cast(s32)indices.count
        for triangle: 0..anatomy.indices.count / 3 - 1 {
            if anatomy.regions[anatomy.indices[triangle * 3]] == region {
                for corner: 0..2 {
                    if !VecPush(indices, anatomy.indices[triangle * 3 + corner]) {
                        return false
                    }
                }
            }
        }
        FigureBind(painter, media, region)
    }
    first[FIGURE_REGIONS] = cast(s32)indices.count
    material := UnlitMaterial(.{255, 255, 255, 255})
    material.vertex_colors = true
    material.shader = *painter.inked[FIGURE_SHADE_SKIN]
    material.shader_uniforms = painter.uniforms[FIGURE_SKIN][:]
    material.shader_samplers = painter.samplers[FIGURE_SKIN][:]
    if !SceneSkinCreate(*painter.scene, *painter.skin, cast(s32)anatomy.bones.count, anatomy.positions[:],
        anatomy.normals[:], anatomy.uvs[:], indices[:], anatomy.influences[:], material) {
        return false
    }
    // Every region draws its own run of the one surface. The runs share the
    // surface's vertices from its first, which is also the scene's first:
    // SceneIndexedMesh stores scene-wide indices and the renderers add a
    // mesh's first vertex again.
    scene := *painter.scene
    node := scene.nodes[painter.skin.node]
    mesh := scene.meshes[node.mesh]
    if mesh.first_vertex != 0 {
        return false
    }
    painter.nodes[FIGURE_SKIN] = painter.skin.node
    scene.meshes[node.mesh].index_count = first[1] - first[0]
    for region: cast(s32)1..FIGURE_REGIONS - 1 {
        run := mesh
        run.first_index = mesh.first_index + first[region]
        run.index_count = first[region + 1] - first[region]
        run.material.double_sided = region != FIGURE_HAIR
        run.material.shader = *painter.inked[FigureKind(region)]
        run.material.shader_uniforms = painter.uniforms[region][:]
        run.material.shader_samplers = painter.samplers[region][:]
        holder := node
        holder.mesh = cast(s32)scene.meshes.count
        painter.nodes[region] = cast(s32)scene.nodes.count
        if run.index_count == 0 || !VecPush(scene.meshes, run) || !VecPush(scene.nodes, holder) {
            return false
        }
    }
    for index: 0..anatomy.positions.count - 1 {
        detail := anatomy.details[index]
        scene.colors[index] = ifx anatomy.regions[index] == FIGURE_SKIN then Vector3.{detail.x, detail.y,
            anatomy.faces[index]} else Vector3.{}
    }
    scene.geometry_frozen = false
    // Cloth edges, for how far it gathers, and how freely it hangs.
    count := anatomy.positions.count
    if !VecResize(painter.around, count) || !VecResize(painter.gathered, count) ||
    !VecResize(painter.hang, count) {
        return false
    }
    sash: float64
    painter.waist = .{}
    for index: 0..count - 1 {
        painter.around[index] = 0.0
        painter.hang[index] = 0.0
        if anatomy.regions[index] != FIGURE_SKIN {
            painter.hang[index] = FigureClamp(anatomy.details[index].x, 0.0, 1.0)
        }
        if anatomy.regions[index] == FIGURE_SASH && painter.hang[index] == 0.0 {
            painter.waist = FigureAdd(painter.waist, anatomy.positions[index])
            sash += 1.0
        }
    }
    if sash == 0.0 {
        return false
    }
    painter.waist = FigureScale(painter.waist, 1.0 / sash)
    VecClear(painter.ends)
    VecClear(painter.rest)
    for at: first[1]..first[FIGURE_REGIONS] - 1 {
        if FigureKind(anatomy.regions[indices[at]]) == FIGURE_SHADE_CLOTH {
            a := indices[at]
            b := indices[ifx at % 3 == 2 then at - 2 else at + 1]
            length := FigureDistance(anatomy.positions[a], anatomy.positions[b])
            if !VecPush(painter.ends, a) || !VecPush(painter.ends, b) || !VecPush(painter.rest, length) {
                return false
            }
            painter.around[a] += length
            painter.around[b] += length
        }
    }
    painter.ready = true
    return true
}

// REGION's samplers: paper, pigment, its painted texture and the face.
FigureBind :: (painter: *FigurePainter, media: *FigureMedia, region: s32) {
    texture := *media.textures[region]
    face := *media.textures[FIGURE_FACE]
    painter.samplers[region][0] = .{width = media.paper.width, height = media.paper.height,
        pixels = media.paper.pixels[:], repeat = true}
    painter.samplers[region][1] = .{width = media.pigment.width, height = media.pigment.height,
        pixels = media.pigment.pixels[:], repeat = true}
    painter.samplers[region][2] = .{width = texture.width, height = texture.height, pixels = texture.pixels[:],
        repeat = true}
    painter.samplers[region][3] = .{width = face.width, height = face.height, pixels = face.pixels[:]}
    for slot: 0..8 {
        painter.uniforms[region][slot] = .{1.0, 1.0, 1.0, 1.0}
    }
}
