// Paints a practice figure: the petite young woman (the default) or the
// young man, each with clean texture maps on UVs that follow the form and a
// face map over the face (figure_shader). Kryon's standard material lights
// them like a sculpture in a soft studio: a warm key light that casts soft
// shadows, a cool fill, a rim light behind and a sky and ground. Normals
// are recomputed from the posed surface every frame, so bent joints and
// swinging cloth shade smoothly. A soft contact shadow lies under her feet.
// The caller owns the clock, the pose and where the picture goes; the result
// is straight RGBA in painter.pixels with a transparent background.
#import "figure_math"
#import "figure_anatomy"
#import "figure_joints"
#import "figure_skin"
#import "figure_shader"
#import "figure_finish"
#import "kryon/scene"
#import "kryon/scene_skin"
#import "kryon/scene_render"
#import "kryon/scene_gpu"
#import "kryon/shader"
#import "kryon/image_pixels"
#import "std/file"
#import "std/math"
#import "std/vec"
Raster :: #import "std/image";
Timer :: #import "std/timer_linux";

// The characters, each in its own folder of the figure media.
FIGURE_FEMALE :: 0
FIGURE_MALE :: 1
FIGURE_CHARACTERS :: 2

FigureCharacterName :: (character: s32) -> string {
    return ifx character == FIGURE_MALE then "male" else "female"
}

// An orthographic camera turned YAW about the vertical (0 looks at her
// front) and PITCH above the horizon, showing HEIGHT metres around CENTER.
FigureView :: struct {
    yaw: float64
    pitch: float64
    height: float64
    center: Vector3
}

FigureStyle :: struct {
    // Colour strength: 0 grey, 0.5 as the texture maps are, 1 twice as
    // vivid.
    colour: float64
    // A glowing translucent double: pale, lit blue from behind.
    luminous: bool
    opacity: float64
    // Her shadows: on herself from the key light, and under her feet.
    shadow: bool
}

FigureStyleDefault :: () -> FigureStyle {
    return .{colour = 0.6, opacity = 1.0, shadow = true}
}

// How many times more vivid than painted STYLE makes the colours.
FigureVivid :: (style: FigureStyle) -> float64 {
    return FigureClamp(style.colour, 0.0, 1.0) * 2.0
}

// Moves the whole body rigidly, for an astral double rising or rolling out
// of the physical one: OFFSET, then ROLL radians about the pelvis-height
// PIVOT in the picture plane.
FigureEffect :: struct {
    offset: Vector3
    pivot: Vector3
    roll: float64
}

// The texture maps: one per region, then the face.
FIGURE_FACE :: 5
FIGURE_TEXTURES :: 6

FigureMedia :: struct {
    anatomy: FigureAnatomy
    textures: [FIGURE_TEXTURES]Raster.Image
}

FigureMediaRelease :: (media: *FigureMedia) {
    FigureAnatomyRelease(*media.anatomy)
    for index: 0..FIGURE_TEXTURES - 1 {
        FigureImageRelease(*media.textures[index])
    }
}

// DIRECTORY (practices' shared/figure) holds a folder for each character
// with its anatomy.bin and texture maps. Anything missing or invalid gives
// empty media.
FigureMediaLoad :: (directory: string, character: s32) -> FigureMedia {
    media: FigureMedia
    folder: [1024]u8
    path: [1100]u8
    named := FigurePath(folder[:], directory, ifx character == FIGURE_MALE then "/male" else "/female")
    bytes, found := ReadEntireFile(FigurePath(path[:], named, "/anatomy.bin"))
    if named.count > 0 && found && FigureAnatomyRead(*media.anatomy, bytes) {
        for index: cast(s32)0..FIGURE_TEXTURES - 1 {
            loaded := LoadImagePixels(FigurePath(path[:], named, FigureTextureName(index)))
            FigureImageTake(*media.textures[index], *loaded)
        }
    }
    if !FigureMediaReady(*media) {
        FigureMediaRelease(*media)
    }
    return media
}

FigureMediaReady :: (media: *FigureMedia) -> bool {
    ready := media.anatomy.bones.count > 0
    for index: 0..FIGURE_TEXTURES - 1 {
        ready = ready && Raster.ImageValid(*media.textures[index])
    }
    return ready
}

FigureTextureName :: (index: s32) -> string {
    names: [FIGURE_TEXTURES]string = .["/skin.webp", "/top.webp", "/trousers.webp", "/hair.webp", "/trim.webp",
        "/face.webp"]
    return names[index]
}

// Milliseconds the last picture spent in each step, for profiling.
FigureTimes :: struct {
    pose: float64
    skin: float64
    cloth: float64
    render: float64
    finish: float64
    shadow: float64
}

// The lights, in the order they are added to the scene.
FIGURE_KEY :: 0
FIGURE_FILL :: 1
FIGURE_RIM :: 2

FigurePainter :: struct {
    scene: Scene
    // One skinned surface; each region is its own node drawing that
    // region's triangles of it with its own material.
    skin: SceneSkin
    nodes: [FIGURE_REGIONS]s32
    blend: FigureSkin
    poses: Vec(FigureBonePose)
    gpu: SceneGpuContext
    programs: [3]ShaderProgram
    uniforms: [FIGURE_REGIONS][FIGURE_SHADER_UNIFORMS]ShaderValue
    samplers: [FIGURE_REGIONS][FIGURE_SHADER_SAMPLERS]ShaderSampler
    // Each vertex's first vertex at the same place at rest, so normals are
    // smooth across hems and texture seams, and the normals summed there.
    weld: Vec(s32)
    summed: Vec(Vector3)
    // How freely each cloth vertex hangs from the waist, and the waist's
    // middle at rest; only a jacket with a skirt hangs.
    hang: Vec(float64)
    waist: Vector3
    hanging: bool
    pixels: Raster.Image
    // The contact shadow: an ellipse on the floor under her.
    shadow_center: Vector3
    shadow_radii: Vector3
    ready: bool
    times: FigureTimes
    // Whether the last picture came from the GPU, and why not, for the
    // caller's status.
    accelerated: bool
    diagnostic: string
}

FigurePainterRelease :: (painter: *FigurePainter) {
    SceneSkinRelease(*painter.skin)
    VecFree(painter.weld)
    VecFree(painter.summed)
    VecFree(painter.hang)
    SceneFree(*painter.scene)
    FigureSkinRelease(*painter.blend)
    VecFree(painter.poses)
    SceneGpuRelease(*painter.gpu)
    for kind: 0..2 {
        ShaderFree(*painter.programs[kind])
    }
    FigureImageRelease(*painter.pixels)
    painter.ready = false
}

// Draws the figure at JOINTS into a WIDTH by HEIGHT picture with a
// transparent background.
FigurePaint :: (painter: *FigurePainter, media: *FigureMedia, joints: *FigureJoints,
    view: FigureView, style: FigureStyle, effect: FigureEffect, width: s32, height: s32) -> bool {
    if width < 1 || height < 1 || width > 4096 || height > 4096 || !FigureMediaReady(media) ||
    !Finite64(style.opacity) || style.opacity <= 0.0 || style.opacity > 1.0 || !Finite64(style.colour) ||
    !Finite64(view.height) || view.height <= 0.0 || !Finite64(effect.roll) {
        return false
    }
    if !painter.ready && !FigurePainterPrepare(painter, media) {
        return false
    }
    clock := Timer.MonotonicNanoseconds()
    if !FigurePose(*media.anatomy, joints, *painter.poses) {
        return false
    }
    painter.times.pose = FigureLap(*clock)
    if !FigureSkinDeform(*painter.scene, *painter.skin, *painter.blend, painter.poses[:]) {
        return false
    }
    painter.times.skin = FigureLap(*clock)
    if painter.hanging {
        FigureHang(painter)
    }
    FigureNormals(painter, *media.anatomy)
    painter.times.cloth = FigureLap(*clock)
    cosine := Cos(effect.roll)
    sine := Sin(effect.roll)
    for region: cast(s32)0..FIGURE_REGIONS - 1 {
        node := painter.nodes[region]
        SetRotation(*painter.scene, node, 0.0, 0.0, effect.roll)
        SetPosition(*painter.scene, node,
            effect.offset.x + effect.pivot.x - cosine * effect.pivot.x + sine * effect.pivot.y,
            effect.offset.y + effect.pivot.y - sine * effect.pivot.x - cosine * effect.pivot.y,
            effect.offset.z)
        // A translucent double is painted opaque and faded as a whole, so
        // its cloth and body do not build up where they overlap.
        material := painter.scene.meshes[painter.scene.nodes[node].mesh].material
        material.glow = .{90, 160, 255, 255}
        material.glow_strength = ifx style.luminous then 0.35 else 0.0
        SetMaterial(*painter.scene, node, material)
        SetShadows(*painter.scene, node, style.shadow && !style.luminous, style.shadow && !style.luminous)
    }
    toward := FigureV3(Sin(view.yaw) * Cos(view.pitch), Sin(view.pitch), Cos(view.yaw) * Cos(view.pitch))
    half_height := view.height / 2.0
    half_width := half_height * cast(float64)width / cast(float64)height
    camera := OrthographicCamera(-half_width, half_width, half_height, -half_height, 0.05, 30.0)
    camera.target = view.center
    camera.position = FigureAddScaled(view.center, toward, 8.0)
    camera.up = FigureV3(0.0, 1.0, 0.0)
    if FigureAbs(Sin(view.pitch)) > 0.98 {
        camera.up = FigureV3(-Sin(view.yaw), 0.0, -Cos(view.yaw))
    }
    FigureLights(painter, view, style)
    vivid := FigureVivid(style)
    for region: 0..FIGURE_REGIONS - 1 {
        uniforms := painter.uniforms[region][:]
        uniforms[0] = .{1.0, 1.0, 0.0, 0.0}
        uniforms[1] = .{vivid, vivid, vivid, vivid}
        uniforms[2] = ifx style.luminous then ShaderValue.{0.80, 0.90, 1.0, 0.55} else ShaderValue.{0.0, 0.0, 0.0, 0.0}
    }
    if !FigureImageSize(*painter.pixels, width, height) {
        return false
    }
    unused FigureLap(*clock)
    result := SceneGpuRenderOrCPU(*painter.gpu, *painter.scene, camera, *painter.pixels)
    painter.accelerated = result.accelerated
    painter.diagnostic = result.diagnostic
    if !result.ok {
        return false
    }
    painter.times.render = FigureLap(*clock)
    if style.opacity < 1.0 {
        for index: 0..cast(s64)width * height - 1 {
            alpha := cast(float64)painter.pixels.pixels[index * 4 + 3] * style.opacity
            painter.pixels.pixels[index * 4 + 3] = cast(u8)(alpha + 0.5)
        }
    }
    painter.times.finish = FigureLap(*clock)
    if style.shadow && !style.luminous {
        FigureShadow(painter, joints)
        FigureShadowUnder(painter, camera, view)
    }
    painter.times.shadow = FigureLap(*clock)
    return true
}

// Milliseconds since CLOCK, which moves on to now.
FigureLap :: (clock: *s64) -> float64 {
    now := Timer.MonotonicNanoseconds()
    spent := cast(float64)(now - clock.*) / 1000000.0
    clock.* = now
    return spent
}

FigureLinear :: (value: u32) -> Vector3 {
    return .{FigureChannel((value >> 16) & 255), FigureChannel((value >> 8) & 255), FigureChannel(value & 255)}
}

#scope_file
FigureKind :: (region: s32) -> s32 {
    if region == FIGURE_SKIN {
        return FIGURE_SHADE_SKIN
    }
    return ifx region == FIGURE_HAIR then FIGURE_SHADE_HAIR else FIGURE_SHADE_CLOTH
}

// How rough each region's surface is: soft matte skin, a soft sheen on the
// clothes and a little more on the hair.
FigureRoughness :: (region: s32) -> float64 {
    roughness: [FIGURE_REGIONS]float64 = .[0.58, 0.62, 0.72, 0.64, 0.58]
    return roughness[region]
}

FigureImageTake :: (to: *Raster.Image, from: *Raster.Image) {
    VecSwap(to.pixels, from.pixels)
    to.width = from.width
    to.height = from.height
    FigureImageRelease(from)
}

FigureImageRelease :: (image: *Raster.Image) {
    VecFree(image.pixels)
    image.width = 0
    image.height = 0
}

FigureImageSize :: (image: *Raster.Image, width: s32, height: s32) -> bool {
    if image.width == width && image.height == height {
        return true
    }
    if !VecResize(image.pixels, cast(s64)width * height * 4) {
        return false
    }
    image.width = width
    image.height = height
    return true
}

// The studio lights turn with the camera, so she is lit the same from every
// side: the key from above her front left, the fill low from the right, the
// rim from behind on the right, under a pale sky over warm ground. A glowing
// double is lit cool and bright from behind.
FigureLights :: (painter: *FigurePainter, view: FigureView, style: FigureStyle) {
    scene := *painter.scene
    turn := FigureAxisAngle(FigureV3(0.0, 1.0, 0.0), view.yaw)
    places: [3]Vector3 = .[FigureV3(-0.42, 0.78, 0.47), FigureV3(0.72, 0.22, 0.66), FigureV3(0.40, 0.52, -0.75)]
    for light: 0..2 {
        scene.lights[light].target = view.center
        scene.lights[light].position = FigureAddScaled(view.center, FigureRotate(turn, FigureNormalize(places[light])), 6.0)
    }
    scene.lights[FIGURE_KEY].shadow = style.shadow && !style.luminous
    scene.lights[FIGURE_KEY].intensity = ifx style.luminous then 1.4 else 2.6
    scene.lights[FIGURE_FILL].intensity = 0.85
    scene.lights[FIGURE_RIM].intensity = ifx style.luminous then 3.2 else 1.7
    scene.lights[FIGURE_RIM].color = .{238, 244, 255, 255}
    if style.luminous {
        scene.lights[FIGURE_RIM].color = .{150, 200, 255, 255}
    }
    if style.luminous {
        AddHemisphereLight(scene, .{200, 225, 255, 255}, .{150, 170, 220, 255}, 1.8)
    } else {
        AddHemisphereLight(scene, .{222, 231, 247, 255}, .{205, 182, 162, 255}, 1.45)
    }
}

// Each vertex's normal from the posed surface: the area-weighted normals of
// the triangles about it, shared by every vertex at the same place at rest.
FigureNormals :: (painter: *FigurePainter, anatomy: *FigureAnatomy) {
    scene := *painter.scene
    first := scene.meshes[scene.nodes[painter.skin.node].mesh].first_vertex
    for index: 0..painter.summed.count - 1 {
        painter.summed[index] = .{}
    }
    triangles := anatomy.indices.count / 3
    for triangle: 0..triangles - 1 {
        a := anatomy.indices[triangle * 3]
        b := anatomy.indices[triangle * 3 + 1]
        c := anatomy.indices[triangle * 3 + 2]
        pa := scene.positions[first + a]
        normal := FigureCross(FigureSub(scene.positions[first + b], pa), FigureSub(scene.positions[first + c], pa))
        wa := painter.weld[a]
        wb := painter.weld[b]
        wc := painter.weld[c]
        painter.summed[wa] = FigureAdd(painter.summed[wa], normal)
        painter.summed[wb] = FigureAdd(painter.summed[wb], normal)
        painter.summed[wc] = FigureAdd(painter.summed[wc], normal)
    }
    for index: 0..painter.weld.count - 1 {
        summed := painter.summed[painter.weld[index]]
        length := Sqrt(FigureDot(summed, summed))
        if length > 0.000000000001 {
            scene.normals[first + index] = FigureScale(summed, 1.0 / length)
        }
    }
    scene.geometry_frozen = false
}

// Every vertex's first vertex at the same place at rest, found through a
// hash of the place to a tenth of a millimetre.
FigureWeld :: (painter: *FigurePainter, anatomy: *FigureAnatomy) -> bool {
    count := anatomy.positions.count
    size: s64 = 1
    while size < count * 2 {
        size *= 2
    }
    table: Vec(s32)
    defer VecFree(table)
    if !VecResize(table, size) || !VecResize(painter.weld, count) || !VecResize(painter.summed, count) {
        return false
    }
    for slot: 0..size - 1 {
        table[slot] = -1
    }
    for index: 0..count - 1 {
        point := anatomy.positions[index]
        qx := RoundToInteger(point.x * 10000.0)
        qy := RoundToInteger(point.y * 10000.0)
        qz := RoundToInteger(point.z * 10000.0)
        hash := (cast(u64)qx * 73856093) ^ (cast(u64)qy * 19349663) ^ (cast(u64)qz * 83492791)
        slot := cast(s64)(hash & cast(u64)(size - 1))
        painter.weld[index] = cast(s32)index
        while table[slot] >= 0 {
            other := anatomy.positions[table[slot]]
            if RoundToInteger(other.x * 10000.0) == qx && RoundToInteger(other.y * 10000.0) == qy &&
            RoundToInteger(other.z * 10000.0) == qz {
                painter.weld[index] = table[slot]
                break
            }
            slot = (slot + 1) & (size - 1)
        }
        if painter.weld[index] == cast(s32)index {
            table[slot] = cast(s32)index
        }
    }
    return true
}

// The jacket's skirt hangs towards the ground: when his pelvis tips, as in
// a fold, a plank or downward dog, it swings about the waist from where the
// pelvis carries it towards straight down, the more the nearer the hem.
FigureHang :: (painter: *FigurePainter) {
    scene := *painter.scene
    pelvis := painter.poses[0]
    down := FigureV3(0.0, -1.0, 0.0)
    carried := FigureRotate(pelvis.turn, down)
    if FigureDot(carried, down) > 0.995 {
        return
    }
    swing := FigureSwing(carried, down)
    // How far it swings, 0 upright to 1 upside down.
    tipped := (1.0 - FigureDot(carried, down)) * 0.5
    pivot := FigureBonePoint(pelvis, painter.waist)
    first := scene.meshes[scene.nodes[painter.skin.node].mesh].first_vertex
    for index: 0..painter.hang.count - 1 {
        hang := painter.hang[index]
        if hang <= 0.0 {
            continue
        }
        turn := FigureBlend(FigureIdentity(), swing, hang * 0.85)
        at := first + index
        offset := FigureRotate(turn, FigureSub(scene.positions[at], pivot))
        // Swung over his back it lies closer on him than it hung from the
        // hips.
        axis := FigureRotate(turn, carried)
        along := FigureDot(offset, axis)
        across := FigureAddScaled(offset, axis, -along)
        offset = FigureAddScaled(FigureScale(across, 1.0 - 0.6 * tipped * hang), axis, along)
        scene.positions[at] = FigureAdd(pivot, offset)
    }
}

// Spreads the shadow under the joints that rest lowest: the feet when
// standing, the whole length when lying down, on the floor under the lowest
// point of the posed surface.
FigureShadow :: (painter: *FigurePainter, joints: *FigureJoints) {
    points: [9]Vector3 = .[joints.pelvis, joints.ankles[0], joints.ankles[1], joints.toes[0],
        joints.toes[1], joints.wrists[0], joints.wrists[1], joints.neck, joints.knees[0]]
    floor: float64 = 1000.0
    for point: points {
        floor = FigureMin(floor, point.y)
    }
    low: Vector3 = .{1000.0, 0.0, 1000.0}
    high: Vector3 = .{-1000.0, 0.0, -1000.0}
    for point: points {
        // Only what is near the floor casts onto it.
        if point.y < floor + 0.35 {
            low = .{FigureMin(low.x, point.x), 0.0, FigureMin(low.z, point.z)}
            high = .{FigureMax(high.x, point.x), 0.0, FigureMax(high.z, point.z)}
        }
    }
    scene := *painter.scene
    first := scene.meshes[scene.nodes[painter.skin.node].mesh].first_vertex
    lowest: float64 = 1000.0
    for index: 0..painter.weld.count - 1 {
        lowest = FigureMin(lowest, scene.positions[first + index].y)
    }
    painter.shadow_center = .{(low.x + high.x) * 0.5, lowest, (low.z + high.z) * 0.5}
    painter.shadow_radii = .{(high.x - low.x) * 0.5 + 0.22, 0.0, (high.z - low.z) * 0.5 + 0.18}
}

FigurePixel :: (point: Vector3, camera: SceneCamera, right: Vector3, up: Vector3, scale: float64,
    image: *Raster.Image) -> ShapePoint {
    offset := FigureSub(point, camera.target)
    return .{cast(float64)image.width * 0.5 + FigureDot(offset, right) * scale,
        cast(float64)image.height * 0.5 - FigureDot(offset, up) * scale}
}

// Lays the contact shadow under the finished picture. The floor ellipse
// projects to an ellipse in the picture.
FigureShadowUnder :: (painter: *FigurePainter, camera: SceneCamera, view: FigureView) {
    look := FigureNormalize(FigureSub(camera.target, camera.position))
    if FigureAbs(look.y) < 0.03 {
        return
    }
    right := FigureNormalize(FigureCross(look, camera.up))
    up := FigureCross(right, look)
    image := *painter.pixels
    scale := cast(float64)image.height / view.height
    center := painter.shadow_center
    // The floor point centre + s X + t Z lands at pixel origin + s A + t B.
    origin := FigurePixel(center, camera, right, up, scale, image)
    a := FigurePixel(FigureAdd(center, FigureV3(painter.shadow_radii.x, 0.0, 0.0)), camera, right, up, scale, image)
    b := FigurePixel(FigureAdd(center, FigureV3(0.0, 0.0, painter.shadow_radii.z)), camera, right, up, scale, image)
    ax := a.x - origin.x
    ay := a.y - origin.y
    bx := b.x - origin.x
    by := b.y - origin.y
    det := ax * by - bx * ay
    if FigureAbs(det) < 0.5 {
        return
    }
    spot: FigureSpot = .{origin = origin, xx = by / det, xy = -bx / det, yx = -ay / det, yy = ax / det}
    FigureContactShadow(image, spot, 0.42)
}

FigurePath :: (buffer: []u8, directory: string, name: string) -> string {
    if directory.count + name.count > buffer.count {
        return ""
    }
    for index: 0..directory.count - 1 {
        buffer[index] = directory[index]
    }
    for index: 0..name.count - 1 {
        buffer[directory.count + index] = name[index]
    }
    return TextView(buffer[0:directory.count + name.count])
}

FigureChannel :: (channel: u32) -> float64 {
    value := cast(float64)channel / 255.0
    if value <= 0.04045 {
        return value / 12.92
    }
    return Pow((value + 0.055) / 1.055, 2.4)
}

FigurePainterPrepare :: (painter: *FigurePainter, media: *FigureMedia) -> bool {
    for kind: 0..2 {
        if !FigureSurfaceCompile(*painter.programs[kind], cast(s32)kind).ok {
            return false
        }
    }
    SceneInit(*painter.scene)
    painter.scene.background = .{0, 0, 0, 0}
    painter.scene.tone_mapping = true
    // Key, fill and rim, placed each frame; the key casts soft shadows over
    // a box round her.
    key := AddDirectionalLight(*painter.scene, .{255, 243, 228, 255}, 2.6, .{0.0, 1.0, 0.0})
    unused AddDirectionalLight(*painter.scene, .{208, 222, 255, 255}, 0.85, .{1.0, 0.0, 0.0})
    unused AddDirectionalLight(*painter.scene, .{238, 244, 255, 255}, 1.7, .{0.0, 0.0, -1.0})
    CastLightShadow(*painter.scene, key, 1.25, 1.25, 0.5, 12.0, 2048, -0.0004, 0.012, 1.4)
    anatomy := *media.anatomy
    // The triangles grouped by region, each region's run starting at FIRST.
    indices: Vec(s32)
    defer VecFree(indices)
    first: [FIGURE_REGIONS + 1]s32
    for region: cast(s32)0..FIGURE_REGIONS - 1 {
        first[region] = cast(s32)indices.count
        for triangle: 0..anatomy.indices.count / 3 - 1 {
            if anatomy.regions[anatomy.indices[triangle * 3]] == region {
                for corner: 0..2 {
                    if !VecPush(indices, anatomy.indices[triangle * 3 + corner]) {
                        return false
                    }
                }
            }
        }
        FigureBind(painter, media, region)
    }
    first[FIGURE_REGIONS] = cast(s32)indices.count
    material := LitMaterial(.{255, 255, 255, 255}, FigureRoughness(FIGURE_SKIN), 0.0)
    material.vertex_colors = true
    material.shader = *painter.programs[FIGURE_SHADE_SKIN]
    material.shader_uniforms = painter.uniforms[FIGURE_SKIN][:]
    material.shader_samplers = painter.samplers[FIGURE_SKIN][:]
    if !SceneSkinCreate(*painter.scene, *painter.skin, cast(s32)anatomy.bones.count, anatomy.positions[:],
        anatomy.normals[:], anatomy.uvs[:], indices[:], anatomy.influences[:], material) {
        return false
    }
    // Every region draws its own run of the one surface, so one skin and one
    // deformation serve them all.
    scene := *painter.scene
    node := scene.nodes[painter.skin.node]
    mesh := scene.meshes[node.mesh]
    if mesh.first_vertex != 0 {
        return false
    }
    painter.nodes[FIGURE_SKIN] = painter.skin.node
    scene.meshes[node.mesh].index_count = first[1] - first[0]
    for region: cast(s32)1..FIGURE_REGIONS - 1 {
        run := mesh
        run.first_index = mesh.first_index + first[region]
        run.index_count = first[region + 1] - first[region]
        run.material.roughness = FigureRoughness(region)
        run.material.double_sided = region != FIGURE_HAIR
        run.material.shader = *painter.programs[FigureKind(region)]
        run.material.shader_uniforms = painter.uniforms[region][:]
        run.material.shader_samplers = painter.samplers[region][:]
        holder := node
        holder.mesh = cast(s32)scene.meshes.count
        painter.nodes[region] = cast(s32)scene.nodes.count
        if run.index_count == 0 || !VecPush(scene.meshes, run) || !VecPush(scene.nodes, holder) {
            return false
        }
    }
    // The skin's vertex data is where the face map lies and how much of it
    // shows; the hair's how far it fades into the skin at the hairline.
    for index: 0..anatomy.positions.count - 1 {
        detail := anatomy.details[index]
        region := anatomy.regions[index]
        scene.colors[index] = .{}
        if region == FIGURE_SKIN {
            scene.colors[index] = .{detail.x, detail.y, anatomy.faces[index]}
        } else if region == FIGURE_HAIR {
            scene.colors[index] = .{FigureClamp(detail.x, 0.0, 1.0), 0.0, 0.0}
        }
    }
    scene.geometry_frozen = false
    if !FigureWeld(painter, anatomy) {
        return false
    }
    // How freely the cloth hangs: the waist's middle is the middle of the
    // skirt's top rows, all round him.
    count := anatomy.positions.count
    if !VecResize(painter.hang, count) {
        return false
    }
    ring: float64
    painter.waist = .{}
    for index: 0..count - 1 {
        painter.hang[index] = 0.0
        if anatomy.regions[index] != FIGURE_SKIN && anatomy.regions[index] != FIGURE_HAIR {
            painter.hang[index] = FigureClamp(anatomy.details[index].x, 0.0, 1.0)
        }
        if anatomy.regions[index] == FIGURE_TOP && painter.hang[index] > 0.0 && painter.hang[index] <= 0.2 {
            painter.waist = FigureAdd(painter.waist, anatomy.positions[index])
            ring += 1.0
        }
    }
    painter.hanging = ring > 0.0
    if painter.hanging {
        painter.waist = FigureScale(painter.waist, 1.0 / ring)
    }
    painter.ready = true
    return true
}

// REGION's samplers: its texture map and the face.
FigureBind :: (painter: *FigurePainter, media: *FigureMedia, region: s32) {
    texture := *media.textures[region]
    face := *media.textures[FIGURE_FACE]
    painter.samplers[region][0] = .{width = texture.width, height = texture.height, pixels = texture.pixels[:],
        repeat = true}
    painter.samplers[region][1] = .{width = face.width, height = face.height, pixels = face.pixels[:]}
    for slot: 0..FIGURE_SHADER_UNIFORMS - 1 {
        painter.uniforms[region][slot] = .{1.0, 1.0, 1.0, 1.0}
    }
    // The skin map is one flat colour: its first texel, in linear light as
    // the shader squares it.
    skin := *media.textures[FIGURE_SKIN]
    if skin.pixels.count >= 4 {
        r := cast(float64)skin.pixels[0] / 255.0
        g := cast(float64)skin.pixels[1] / 255.0
        b := cast(float64)skin.pixels[2] / 255.0
        painter.uniforms[region][3] = .{r * r, g * g, b * b, 1.0}
    }
}
