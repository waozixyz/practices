// The figure's surface colour. Each region's clean texture map is sampled
// on UVs that wrap the body, the face map lies over the face, and the
// colours are made as vivid as the style asks. Kryon's standard material
// then lights the result: soft studio key, fill and rim lights over a sky
// and ground, its own soft shadows, and a gentle sheen.
//
// Registers: 0 vertex data, 1 position, 2 normal, 3 UV. On the skin the
// vertex data is where the face map lies and how much of it shows; on the
// hair, how far it fades into the skin at the hairline.
// Uniforms: 0 UV repeat, 1 colour strength (1 as painted), 2 a glowing
// double's pale tint and, in its alpha, how far the colours move to it, 3
// the skin's colour in linear light.
// Samplers: 0 the region's texture map, 1 the face.
#import "kryon/shader"

FIGURE_SHADE_SKIN :: 0
FIGURE_SHADE_CLOTH :: 1
FIGURE_SHADE_HAIR :: 2

FIGURE_SHADER_UNIFORMS :: 4
FIGURE_SHADER_SAMPLERS :: 2

FigureSurfaceCompile :: (program: *ShaderProgram, kind: s32) -> ShaderDiagnostic {
    code: FigureCode
    // The texture map, in linear light.
    FigureSlot(*code, .ShaderUniform, 4, 0, 0)
    FigureOp(*code, .ShaderMultiply, 5, 3, 4)
    FigureSlot(*code, .ShaderSample, 6, 5, 0)
    FigureOp(*code, .ShaderMultiply, 6, 6, 6)
    if kind == FIGURE_SHADE_SKIN {
        FigureSlot(*code, .ShaderSample, 7, 0, 1)
        FigureOp(*code, .ShaderMultiply, 7, 7, 7)
        FigureLiteral(*code, 8, 0.0, 0.0, 1.0, 0.0)
        FigureOp(*code, .ShaderDot, 8, 0, 8)
        FigureMix(*code, 6, 6, 7, 8)
    }
    if kind == FIGURE_SHADE_HAIR {
        // A soft hairline instead of a hard edge.
        FigureSlot(*code, .ShaderUniform, 7, 0, 3)
        FigureLiteral(*code, 8, 0.85, 0.0, 0.0, 0.0)
        FigureOp(*code, .ShaderDot, 8, 0, 8)
        FigureMix(*code, 6, 6, 7, 8)
    }
    // Colour strength: away from the grey of the same brightness.
    FigureLiteral(*code, 9, 0.2126, 0.7152, 0.0722, 0.0)
    FigureOp(*code, .ShaderDot, 9, 6, 9)
    FigureSlot(*code, .ShaderUniform, 10, 0, 1)
    FigureMix(*code, 6, 9, 6, 10)
    FigureLiteral(*code, 11, 0.0, 0.0, 0.0, 0.0)
    FigureOp(*code, .ShaderMax, 6, 6, 11)
    // A glowing double's pale colours.
    FigureSlot(*code, .ShaderUniform, 12, 0, 2)
    FigureLiteral(*code, 13, 0.0, 0.0, 0.0, 1.0)
    FigureOp(*code, .ShaderDot, 14, 12, 13)
    FigureLiteral(*code, 15, 1.0, 1.0, 1.0, 0.0)
    FigureOp(*code, .ShaderMultiply, 14, 14, 15)
    FigureMix(*code, 6, 6, 12, 14)
    // Opaque: the material fades a translucent double as a whole.
    FigureLiteral(*code, 16, 0.0, 0.0, 0.0, 1.0)
    FigureMix(*code, 6, 6, 16, 16)
    FigureSlot(*code, .ShaderOutput, 0, 6, 0)
    return ShaderCompile(program, code.code[0:code.count])
}

#scope_file
FigureCode :: struct {
    code: [64]ShaderInstruction
    count: s32
}

FigureOp :: (code: *FigureCode, op: ShaderOp, dest: s32, a: s32, b: s32) {
    code.code[code.count] = .{op = op, dest = dest, a = a, b = b}
    code.count += 1
}

FigureMix :: (code: *FigureCode, dest: s32, a: s32, b: s32, t: s32) {
    code.code[code.count] = .{op = .ShaderMix, dest = dest, a = a, b = b, c = t}
    code.count += 1
}

FigureSlot :: (code: *FigureCode, op: ShaderOp, dest: s32, a: s32, slot: s32) {
    code.code[code.count] = .{op = op, dest = dest, a = a, slot = slot}
    code.count += 1
}

FigureLiteral :: (code: *FigureCode, dest: s32, x: float64, y: float64, z: float64, w: float64) {
    code.code[code.count] = .{op = .ShaderLiteral, dest = dest, value = .{x, y, z, w}}
    code.count += 1
}
