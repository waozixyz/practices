// Small deterministic cloth constraints for the meditation skirt. The upper
// edge follows the fitted garment skin; the hem hangs under gravity instead
// of rotating over the head with a forward-folded pelvis. Leg capsules and
// the real floor keep the cloth outside the body. There is no free-running
// simulation or seek-dependent state.
#import "figure_math"
#import "std/math"
#import "kryon/scene"

FigureClothOutside :: (point: Vector3, from: Vector3, to: Vector3, radius: float64, fallback: Vector3) -> Vector3 {
    segment := FigureSub(to, from)
    length := FigureDot(segment, segment)
    along := ifx length > 0.000000001 then FigureClamp(FigureDot(FigureSub(point, from), segment) / length, 0.0, 1.0) else 0.0
    center := FigureAddScaled(from, segment, along)
    delta := FigureSub(point, center)
    distance := FigureLength(delta)
    if distance >= radius {
        return point
    }
    if distance < 0.000001 {
        delta = FigureNormalize(fallback)
    } else {
        delta = FigureScale(delta, 1.0 / distance)
    }
    return FigureAddScaled(center, delta, radius)
}

FigureClothHang :: (skinned: Vector3, rest: Vector3, rest_hips: Vector3, hips: Vector3,
    facing: FigureQuat, yaw: float64, scale: float64,
    legward: Vector3 = .{}, flutter: float64 = 0.0) -> Vector3 {
    local := FigureSub(rest, rest_hips)
    depth := FigureMax(0.0, -local.y)
    // Preserve the waist seam and let the lower skirt settle continuously.
    loose := FigureSmooth(depth, 0.015, 0.19)
    lateral := FigureRotate(facing, .{local.x, 0.0, local.z})
    lateral = FigureRotate(FigureAxisAngle(.{0.0, 1.0, 0.0}, yaw), lateral)
    // Spread the loose panels as the legs open and the body leaves the floor.
    fullness := flutter * (0.8 + 0.2 * Sin(local.x * 20.0 + local.z * 12.0))
    lateral = FigureScale(lateral, 1.0 + 0.22 * fullness)
    fall := depth * scale * (1.0 - 0.15 * fullness)
    hanging := FigureAdd(hips, FigureScale(lateral, scale))
    hanging.y -= fall
    // Once the fabric reaches the floor, its remaining length lies toward
    // the legs. A prone figure cannot push the hem toward her supporting hands.
    clearance := FigureMax(hips.y - 0.006, 0.0)
    spare := FigureMax(fall - clearance, 0.0)
    hanging = FigureAddScaled(hanging, legward, spare * FigureSmooth(spare, 0.0, 0.12))
    return FigureLerp(skinned, hanging, loose)
}

// A raised thigh carries the panel above it. The weight comes from the
// panel's original direction around the waist, so crossing the cloth's
// surface cannot suddenly move the same panel to the other side of the leg.
FigureClothLift :: (point: Vector3, outward: Vector3, depth: float64, scale: float64,
    thighs: []Vector3) -> Vector3 {
    motion: Vector3
    coverage: float64
    for thigh: thighs {
        weight := FigureSmooth(FigureDot(thigh, outward), 0.08, 0.68)
        motion = FigureAddScaled(motion, FigureAdd(thigh, .{0.0, 1.0, 0.0}), weight)
        coverage += weight
    }
    loose := FigureSmooth(depth, 0.025, 0.19)
    return FigureAddScaled(point, motion, loose * depth * scale / FigureMax(1.0, coverage))
}

// The front waist tips down during a hinge, while a raised thigh carries the
// nearby panels in a lunge. Lift the fabric between the sewn waist and the hem.
FigureClothSeat :: (point: Vector3, outward: Vector3, depth: float64, scale: float64,
    thighs: []Vector3, forward: Vector3, pelvis_down: float64, thigh_lift: float64) -> Vector3 {
    seat := FigureSmooth(depth, 0.003, 0.055) * (1.0 - FigureSmooth(depth, 0.18, 0.30))
    if seat <= 0.0 { return point }
    folded := FigureSmooth(pelvis_down, -0.22, 0.28)
    bent := FigureSmooth(pelvis_down, -0.76, -0.27) * thigh_lift
    front := folded * FigureSmooth(FigureDot(outward, forward), -0.38, 0.55)
    raised := 0.0
    for thigh: thighs {
        over := FigureSmooth(thigh.y, -0.55, -0.05) * FigureSmooth(FigureDot(thigh, outward), -0.58, 0.22)
        raised = FigureMax(raised, over)
    }
    point.y += seat * scale * (0.245 * front + 0.225 * bent * (1.0 - folded) * raised)
    return FigureAddScaled(point, outward, seat * scale * 0.12 * front)
}
