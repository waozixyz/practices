// Regression checks on the selected VRM skeletons, after model retargeting.
#import "figure_math"
#import "figure_joints"
#import "figure_model"
#import "figure_cloth"
#import "std/byte_text_linux"
#import "kryon/scene"
#import "kryon/scene_gltf"
#import "std/math"
#import "std/vec"

ModelPoint :: (figure: *FigureModel, scene: *Scene, role: s32) -> Vector3 {
    world := figure.instance.node_world[figure.bones[role]]
    root := scene.nodes[figure.instance.root_node]
    return FigureAdd(root.position, FigureScale(FigureRotate(figure.facing,
        FigureV3(world.m[3], world.m[7], world.m[11])), root.scale.x))
}

ModelPose :: (phase: float64) -> FigureJoints {
    pose: FigureJoints
    pose.height = 1.65
    pose.pelvis = .{0.04 * Sin(phase), 0.82 + 0.025 * Cos(phase), 0.025 * Sin(phase)}
    pose.pelvis_turn = FigureIdentity()
    pose.chest_turn = FigureIdentity()
    pose.head_turn = FigureIdentity()
    pose.spine = FigureAdd(pose.pelvis, FigureV3(0.0, 0.12, 0.0))
    pose.chest = FigureAdd(pose.pelvis, FigureV3(0.0, 0.35, 0.0))
    pose.neck = FigureAdd(pose.pelvis, FigureV3(0.0, 0.55, 0.0))
    for side: cast(s32)0..1 {
        sign := ifx side == 0 then 1.0 else -1.0
        hip := FigureAdd(pose.pelvis, FigureV3(sign * 0.09, -0.04, 0.0))
        ankle := FigureV3(sign * 0.12, 0.08, 0.0)
        direction := FigureNormalize(FigureSub(ankle, hip))
        pole := FigureNormalize(FigureAddScaled(FigureV3(0.0, 0.0, 1.0), direction, -direction.z))
        half := FigureDistance(hip, ankle) * 0.5
        pose.hips[side] = hip
        pose.knees[side] = FigureAddScaled(FigureLerp(hip, ankle, 0.5), pole, Sqrt(0.16 - half * half))
        pose.ankles[side] = ankle
        pose.toes[side] = FigureAdd(ankle, FigureV3(0.0, -0.055, 0.14))
        pose.feet[side] = FigureIdentity()
        pose.shoulders[side] = FigureAdd(pose.chest, FigureV3(sign * 0.17, 0.02, 0.0))
        pose.elbows[side] = FigureAdd(pose.chest, FigureV3(sign * 0.32, -0.12, 0.05))
        pose.wrists[side] = FigureAdd(pose.chest, FigureV3(sign * 0.4, -0.25, 0.15))
        pose.hands[side] = FigureMultiply(FigureAxisAngle(FigureV3(0.0, 1.0, 0.0), phase),
            FigureAxisAngle(FigureV3(1.0, 0.0, 0.0), 0.35 * Sin(phase)))
    }
    return pose
}

ModelTurn :: (model: *FigureModel, role: s32) -> FigureQuat {
    return model.turn[model.bones[role]]
}

RotationDistance :: (a: FigureQuat, b: FigureQuat) -> float64 {
    return 2.0 * Acos(FigureClamp(FigureAbs(FigureQuatDot(a, b)), 0.0, 1.0))
}

ArmMotion :: (model: *FigureModel, scene: *Scene, path: string) -> bool {
    pose := ModelPose(0.0)
    side: s32 = 0
    shoulder := FigureSideRole(side, FIGURE_SHOULDER)
    forearm := FigureSideRole(side, FIGURE_LOWER_ARM)
    hand := FigureSideRole(side, FIGURE_HAND)
    pose.elbows[side] = FigureAdd(pose.shoulders[side], .{0.03, -0.22, 0.0})
    if !FigureModelPose(model, scene, *pose) {
        return false
    }
    resting := ModelTurn(model, shoulder)
    pose.elbows[side] = FigureAdd(pose.shoulders[side], .{0.13, 0.16, 0.17})
    pose.wrists[side] = FigureAdd(pose.shoulders[side], .{0.25, 0.22, 0.22})
    if !FigureModelPose(model, scene, *pose) {
        return false
    }
    shoulder_change := RotationDistance(resting, ModelTurn(model, shoulder))
    wrist := pose.wrists[side]
    axis := FigureNormalize(FigureSub(wrist, ModelPoint(model, scene, forearm)))
    initial := ModelTurn(model, forearm)
    previous := initial
    largest_step: float64
    largest_turn: float64
    for sample: 1..180 {
        angle := cast(float64)sample * 2.0 * FIGURE_PI / 180.0
        pose.hands[side] = FigureAxisAngle(axis, angle)
        if !FigureModelPose(model, scene, *pose) ||
        FigureDistance(ModelPoint(model, scene, hand), wrist) > 0.0001 {
            return false
        }
        elbow := ModelPoint(model, scene, forearm)
        if FigureDistance(FigureNormalize(FigureSub(wrist, elbow)), axis) > 0.0001 {
            return false
        }
        middle := ModelPoint(model, scene, FigureFingerRole(side, 2, 0))
        if FigureDistance(FigureNormalize(FigureSub(middle, wrist)),
            FigureRotate(pose.hands[side], .{0.0, -1.0, 0.0})) > 0.001 {
            return false
        }
        turn := ModelTurn(model, forearm)
        largest_step = FigureMax(largest_step, RotationDistance(previous, turn))
        largest_turn = FigureMax(largest_turn, RotationDistance(initial, turn))
        previous = turn
    }
    print("arm motion: % clavicle change % rad, largest forearm step % rad, maximum forearm turn % rad\n",
        path, shoulder_change, largest_step, largest_turn)
    return shoulder_change > 0.12 && shoulder_change < 0.24 && largest_step < 0.18 && largest_turn > 0.45
}

SleeveContact :: (model: *FigureModel, scene: *Scene) -> bool {
    pose := ModelPose(0.0)
    // Sweep a sleeve close to the front skirt panel during a low reach.
    min_gap: float64 = 1.0
    measured: s64
    for sample: 0..16 {
        pose.elbows[0] = .{0.20, 0.82, 0.22}
        pose.wrists[0] = .{0.18, 0.68, 0.21 + 0.05 * cast(float64)sample / 16.0}
        if !FigureModelPose(model, scene, *pose) { return false }
        elbow := ModelPoint(model, scene, FigureSideRole(0, FIGURE_LOWER_ARM))
        wrist := ModelPoint(model, scene, FigureSideRole(0, FIGURE_HAND))
        root := scene.nodes[model.instance.root_node]
        for index: 0..model.instance.meshes.count - 1 {
            inst := *model.instance.meshes[index]
            source := *model.model.meshes[inst.mesh_index]
            if TextView(source.name[:]) != "PracticeSkirt" { continue }
            mesh := scene.meshes[scene.nodes[inst.scene_node].mesh]
            rest_hips := model.rest_at[model.bones[FIGURE_HIPS]]
            radius := 0.062 * root.scale.x
            for vertex: 0..inst.skin.positions.count - 1 {
                if rest_hips.y - inst.skin.positions[vertex].y < 0.10 { continue }
                point := FigureAdd(root.position, FigureScale(FigureRotate(model.facing,
                    scene.positions[mesh.first_vertex + vertex]), root.scale.x))
                restored := FigureClothOutside(point, elbow, wrist, radius, .{1.0, 0.0, 0.0})
                gap := FigureDistance(restored, point)
                min_gap = FigureMin(min_gap, radius - gap)
                measured += 1
            }
        }
    }
    print("skirt/sleeve contact: % skirt vertices sampled, minimum sleeve radius clearance % m\n", measured, min_gap)
    return measured >= 17 * 100 && min_gap >= 0.060 * scene.nodes[model.instance.root_node].scale.x
}

// Intersect the posed skin ray with the actual cloth triangle. The contact
// solver applies a rest barycentric constraint, so this also catches sliding
// across its posed triangle and detects penetration between its vertices.
WrapSurfaceGap :: (scene: *Scene, contact: *FigureClothBinding, gap: *float64) -> bool {
    a := scene.positions[contact.vertices[0]]
    b := scene.positions[contact.vertices[1]]
    c := scene.positions[contact.vertices[2]]
    skin := scene.positions[contact.vertex]
    direction := scene.normals[contact.vertex]
    face := FigureNormalize(FigureCross(FigureSub(b, a), FigureSub(c, a)))
    alignment := FigureDot(face, direction)
    if alignment <= 0.35 { return false }
    distance := FigureDot(FigureSub(a, skin), face) / alignment
    point := FigureAddScaled(skin, direction, distance)
    if FigureDot(FigureCross(FigureSub(b, a), FigureSub(point, a)), face) < -0.00000001 ||
        FigureDot(FigureCross(FigureSub(c, b), FigureSub(point, b)), face) < -0.00000001 ||
        FigureDot(FigureCross(FigureSub(a, c), FigureSub(point, c)), face) < -0.00000001 {
        return false
    }
    <<gap = distance
    return true
}

SkirtFoldContact :: (model: *FigureModel, scene: *Scene) -> bool {
    if model.skirt_mesh < 0 || model.skirt_tunic < 0 { return false }
    skirt := *model.instance.meshes[model.skirt_mesh]
    tunic := *model.instance.meshes[model.skirt_tunic]
    skirt_first := scene.meshes[scene.nodes[skirt.scene_node].mesh].first_vertex
    tunic_first := scene.meshes[scene.nodes[tunic.scene_node].mesh].first_vertex
    rest_hips := model.rest_at[model.bones[FIGURE_HIPS]]
    hits: s64
    checked: s64
    worst_seam: float64
    worst_inside: float64
    wrap_hits: s64
    wrap_crossings: s64
    worst_crossing: float64
    sash_hits: s64
    sash_margin: float64 = 1.0
    for heading: 0..2 {
        yaw := FigureAxisAngle(.{0.0, 1.0, 0.0}, cast(float64)heading * 0.65)
        side := FigureRotate(yaw, .{1.0, 0.0, 0.0})
        for sample: 0..40 {
            amount := cast(float64)sample / 40.0
            pitch := FigureAxisAngle(.{1.0, 0.0, 0.0}, 1.92 * amount)
            pose := ModelPose(0.0)
            pose.pelvis.y -= 0.13 * amount
            pose.pelvis_turn = FigureMultiply(yaw, pitch)
            pose.chest_turn = pose.pelvis_turn
            for arm: cast(s32)0..1 {
                lateral := cast(float64)(1 - arm * 2)
                pose.elbows[arm] = FigureAdd(pose.pelvis, FigureRotate(pose.chest_turn, .{lateral * 0.26, 0.26, 0.10}))
                pose.wrists[arm] = FigureAdd(pose.pelvis, FigureRotate(pose.chest_turn, .{lateral * 0.25, 0.42, 0.18}))
            }
            if !FigureModelPose(model, scene, *pose) { return false }
            root := scene.nodes[model.instance.root_node]
            seat := FigureLerp(ModelPoint(model, scene, FigureSideRole(0, FIGURE_UPPER_LEG)),
                ModelPoint(model, scene, FigureSideRole(1, FIGURE_UPPER_LEG)), 0.5)
            chest := ModelPoint(model, scene, FIGURE_CHEST)
            torso := FigureClothTorsoFrame(seat, chest, side, root.scale.x)
            for binding: model.wrap_contact[:] {
                gap: float64
                if WrapSurfaceGap(scene, *binding, *gap) {
                    wrap_hits += 1
                    if gap < -0.002 { wrap_crossings += 1 }
                    worst_crossing = FigureMax(worst_crossing, -gap)
                }
            }
            for sash: model.wrap_sash[:] {
                offset := FigureSub(scene.positions[sash.vertex], scene.positions[sash.cloth])
                sash_margin = FigureMin(sash_margin, FigureDot(offset, scene.normals[sash.cloth]))
                sash_hits += 1
            }
            for vertex: 0..skirt.skin.positions.count - 1 {
                point := scene.positions[skirt_first + vertex]
                if !FigureFinite(point) { return false }
                match := model.skirt_seam[vertex]
                if match >= 0 {
                    worst_seam = FigureMax(worst_seam, FigureDistance(point, scene.positions[tunic_first + match]))
                    hits += 1
                    continue
                }
                if rest_hips.y - skirt.skin.positions[vertex].y >= 0.10 {
                    world := FigureAdd(root.position, FigureScale(FigureRotate(model.facing, point), root.scale.x))
                    outside := FigureClothTorsoOutside(world, *torso, side)
                    worst_inside = FigureMax(worst_inside, FigureDistance(world, outside))
                    checked += 1
                }
            }
        }
    }
    print("skirt fold: % attached skirt vertices, % free vertices, largest waist gap % m, torso penetration % m\n",
        hits, checked, worst_seam, worst_inside)
    print("wrap fold: % positioned skin rays, % deeper than 2 mm, largest crossing % m\n",
        wrap_hits, wrap_crossings, worst_crossing)
    print("wrap sash: % posed vertices, least clearance % m\n", sash_hits, sash_margin)
    return hits >= 28 * 82 && checked >= 100 * 82 && worst_seam < 0.000001 && worst_inside < 0.00015 &&
        wrap_hits >= 120000 && wrap_crossings == 0 && sash_hits >= 60 * 123 && sash_margin > 0.001
}

TrainingVisibility :: (model: *FigureModel, scene: *Scene, training: bool) -> bool {
    outfits: s64
    feet: s64
    for index: 0..model.instance.meshes.count - 1 {
        inst := *model.instance.meshes[index]
        source := *model.model.meshes[inst.mesh_index]
        name := TextView(source.name[:])
        visible := scene.nodes[inst.scene_node].visible
        if name == "PracticeTrainingSkirt" { return false }
        if name == "PracticeTrainingBody" {
            if visible != training || !inst.skin.dual_quaternion { return false }
            outfits += 1
        }
        if name == "PracticeTrainingTrousers" {
            if visible != training || inst.skin.dual_quaternion || inst.scene_node != model.training_trousers { return false }
        }
        if cast(s32)inst.mesh_index == model.articulated_sole_mesh {
            if !visible || !inst.skin.dual_quaternion { return false }
            feet += 1
        }
        if name == "PracticeClothing" || name == "PracticeSkirt" || name == "PracticeWrapFacings" {
            shared := inst.scene_node == model.training_trousers
            if visible != (!training || shared) || (shared && inst.skin.dual_quaternion) { return false }
        }
    }
    return outfits > 0 && feet > 0
}

// A fitted outfit must stay on the authored skinned surface even during
// the deep hinges that used to widen the loose tunic and skirt.
FittedOutfitSkinning :: (model: *FigureModel, scene: *Scene) -> bool {
    posed: Vec(Vector3)
    defer VecFree(posed)
    if !VecResize(posed, scene.positions.count) { return false }
    comparisons: s64
    worst: float64
    for sample: 0..12 {
        amount := cast(float64)sample / 12.0
        pose := ModelPose(0.7 * amount)
        pose.pelvis_turn = FigureAxisAngle(.{1.0, 0.0, 0.0}, 1.4 * amount)
        pose.chest_turn = FigureAxisAngle(.{1.0, 0.0, 0.0}, 2.0 * amount)
        if !FigureModelPose(model, scene, *pose) { return false }
        for vertex: 0..posed.count - 1 { posed[vertex] = scene.positions[vertex] }
        if !GltfUpdateScene(*model.model, *model.instance, scene) { return false }
        for index: 0..model.instance.meshes.count - 1 {
            inst := *model.instance.meshes[index]
            source := *model.model.meshes[inst.mesh_index]
            if TextView(source.name[:]) != "PracticeTrainingBody" { continue }
            if !scene.nodes[inst.scene_node].visible { return false }
            mesh := scene.meshes[scene.nodes[inst.scene_node].mesh]
            for vertex: mesh.first_vertex..mesh.first_vertex + mesh.vertex_count - 1 {
                if !FigureFinite(posed[vertex]) { return false }
                worst = FigureMax(worst, FigureDistance(posed[vertex], scene.positions[vertex]))
                comparisons += 1
            }
        }
    }
    print("Fitted outfit: % posed vertices match authored skinning within % m\n", comparisons, worst)
    return comparisons >= 13 * 5000 && worst < 0.000001
}

TrainingOutfitPose :: (model: *FigureModel, scene: *Scene, man: bool) -> bool {
    if man != (model.training_trousers >= 0) { return false }
    if !TrainingVisibility(model, scene, false) { return false }
    FigureModelTraining(model, scene, true, false)
    if !TrainingVisibility(model, scene, true) || (!man && !FittedOutfitSkinning(model, scene)) { return false }
    FigureModelTraining(model, scene, true, true)
    if !TrainingVisibility(model, scene, true) { return false }
    tested: s32
    for index: 0..model.instance.meshes.count - 1 {
        inst := *model.instance.meshes[index]
        source := *model.model.meshes[inst.mesh_index]
        name := TextView(source.name[:])
        if name != "PracticeTrainingBody" && name != "PracticeTrainingTrousers" { continue }
        primitive := *source.primitives[inst.primitive_index]
        material := *model.model.materials[primitive.material]
        garment := ifx man then "Practice_Training_Tshirt" else "Practice_Training_Leggings"
        trousers := man && TextView(material.name[:]) == "Practice_Workout_Trousers"
        if TextView(material.name[:]) != garment && !trousers { continue }
        mesh := scene.meshes[scene.nodes[inst.scene_node].mesh]
        moving_vertex: s64 = -1
        for vertex: 0..inst.skin.positions.count - 1 {
            rest := inst.skin.positions[vertex]
            if (man && !trousers && rest.x > 0.20 && rest.y > 1.40) ||
            ((!man || trousers) && rest.x > 0.06 && rest.y > 0.48 && rest.y < 0.55) {
                moving_vertex = vertex
                break
            }
        }
        if moving_vertex < 0 { continue }
        starting: Vector3
        for sample: 0..2 {
            phase := ifx sample == 1 then FIGURE_PI else 0.0
            pose := ModelPose(phase)
            if man && sample == 1 {
                for side: cast(s32)0..1 {
                    sign := ifx side == 0 then 1.0 else -1.0
                    pose.elbows[side] = FigureAdd(pose.shoulders[side], .{sign * 0.12, 0.20, 0.06})
                    pose.wrists[side] = FigureAdd(pose.shoulders[side], .{sign * 0.15, 0.42, 0.08})
                }
            }
            if !FigureModelPose(model, scene, *pose) { return false }
            root := scene.nodes[model.instance.root_node]
            for vertex: 0..inst.skin.positions.count - 1 {
                point := scene.positions[mesh.first_vertex + vertex]
                normal := scene.normals[mesh.first_vertex + vertex]
                if !FigureFinite(point) || !FigureFinite(normal) || FigureLength(normal) < 0.9 ||
                root.position.y + point.y * root.scale.x < 0.005 {
                    print("Training outfit produced invalid skinned geometry\n")
                    return false
                }
            }
            point := scene.positions[mesh.first_vertex + moving_vertex]
            if sample == 0 { starting = point }
            if sample == 1 && FigureDistance(starting, point) < 0.01 { return false }
            if sample == 2 && FigureDistance(starting, point) > 0.000001 { return false }
        }
        tested += 1
    }
    FigureModelTraining(model, scene, false)
    print("Training outfit follows the rig and switches practices with the original feet visible\n")
    return tested == (ifx man then 2 else 1) && TrainingVisibility(model, scene, false)
}

// How far along DIRECTION a ray from ORIGIN meets triangle A B C, or -1.
RayTriangle :: (origin: Vector3, direction: Vector3, a: Vector3, b: Vector3, c: Vector3) -> float64 {
    edge_ab := FigureSub(b, a)
    edge_ac := FigureSub(c, a)
    across := FigureCross(direction, edge_ac)
    determinant := FigureDot(edge_ab, across)
    if FigureAbs(determinant) < 0.000000000001 {
        return -1.0
    }
    inverse := 1.0 / determinant
    offset := FigureSub(origin, a)
    u := FigureDot(offset, across) * inverse
    if u < 0.0 || u > 1.0 {
        return -1.0
    }
    turned := FigureCross(offset, edge_ab)
    v := FigureDot(direction, turned) * inverse
    if v < 0.0 || u + v > 1.0 {
        return -1.0
    }
    return FigureDot(edge_ac, turned) * inverse
}

ModelSpace :: (matrix: GltfMatrix, point: Vector3, w: float64) -> Vector3 {
    return FigureV3(matrix.m[0] * point.x + matrix.m[1] * point.y + matrix.m[2] * point.z + matrix.m[3] * w,
        matrix.m[4] * point.x + matrix.m[5] * point.y + matrix.m[6] * point.z + matrix.m[7] * w,
        matrix.m[8] * point.x + matrix.m[9] * point.y + matrix.m[10] * point.z + matrix.m[11] * w)
}

// Workout poses that fold, twist and lift the waist: standing sway, deep
// hinges, a back bend, twists, side bends, a high knee and a squat.
ShirtPose :: (sample: s32) -> FigureJoints {
    pose := ModelPose(cast(float64)(sample % 4) * FIGURE_PI / 2.0)
    if sample >= 4 && sample < 9 {
        amount := cast(float64)(sample - 3) / 5.0
        pose.pelvis_turn = FigureAxisAngle(.{1.0, 0.0, 0.0}, 1.4 * amount)
        pose.chest_turn = FigureAxisAngle(.{1.0, 0.0, 0.0}, 2.0 * amount)
    } else if sample == 9 {
        pose.chest_turn = FigureAxisAngle(.{1.0, 0.0, 0.0}, -0.45)
    } else if sample == 10 || sample == 11 {
        pose.chest_turn = FigureAxisAngle(.{0.0, 1.0, 0.0}, ifx sample == 10 then 0.6 else -0.6)
    } else if sample == 12 || sample == 13 {
        pose.chest_turn = FigureAxisAngle(.{0.0, 0.0, 1.0}, ifx sample == 12 then 0.35 else -0.35)
    } else if sample == 14 || sample == 15 {
        side := sample - 14
        pose.knees[side] = FigureAdd(pose.hips[side], .{0.0, -0.03, 0.40})
        pose.ankles[side] = FigureAdd(pose.knees[side], .{0.0, -0.39, 0.06})
        pose.toes[side] = FigureAdd(pose.ankles[side], .{0.0, -0.055, 0.14})
    } else if sample == 16 {
        drop := FigureV3(0.0, -0.34, -0.10)
        pose.pelvis = FigureAdd(pose.pelvis, drop)
        pose.pelvis_turn = FigureAxisAngle(.{1.0, 0.0, 0.0}, 0.55)
        pose.chest_turn = FigureAxisAngle(.{1.0, 0.0, 0.0}, 0.75)
        for side: cast(s32)0..1 {
            pose.hips[side] = FigureAdd(pose.hips[side], drop)
            pose.knees[side] = FigureAdd(pose.ankles[side], .{0.0, 0.36, 0.20})
        }
    }
    return pose
}

// The man's T-shirt hangs over the Workout trousers. Its hem is below the
// waistband, it draws after the trousers, and in every pose each covered
// waistband point finds the shirt just outside it, looking in from the side
// of the pelvis as the camera does.
ShirtOverTrousers :: (model: *FigureModel, scene: *Scene) -> bool {
    FigureModelTraining(model, scene, true, false)
    trousers: s64 = -1
    shirts: [2]s64 = .[-1, -1]
    for index: 0..model.instance.meshes.count - 1 {
        inst := *model.instance.meshes[index]
        source := *model.model.meshes[inst.mesh_index]
        name := TextView(source.name[:])
        if name == "PracticeTrainingTrousers" {
            trousers = index
        }
        if name != "PracticeTrainingBody" {
            continue
        }
        material := *model.model.materials[source.primitives[inst.primitive_index].material]
        label := TextView(material.name[:])
        if label == "Practice_Training_Tshirt" {
            shirts[0] = index
        } else if label == "Practice_Training_Tshirt_Binding" {
            shirts[1] = index
        }
    }
    if trousers < 0 || shirts[0] < 0 || shirts[1] < 0 {
        print("Shirt over trousers: missing Workout garments\n")
        return false
    }
    pants := *model.instance.meshes[trousers]
    // Opaque meshes draw in node order with a less-or-equal depth test.
    hem: float64 = 1000.0
    for part: shirts {
        shirt := *model.instance.meshes[part]
        if shirt.scene_node <= pants.scene_node || !scene.nodes[shirt.scene_node].visible {
            print("Shirt over trousers: the shirt must draw after the trousers\n")
            return false
        }
        for point: shirt.skin.positions[:] {
            hem = FigureMin(hem, point.y)
        }
    }
    top: float64 = -1000.0
    for point: pants.skin.positions[:] {
        top = FigureMax(top, point.y)
    }
    covered: Vec(s32)
    defer VecFree(covered)
    for vertex: 0..pants.skin.positions.count - 1 {
        // The closed cap inside the waist opening is not on the outside.
        rest := pants.skin.positions[vertex]
        outside := Sqrt((rest.x - 0.00051) * (rest.x - 0.00051) + (rest.z + 0.016) * (rest.z + 0.016)) > 0.03
        if rest.y >= hem + 0.015 && outside && !VecPush(covered, cast(s32)vertex) {
            return false
        }
    }
    if top - hem < 0.08 || covered.count < 100 {
        print("Shirt over trousers: hem % m is not below the waistband top % m\n", hem, top)
        return false
    }
    pants_mesh := scene.meshes[scene.nodes[pants.scene_node].mesh]
    pants_matrix := model.instance.node_world[pants.gltf_node]
    uncovered: s64
    tests: s64
    nearest: float64 = 1000.0
    farthest: float64
    for sample: cast(s32)0..16 {
        pose := ShirtPose(sample)
        if !FigureModelPose(model, scene, *pose) {
            return false
        }
        hips := model.instance.node_world[model.bones[FIGURE_HIPS]]
        axis := FigureV3(hips.m[3], hips.m[7], hips.m[11])
        up := FigureRotate(FigureConjugate(model.facing), FigureRotate(FigureQuatNormalize(pose.pelvis_turn), .{0.0, 1.0, 0.0}))
        for vertex: covered[:] {
            at := pants_mesh.first_vertex + vertex
            origin := ModelSpace(pants_matrix, scene.positions[at], 1.0)
            radial := FigureSub(origin, axis)
            direction := FigureNormalize(FigureAddScaled(radial, up, -FigureDot(radial, up)))
            hit: float64 = 1000.0
            for part: shirts {
                shirt := *model.instance.meshes[part]
                mesh := scene.meshes[scene.nodes[shirt.scene_node].mesh]
                matrix := model.instance.node_world[shirt.gltf_node]
                for corner: 0..mesh.index_count / 3 - 1 {
                    first := mesh.first_index + corner * 3
                    a := ModelSpace(matrix, scene.positions[mesh.first_vertex + scene.indices[first]], 1.0)
                    b := ModelSpace(matrix, scene.positions[mesh.first_vertex + scene.indices[first + 1]], 1.0)
                    c := ModelSpace(matrix, scene.positions[mesh.first_vertex + scene.indices[first + 2]], 1.0)
                    distance := RayTriangle(origin, direction, a, b, c)
                    if distance > 0.0 && distance < hit {
                        hit = distance
                    }
                }
            }
            tests += 1
            if hit > 0.06 {
                uncovered += 1
                continue
            }
            nearest = FigureMin(nearest, hit)
            farthest = FigureMax(farthest, hit)
        }
    }
    print("Shirt over trousers: hem % m under waistband top % m; % of % waistband points covered over 17 poses, clearance % to % m\n",
        hem, top, tests - uncovered, tests, nearest, farthest)
    FigureModelTraining(model, scene, false)
    return uncovered == 0 && nearest > 0.0005
}

main :: () -> s32 {
    fail: s32
    paths: [2]string = .["shared/figure/woman.vrm", "shared/figure/man.vrm"]
    for path: paths {
        scene: Scene
        SceneInit(*scene)
        defer SceneFree(*scene)
        model: FigureModel
        defer FigureModelRelease(*model)
        if !FigureModelLoad(*model, *scene, path) {
            print("model pose: could not load %\n", path)
            return 1
        }
        worst_pelvis: float64
        worst_ankle: float64
        worst_drift: float64
        worst_hand: float64
        worst_wrist: float64
        planted: [2]Vector3
        for sample: 0..12 {
            pose := ModelPose(cast(float64)sample * FIGURE_PI / 6.0)
            if !FigureModelPose(*model, *scene, *pose) {
                return 1
            }
            pelvis := ModelPoint(*model, *scene, FIGURE_HIPS)
            worst_pelvis = FigureMax(worst_pelvis, FigureDistance(pelvis, pose.pelvis))
            for side: cast(s32)0..1 {
                ankle := ModelPoint(*model, *scene, FigureSideRole(side, FIGURE_FOOT))
                if sample == 0 {
                    planted[side] = ankle
                }
                worst_ankle = FigureMax(worst_ankle, FigureDistance(ankle, pose.ankles[side]))
                worst_drift = FigureMax(worst_drift, FigureDistance(ankle, planted[side]))
                wrist := ModelPoint(*model, *scene, FigureSideRole(side, FIGURE_HAND))
                worst_wrist = FigureMax(worst_wrist, FigureDistance(wrist, pose.wrists[side]))
                middle := ModelPoint(*model, *scene, FigureFingerRole(side, 2, 0))
                pointing := FigureNormalize(FigureSub(middle, wrist))
                wanted := FigureRotate(pose.hands[side], FigureV3(0.0, -1.0, 0.0))
                worst_hand = FigureMax(worst_hand, FigureDistance(pointing, wanted))
            }
        }
        print("model pose: % pelvis error % m, ankle error % m, planted drift % m, wrist error % m, hand direction error %\n",
            path, worst_pelvis, worst_ankle, worst_drift, worst_wrist, worst_hand)
        if worst_pelvis > 0.0001 || worst_ankle > 0.0001 || worst_drift > 0.0001 || worst_wrist > 0.0001 || worst_hand > 0.001 {
            fail += 1
        }
        if path == paths[0] && (!SleeveContact(*model, *scene) || !SkirtFoldContact(*model, *scene)) {
            fail += 1
        }
        if !ArmMotion(*model, *scene, path) {
            fail += 1
        }
        if !TrainingOutfitPose(*model, *scene, path == paths[1]) {
            fail += 1
        }
        if path == paths[1] && !ShirtOverTrousers(*model, *scene) {
            fail += 1
        }
    }
    return fail
}
