// Paints both shared figures from the real media. Run from the repository
// root with a private or no display; the GPU path falls back to the CPU.
#import "figure_math"
#import "figure_anatomy"
#import "figure_joints"
#import "figure_paint"
#import "figure_finish"
#import "kryon/scene"
#import "std/vec"
Raster :: #import "std/image";
#import "std/math"

Check :: (value: bool, label: string) -> s32 {
    if value {
        return 0
    }
    print("figure paint: %\n", label)
    return 1
}

Alpha :: (painter: *FigurePainter, x: s32, y: s32) -> s32 {
    return cast(s32)painter.pixels.pixels[(cast(s64)y * painter.pixels.width + x) * 4 + 3]
}

Opaque :: (painter: *FigurePainter) -> s64 {
    count: s64
    for index: 0..cast(s64)painter.pixels.width * painter.pixels.height - 1 {
        if painter.pixels.pixels[index * 4 + 3] > 200 {
            count += 1
        }
    }
    return count
}

Light :: (painter: *FigurePainter, x: s32, y: s32) -> float64 {
    at := (cast(s64)y * painter.pixels.width + x) * 4
    return (cast(float64)painter.pixels.pixels[at] * 0.30 + cast(float64)painter.pixels.pixels[at + 1] * 0.59 +
        cast(float64)painter.pixels.pixels[at + 2] * 0.11) / 255.0
}

// Pixels whose surroundings are all opaque figure.
Inside :: (painter: *FigurePainter, x: s32, y: s32) -> bool {
    return Alpha(painter, x, y) == 255 && Alpha(painter, x - 1, y) == 255 && Alpha(painter, x + 1, y) == 255 &&
        Alpha(painter, x, y - 1) == 255 && Alpha(painter, x, y + 1) == 255
}

// Faint pixels round her feet, where the floor shadow lies.
Shadowed :: (painter: *FigurePainter) -> s32 {
    count: s32
    for y: cast(s32)280..315 {
        for x: cast(s32)20..219 {
            alpha := Alpha(painter, x, y)
            if alpha > 0 && alpha < 160 {
                count += 1
            }
        }
    }
    return count
}

main :: () -> s32 {
    fail := CheckCharacter(FIGURE_FEMALE)
    fail += CheckCharacter(FIGURE_MALE)
    if fail == 0 {
        print("Figure painting local tests passed\n")
    }
    return fail
}

CheckCharacter :: (character: s32) -> s32 {
    media := FigureMediaLoad("shared/figure", character)
    defer FigureMediaRelease(*media)
    fail := Check(FigureMediaReady(*media), "the anatomy and texture maps load")
    if fail != 0 {
        return fail
    }
    painter: FigurePainter
    defer FigurePainterRelease(*painter)
    joints := FigureRestJoints(*media.anatomy, 1.65)
    view: FigureView = .{yaw = 0.3, pitch = 0.15, height = 2.0, center = .{0.0, 0.85, 0.0}}
    still: FigureEffect
    style := FigureStyleDefault()
    fail += Check(FigurePaint(*painter, *media, *joints, view, style, still, 240, 320), "the figure paints")
    painted := Opaque(*painter)
    print("figure paint: % % opaque pixels, gpu=%\n", FigureCharacterName(character), painted, painter.accelerated)
    fail += Check(painted > 3000 && painted < 40000, "the figure covers a plausible share of the picture")
    fail += Check(Alpha(*painter, 4, 4) == 0 && Alpha(*painter, 235, 4) == 0, "the background stays clear")
    // Each region shows its own colour: her jade top and indigo trousers, his
    // indigo jacket and black trousers, and warm skin on both.
    green: s64
    blue: s64
    dark: s64
    warm: s64
    // How far each pixel differs from its neighbours' mean: a clean,
    // smoothly lit surface has no grain or brush texture.
    grain: float64
    inside: float64
    lowest: float64 = 1.0
    highest: float64
    for y: cast(s32)1..318 {
        for x: cast(s32)1..238 {
            if !Inside(*painter, x, y) {
                continue
            }
            at := (cast(s64)y * 240 + x) * 4
            r := cast(s32)painter.pixels.pixels[at]
            g := cast(s32)painter.pixels.pixels[at + 1]
            b := cast(s32)painter.pixels.pixels[at + 2]
            if g > r + 8 && g > b + 4 {
                green += 1
            }
            if b > r + 10 && b > g + 10 {
                blue += 1
            }
            if r < 70 && g < 70 && b < 80 {
                dark += 1
            }
            if r > g + 15 && g > b + 8 {
                warm += 1
            }
            light := Light(*painter, x, y)
            around := (Light(*painter, x - 1, y) + Light(*painter, x + 1, y) + Light(*painter, x, y - 1) +
                Light(*painter, x, y + 1)) * 0.25
            grain += FigureAbs(light - around)
            inside += 1.0
            lowest = FigureMin(lowest, light)
            highest = FigureMax(highest, light)
        }
    }
    print("figure paint: % green, % blue, % dark, % warm pixels; grain %, light % to %\n", green, blue, dark, warm,
        grain / FigureMax(inside, 1.0), lowest, highest)
    if character == FIGURE_FEMALE {
        fail += Check(green > 800 && blue > 800 && warm > 200, "her top, trousers and skin take their colours")
    } else {
        fail += Check(blue > 800 && dark > 500 && warm > 200, "his jacket, trousers and skin take their colours")
    }
    fail += Check(inside > 0.0 && grain / inside < 0.02, "the surface is smooth and clean, without grain")
    fail += Check(highest - lowest > 0.25, "the light models her form")
    normals := true
    for index: 0..painter.weld.count - 1 {
        n := painter.scene.normals[index]
        length := FigureDot(n, n)
        normals = normals && length > 0.98 && length < 1.02
    }
    fail += Check(normals, "the posed surface's normals are recomputed whole")
    // Under her feet, the floor shadow is soft and faint.
    shadow := Shadowed(*painter)
    fail += Check(shadow > 10, "a soft shadow lies on the floor")
    style.shadow = false
    fail += Check(FigurePaint(*painter, *media, *joints, view, style, still, 240, 320),
        "the figure paints without shadows")
    without := Shadowed(*painter)
    print("figure paint: % faint floor pixels with the shadow, % without\n", shadow, without)
    fail += Check(without < shadow, "turning the shadow off removes it")
    // Tipped forward at the pelvis, his jacket's skirt hangs below the waist
    // instead of sticking out level with it; her fitted top has none.
    fail += Check(painter.hanging == (character == FIGURE_MALE), "only the jacket has a hanging skirt")
    if painter.hanging {
        folded := joints
        folded.pelvis_turn = FigureAxisAngle(FigureV3(1.0, 0.0, 0.0), FIGURE_PI * 0.5)
        fail += Check(FigurePaint(*painter, *media, *folded, view, FigureStyleDefault(), still, 240, 320),
            "a tipped pelvis paints")
        hem: float64
        hems: float64
        for index: 0..painter.hang.count - 1 {
            if painter.hang[index] > 0.9 {
                hem += painter.scene.positions[index].y
                hems += 1.0
            }
        }
        waist := FigureBonePoint(painter.poses[0], painter.waist)
        print("figure paint: tipped hem % below the waist (% hem vertices, waist at %)\n",
            waist.y - hem / FigureMax(hems, 1.0), hems, waist.y)
        fail += Check(hems > 0.0 && hem / hems < waist.y - 0.12, "the jacket's hem hangs towards the ground")
    }
    // A backdrop covers the whole picture.
    picture: Raster.Image
    defer VecFree(picture.pixels)
    fail += Check(FigureBackdropCover(*picture, *media.textures[FIGURE_FACE], 300, 120, 1.5, 0.8, 1.3) &&
        picture.width == 300 && picture.height == 120 && picture.pixels[(119 * 300 + 299) * 4 + 3] == 255,
        "a backdrop covers the picture")
    glow := FigureStyleDefault()
    glow.luminous = true
    glow.opacity = 0.5
    fail += Check(FigurePaint(*painter, *media, *joints, view, glow, still, 240, 320),
        "a translucent double paints")
    fail += Check(Opaque(*painter) < 500, "the double stays translucent")
    return fail
}
