// Gravity drape and body-contact constraints, independent of rendering.
#import "figure_math"
#import "figure_cloth"
#import "kryon/scene"
#import "std/math"

main :: () -> s32 {
    fail: s32
    hips := FigureV3(0.0, 0.90, 0.0)
    rest_hips := FigureV3(0.0, 0.94, 0.0)
    hem := FigureV3(0.2, 0.64, 0.05)
    // A forward fold must not rotate the hem over the pelvis/head, even
    // when the underlying rigid hip rotation crosses ninety degrees.
    previous: Vector3
    for sample: 0..180 {
        angle := cast(float64)sample * FIGURE_PI / 180.0
        rigid := FigureAdd(hips, FigureRotate(FigureAxisAngle(.{1.0, 0.0, 0.0}, angle), FigureSub(hem, rest_hips)))
        draped := FigureClothHang(rigid, hem, rest_hips, hips, FigureIdentity(), 0.0, 1.0)
        if FigureAbs(draped.y - 0.60) > 0.000001 || (sample > 0 && FigureDistance(draped, previous) > 0.001) {
            fail += 1
        }
        previous = draped
    }
    waist := FigureV3(0.1, 0.95, 0.0)
    rigid_waist := FigureV3(0.12, 0.91, 0.02)
    if FigureDistance(FigureClothHang(rigid_waist, waist, rest_hips, hips, FigureIdentity(), 0.0, 1.0), rigid_waist) > 0.000001 {
        fail += 1
    }
    // Cloth inside a thigh, its endpoint, or exactly on the centerline is
    // projected outside the capsule without NaNs or moving the skeleton.
    from := FigureV3(0.0, 0.8, 0.0)
    to := FigureV3(0.0, 0.4, 0.0)
    for sample: 0..20 {
        point := FigureV3(0.01, 0.35 + cast(float64)sample * 0.025, 0.0)
        out := FigureClothOutside(point, from, to, 0.078, .{1.0, 0.0, 0.0})
        nearest := FigureV3(0.0, FigureClamp(out.y, 0.4, 0.8), 0.0)
        if !FigureFinite(out) || FigureDistance(out, nearest) < 0.077999 {
            fail += 1
        }
    }
    center := FigureClothOutside(.{0.0, 0.6, 0.0}, from, to, 0.078, .{1.0, 0.0, 0.0})
    if !FigureFinite(center) || FigureAbs(center.x - 0.078) > 0.000001 {
        fail += 1
    }
    // A high knee lifts the panel out in front and up over the thigh. The
    // waist and the panel on the far side stay attached to their own drape.
    thigh: [1]Vector3
    front := FigureV3(0.0, 0.0, 1.0)
    previous = hem
    for sample: 0..110 {
        angle := cast(float64)sample * FIGURE_PI / 180.0
        thigh[0] = .{0.0, -Cos(angle), Sin(angle)}
        lifted := FigureClothLift(hem, front, 0.30, 1.0, thigh[:])
        behind := FigureClothLift(hem, .{0.0, 0.0, -1.0}, 0.30, 1.0, thigh[:])
        fixed := FigureClothLift(waist, front, 0.0, 1.0, thigh[:])
        if !FigureFinite(lifted) || FigureDistance(lifted, previous) > 0.015 ||
            FigureDistance(behind, hem) > 0.000001 || FigureDistance(fixed, waist) > 0.000001 {
            fail += 1
        }
        if sample == 90 && (lifted.y - hem.y < 0.28 || lifted.z - hem.z < 0.28) {
            fail += 1
        }
        previous = lifted
    }
    // Gravitational drape uses the remaining cloth length on the legs' side
    // when the body is almost level. The waistband still follows its skin.
    prone := FigureV3(0.0, 0.15, 0.0)
    legs := FigureV3(0.0, 0.0, -1.0)
    hanging := FigureClothHang(hem, hem, rest_hips, prone, FigureIdentity(), 0.0, 1.0)
    grounded := FigureClothHang(hem, hem, rest_hips, prone, FigureIdentity(), 0.0, 1.0, legs)
    open := FigureClothHang(hem, hem, rest_hips, hips, FigureIdentity(), 0.0, 1.0, .{}, 1.0)
    if grounded.z > hanging.z - 0.10 || open.x < hem.x + 0.025 || open.y < 0.625 ||
        FigureDistance(FigureClothHang(rigid_waist, waist, rest_hips, prone, FigureIdentity(),
            0.0, 1.0, legs, 1.0), rigid_waist) > 0.000001 {
        fail += 1
    }
    print("cloth constraints: % findings in fold, waist, capsule, prone drape and airborne regressions\n", fail)
    return fail
}
