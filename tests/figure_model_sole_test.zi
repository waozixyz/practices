// Measure the rendered, skinned plantar vertices, not ankle-bone guesses.
#import "figure_math"
#import "figure_joints"
#import "figure_model"
#import "figure_model_pose_test"
#import "kryon/scene"
#import "kryon/scene_gltf"
#import "std/math"

SoleWorld :: (figure: *FigureModel, matrix: GltfMatrix, point: Vector3, scene: *Scene) -> Vector3 {
    in_model := FigureV3(matrix.m[0] * point.x + matrix.m[1] * point.y + matrix.m[2] * point.z + matrix.m[3],
        matrix.m[4] * point.x + matrix.m[5] * point.y + matrix.m[6] * point.z + matrix.m[7],
        matrix.m[8] * point.x + matrix.m[9] * point.y + matrix.m[10] * point.z + matrix.m[11])
    root := scene.nodes[figure.instance.root_node]
    return FigureAdd(root.position, FigureScale(FigureRotate(figure.facing, in_model), root.scale.x))
}

// The lowest point of everything drawn, not only the soles. A garment
// below the soles would lift the visible figure off the floor line.
LowestVisible :: (figure: *FigureModel, scene: *Scene, lowest_mesh: *s64) -> float64 {
    low: float64 = 1000.0
    for index: 0..figure.instance.meshes.count - 1 {
        inst := *figure.instance.meshes[index]
        if !scene.nodes[inst.scene_node].visible { continue }
        mesh := scene.meshes[scene.nodes[inst.scene_node].mesh]
        for vertex: 0..mesh.vertex_count - 1 {
            actual := SoleWorld(figure, figure.instance.node_world[inst.gltf_node],
                scene.positions[mesh.first_vertex + vertex], scene)
            if actual.y < low {
                low = actual.y
                <<lowest_mesh = cast(s64)inst.mesh_index
            }
        }
    }
    return low
}

SoleCheck :: (figure: *FigureModel, scene: *Scene, path: string, outfit: string) -> s32 {
    worst_lowest: float64
    lowest_mesh: s64 = -1
    worst_gap: float64
    worst_penetration: float64
    worst_flat: float64
    worst_pivot: float64
    worst_span: float64
    toe_flex: float64
    penetration_mode: s32
    penetration_point: Vector3
    measured: s64
    for mode: 0..3 {
        for sample: 0..32 {
            phase := cast(float64)sample * FIGURE_PI / 16.0
            pose := ModelPose(phase)
            // Nearly straight, shifted stances exposed retargeting reach
            // errors even when the solver's planted target was exact.
            if mode == 3 {
                shift := FigureV3(0.08 * Sin(phase), 0.06, 0.03 * Cos(phase))
                pose.pelvis = FigureAdd(pose.pelvis, shift)
                for side: cast(s32)0..1 {
                    pose.hips[side] = FigureAdd(pose.hips[side], shift)
                }
            }
            angle: float64
            if mode == 1 || mode == 2 {
                angle = (ifx mode == 1 then -0.7 else 0.7) * cast(float64)sample / 32.0
            }
            foot := FigureAxisAngle(FigureV3(1.0, 0.0, 0.0), angle)
            for side: cast(s32)0..1 {
                x := ifx side == 0 then 0.12 else -0.12
                contact := FigureV3(x, 0.0, ifx mode == 2 then 0.138 else -0.055)
                relative := FigureV3(0.0, -0.08, ifx mode == 2 then 0.138 else -0.055)
                pose.ankles[side] = FigureSub(contact, FigureRotate(foot, relative))
                pose.feet[side] = foot
                pose.heels[side] = FigureAdd(pose.ankles[side], FigureRotate(foot, FigureV3(0.0, -0.08, -0.055)))
                pose.balls[side] = FigureAdd(pose.ankles[side], FigureRotate(foot, FigureV3(0.0, -0.08, 0.138)))
                pose.toes[side] = pose.balls[side]
                direction := FigureNormalize(FigureSub(pose.ankles[side], pose.hips[side]))
                pole := FigureNormalize(FigureAddScaled(FigureV3(0.0, 0.0, 1.0), direction, -direction.z))
                half := FigureDistance(pose.hips[side], pose.ankles[side]) * 0.5
                pose.knees[side] = FigureAddScaled(FigureLerp(pose.hips[side], pose.ankles[side], 0.5),
                    pole, Sqrt(FigureMax(0.16 - half * half, 0.0)))
            }
            if !FigureModelPose(figure, scene, *pose) {
                return 1
            }
            lowest_index: s64 = -1
            lowest := LowestVisible(figure, scene, *lowest_index)
            if lowest_mesh < 0 || FigureAbs(lowest) > worst_lowest {
                worst_lowest = FigureAbs(lowest)
                lowest_mesh = lowest_index
            }
            if mode == 2 {
                for side: cast(s32)0..1 {
                    toe_flex = FigureMax(toe_flex, RotationDistance(
                        ModelTurn(figure, FigureSideRole(side, FIGURE_FOOT)),
                        ModelTurn(figure, FigureSideRole(side, FIGURE_TOES))))
                }
            }
            for mesh_index: 0..figure.instance.meshes.count - 1 {
                inst := *figure.instance.meshes[mesh_index]
                source_mesh := *figure.model.meshes[inst.mesh_index]
                name := TextView(source_mesh.name[:])
                articulated := cast(s32)inst.mesh_index == figure.articulated_sole_mesh
                if name != "PracticeBareFeet" && !articulated {
                    continue
                }
                side := inst.primitive_index
                heel_down := pose.heels[side].y <= pose.balls[side].y
                target := ifx heel_down then pose.heels[side] else pose.balls[side]
                mesh := scene.meshes[scene.nodes[inst.scene_node].mesh]
                low: float64 = 1000.0
                high: float64 = -1000.0
                back: float64 = 1000.0
                front: float64 = -1000.0
                heel: Vector3
                ball: Vector3
                surface: float64 = 1000.0
                pivot: float64 = 1000.0
                for vertex: 0..inst.skin.positions.count - 1 {
                    rest := inst.skin.positions[vertex]
                    actual := SoleWorld(figure, figure.instance.node_world[inst.gltf_node],
                        scene.positions[mesh.first_vertex + vertex], scene)
                    if -actual.y > worst_penetration {
                        worst_penetration = -actual.y
                        penetration_mode = cast(s32)mode
                        penetration_point = rest
                    }
                    surface = FigureMin(surface, actual.y)
                    pivot = FigureMin(pivot, FigureDistance(actual, target))
                    band := ifx articulated then 0.0005 else 0.000001
                    if FigureAbs(rest.y - figure.sole_rest_height[side]) > band {
                        continue
                    }
                    low = FigureMin(low, actual.y)
                    high = FigureMax(high, actual.y)
                    facing := FigureRotate(figure.facing, rest)
                    if facing.z < back {
                        back = facing.z
                        heel = actual
                    }
                    if facing.z > front {
                        front = facing.z
                        ball = actual
                    }
                    measured += 1
                }
                worst_gap = FigureMax(worst_gap, FigureAbs(ifx articulated then surface else low))
                if mode == 0 || mode == 3 {
                    worst_flat = FigureMax(worst_flat, high - low)
                    root := scene.nodes[figure.instance.root_node]
                    original := FigureDistance(figure.sole_heel[side], figure.sole_ball[side]) * root.scale.x
                    worst_span = FigureMax(worst_span, FigureAbs(FigureDistance(heel, ball) - original))
                }
                if !articulated {
                    pivot = FigureDistance(ifx heel_down then heel else ball, target)
                }
                worst_pivot = FigureMax(worst_pivot, pivot)
            }
        }
    }
    print("sole test: % % vertices %, floor error % m, skin penetration % m, flatness % m, heel/ball pivot error % m, anatomical span error % m\n",
        path, outfit, measured, worst_gap, worst_penetration, worst_flat, worst_pivot, worst_span)
    if lowest_mesh >= 0 {
        lowest_source := *figure.model.meshes[lowest_mesh]
        print("sole test: % % lowest visible point % m from the floor (%)\n",
            path, outfit, worst_lowest, TextView(lowest_source.name[:]))
    }
    print("sole test: % maximum procedural toe flex % rad\n", path, toe_flex)
    if (figure.keep_toe_profile && toe_flex > 0.000001) || (!figure.keep_toe_profile && toe_flex < 0.1) {
        return 1
    }
    if worst_penetration >= 0.001 {
        print("sole test: penetration in pose mode % at bind (%, %, %)\n",
            penetration_mode, penetration_point.x, penetration_point.y, penetration_point.z)
    }
    expected_samples := 4 * 33 * (figure.sole_count[0] + figure.sole_count[1])
    return ifx measured != expected_samples || worst_gap >= 0.001 || worst_penetration >= 0.001 || worst_flat >= 0.001 ||
        worst_pivot >= 0.001 || worst_span >= 0.001 || worst_lowest >= 0.001 then 1 else 0
}

main :: () -> s32 {
    fail: s32
    paths: [2]string = .["shared/figure/woman.vrm", "shared/figure/man.vrm"]
    model: FigureModel
    defer FigureModelRelease(*model)
    expected: [2]s32 = .[5, 3]
    for index: 0..paths.count - 1 {
        path := paths[index]
        scene: Scene
        SceneInit(*scene)
        defer SceneFree(*scene)
        if !FigureModelLoad(*model, *scene, path) {
            return 1
        }
        if model.sole_count[0] != expected[index] || model.sole_count[1] != expected[index] ||
        model.keep_toe_profile != (index == 0) {
            print("sole test: stale measurements after loading %\n", path)
            return 1
        }
        fail += SoleCheck(*model, *scene, path, "practice outfit")
        // The Workout outfit, as the Customize card and Workout scene draw it:
        // both figures stand on the same floor within the same tolerance.
        FigureModelTraining(*model, *scene, true, false)
        fail += SoleCheck(*model, *scene, path, "Workout outfit")
    }
    return fail
}
